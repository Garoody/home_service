<%
  const isAdmin = currentUser?.role === "admin";
  const accountHome = isAdmin ? "/admin" : "/users/profile";
%>

<div class="service-footer__inner">
  <div class="service-footer__grid">
    <div class="service-footer__brand">
      <a href="/services" class="service-footer__logo">
        <img
          src="/images/logo.svg"
          alt="HomeService"
        >

        <span>
          <span class="service-footer__eyebrow">Plateforme de services</span>
          <span class="service-brand__title">HomeService</span>
        </span>
      </a>

      <p class="service-footer__copy">
        Plateforme de réservation de services à domicile.
        Trouvez rapidement un professionnel qualifié pres de chez vous,
        puis suivez vos demandes, vos paiements et vos réservations.
      </p>
    </div>

    <div>
      <h3 class="service-footer__title">Liens rapides</h3>
      <ul class="service-footer__list">
        <li><a href="/categories">Catégories</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/qui-sommes-nous">Qui sommes-nous</a></li>
        <li><a href="/mentions-legales">Mentions legales</a></li>
        <% if (currentUser) { %>
          <li>
            <a href="<%= accountHome %>">
              <%= isAdmin ? "Administration" : "Mon espace" %>
            </a>
          </li>
          <% if (!isAdmin) { %>
            <li><a href="/bookings">Mes réservations</a></li>
            <li><a href="/services/new">Proposer un service</a></li>
          <% } %>
          <li>
            <form
              action="/auth/logout"
              method="POST"
              data-confirm="Voulez-vous vraiment vous déconnecter ?"
            >
              <% if (csrfToken) { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% } %>
              <button
                type="submit"
                class="service-nav__logout bg-transparent"
              >
                Déconnexion
              </button>
            </form>
          </li>
        <% } else { %>
          <li><a href="/auth/login">Connexion</a></li>
        <% } %>
      </ul>
    </div>

    <div>
      <h3 class="service-footer__title">Contact</h3>
      <ul class="service-footer__list">
        <li>France</li>
        <li>cherygaroody@gmail.com</li>
      </ul>
    </div>
  </div>

  <div class="service-footer__bottom">
    &copy; <%= new Date().getFullYear() %> HomeService - Tous droits reserves
  </div>
</div>
