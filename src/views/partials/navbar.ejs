<nav class="bg-slate-950/90 backdrop-blur border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex items-center">
        <a href="<%= currentUser && currentUser.role === 'admin' ? '/admin' : '/' %>" class="inline-flex items-center gap-3 text-xl font-bold text-white hover:text-blue-400 transition">
          <img
            src="/images/logo.svg"
            alt="HomeService"
            class="h-10 w-10 rounded-xl border border-white/10 bg-white/5 p-1.5 shadow-lg shadow-blue-950/20"
          >
          <span><%= currentUser && currentUser.role === "admin" ? "Administration" : "HomeService" %></span>
        </a>
      </div>

      <div class="hidden md:flex items-center gap-6 text-sm font-medium">
        <% if (currentUser) { %>
          <% if (currentUser.role === "admin") { %>
            <a href="/admin" class="hover:text-blue-400 transition">Administration</a>
          <% } else { %>
            <a href="/" class="hover:text-blue-400 transition">Accueil</a>
            <a href="/services" class="hover:text-blue-400 transition">Services</a>
            <a href="/users/profile" class="hover:text-blue-400 transition">Mon espace</a>
            <a href="/bookings" class="hover:text-blue-400 transition">Mes reservations</a>
          <% } %>
          <span class="text-slate-300">
            Connecte en tant que
            <span class="text-white"><%= currentUser.name || "Utilisateur" %></span>
            (<%= currentUser.role || "client" %>)
          </span>
          <form
            action="/auth/logout"
            method="POST"
            class="inline"
            data-confirm="Voulez-vous vraiment vous deconnecter ?"
          >
            <button
              type="submit"
              class="bg-transparent p-0 text-sm font-medium text-slate-100 hover:text-red-300 transition"
            >
              Deconnexion
            </button>
          </form>
        <% } else { %>
          <a href="/auth/login" class="hover:text-blue-400 transition">Connexion</a>
        <% } %>
      </div>

      <div class="md:hidden">
        <button id="menu-btn" class="text-white focus:outline-none" type="button">
          Menu
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden px-4 pb-4 space-y-2 text-sm">
    <% if (currentUser) { %>
      <% if (currentUser.role === "admin") { %>
        <a href="/admin" class="block hover:text-blue-400">Administration</a>
      <% } else { %>
        <a href="/" class="block hover:text-blue-400">Accueil</a>
        <a href="/services" class="block hover:text-blue-400">Services</a>
        <a href="/users/profile" class="block hover:text-blue-400">Mon espace</a>
        <a href="/bookings" class="block hover:text-blue-400">Mes reservations</a>
      <% } %>
      <div class="pt-2 text-slate-300">
        Connecte en tant que <span class="text-white"><%= currentUser.name || "Utilisateur" %></span> (<%= currentUser.role || "client" %>)
      </div>
      <form
        action="/auth/logout"
        method="POST"
        data-confirm="Voulez-vous vraiment vous deconnecter ?"
      >
        <button
          type="submit"
          class="block bg-transparent p-0 text-sm text-slate-100 hover:text-red-300 transition"
        >
          Deconnexion
        </button>
      </form>
    <% } else { %>
      <a href="/auth/login" class="block hover:text-blue-400">Connexion</a>
    <% } %>
  </div>
</nav>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  if (btn && menu) {
    btn.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }
</script>
