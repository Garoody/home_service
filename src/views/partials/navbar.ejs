<%
  const isAdmin = currentUser?.role === "admin";
  const accountHome = isAdmin ? "/admin" : "/users/profile";
  const requestPath = typeof currentPath === "string" ? currentPath : "/";
  const matchesPrefix = (prefix) =>
    requestPath === prefix || requestPath.startsWith(`${prefix}/`);
  const isHomeActive = requestPath === "/";
  const isCreateServiceActive = requestPath === "/services/new";
  const isServicesActive =
    matchesPrefix("/services") && !isCreateServiceActive;
  const isMessagesActive = !isAdmin && matchesPrefix("/conversations");
  const isAccountActive = isAdmin
    ? matchesPrefix("/admin")
    : matchesPrefix("/users/profile") ||
      matchesPrefix("/bookings") ||
      matchesPrefix("/payments");
  const isLoginActive = matchesPrefix("/auth/login");
  const unreadMessages = Number(unreadConversationCount || 0);
  const unreadMessagesLabel = unreadMessages > 99 ? "99+" : String(unreadMessages);
  const navLinkClass = (isActive, hasBadge = false) =>
    `service-nav__link${isActive ? " service-nav__link--active" : ""}${hasBadge ? " service-nav__link--with-badge" : ""}`;
%>

<nav class="service-nav" aria-label="Navigation principale">
  <div class="service-nav__inner">
    <div class="service-nav__bar">
      <a href="/services" class="service-brand">
        <img
          src="/images/logo.svg"
          alt="HomeService"
          class="service-brand__logo"
        >

        <span class="service-brand__content">
          <span class="service-brand__eyebrow">Plateforme de services</span>
          <span class="service-brand__title">HomeService</span>
          <span class="service-brand__baseline">Réservation, paiement et suivi des prestations à domicile</span>
        </span>
      </a>

      <div class="service-nav__links">
        <a
          href="/services"
          class="<%= navLinkClass(isServicesActive) %>"
          <%- isServicesActive ? 'aria-current="page"' : "" %>
        >Services</a>

        <% if (currentUser) { %>
          <a
            href="<%= accountHome %>"
            class="<%= navLinkClass(isAccountActive) %>"
            <%- isAccountActive ? 'aria-current="page"' : "" %>
          >
            <%= isAdmin ? "Administration" : "Mon espace" %>
          </a>
          <% if (!isAdmin) { %>
            <a
              href="/conversations"
              class="<%= navLinkClass(isMessagesActive, unreadMessages > 0) %>"
              <%- isMessagesActive ? 'aria-current="page"' : "" %>
            >
              <span>Messageries</span>
              <% if (unreadMessages > 0) { %>
                <span
                  class="service-nav__badge"
                  aria-label="<%= unreadMessages %> message<%= unreadMessages > 1 ? 's' : '' %> non lu<%= unreadMessages > 1 ? 's' : '' %>"
                ><%= unreadMessagesLabel %></span>
              <% } %>
            </a>
            <a
              href="/services/new"
              class="<%= navLinkClass(isCreateServiceActive) %>"
              <%- isCreateServiceActive ? 'aria-current="page"' : "" %>
            >Proposer un service</a>

            <button
              type="button"
              class="service-nav__theme"
              data-theme-toggle
              aria-pressed="false"
            >
              <span class="service-nav__theme-indicator" aria-hidden="true"></span>
              <span data-theme-toggle-label>Mode sombre</span>
            </button>
          <% } %>

          <form
            action="/auth/logout"
            method="POST"
            class="inline"
            data-confirm="Voulez-vous vraiment vous déconnecter ?"
          >
            <% if (csrfToken) { %>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            <button
              type="submit"
              class="service-nav__logout bg-transparent"
            >
              Déconnexion
            </button>
          </form>
        <% } else { %>
          <button
            type="button"
            class="service-nav__theme"
            data-theme-toggle
            aria-pressed="false"
          >
            <span class="service-nav__theme-indicator" aria-hidden="true"></span>
            <span data-theme-toggle-label>Mode sombre</span>
          </button>
          <a
            href="/auth/login"
            class="<%= navLinkClass(isLoginActive) %>"
            <%- isLoginActive ? 'aria-current="page"' : "" %>
          >Connexion</a>
        <% } %>
      </div>

      <button id="menu-btn" class="service-nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
        Menu
      </button>
    </div>

    <div id="mobile-menu" class="service-nav__mobile hidden">
      <a
        href="/services"
        class="<%= navLinkClass(isServicesActive) %>"
        <%- isServicesActive ? 'aria-current="page"' : "" %>
      >Services</a>

      <% if (currentUser) { %>
        <a
          href="<%= accountHome %>"
          class="<%= navLinkClass(isAccountActive) %>"
          <%- isAccountActive ? 'aria-current="page"' : "" %>
        >
          <%= isAdmin ? "Administration" : "Mon espace" %>
        </a>
        <% if (!isAdmin) { %>
          <a
            href="/conversations"
            class="<%= navLinkClass(isMessagesActive, unreadMessages > 0) %>"
            <%- isMessagesActive ? 'aria-current="page"' : "" %>
          >
            <span>Messageries</span>
            <% if (unreadMessages > 0) { %>
              <span
                class="service-nav__badge"
                aria-label="<%= unreadMessages %> message<%= unreadMessages > 1 ? 's' : '' %> non lu<%= unreadMessages > 1 ? 's' : '' %>"
              ><%= unreadMessagesLabel %></span>
            <% } %>
          </a>
          <a
            href="/services/new"
            class="<%= navLinkClass(isCreateServiceActive) %>"
            <%- isCreateServiceActive ? 'aria-current="page"' : "" %>
          >Proposer un service</a>

          <button
            type="button"
            class="service-nav__theme service-nav__theme--mobile"
            data-theme-toggle
            aria-pressed="false"
          >
            <span class="service-nav__theme-indicator" aria-hidden="true"></span>
            <span data-theme-toggle-label>Mode sombre</span>
          </button>
        <% } %>

        <form
          action="/auth/logout"
          method="POST"
          data-confirm="Voulez-vous vraiment vous déconnecter ?"
        >
          <% if (csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <button
            type="submit"
            class="service-nav__logout bg-transparent"
          >
            Déconnexion
          </button>
        </form>
      <% } else { %>
        <button
          type="button"
          class="service-nav__theme service-nav__theme--mobile"
          data-theme-toggle
          aria-pressed="false"
        >
          <span class="service-nav__theme-indicator" aria-hidden="true"></span>
          <span data-theme-toggle-label>Mode sombre</span>
        </button>
        <a
          href="/auth/login"
          class="<%= navLinkClass(isLoginActive) %>"
          <%- isLoginActive ? 'aria-current="page"' : "" %>
        >Connexion</a>
      <% } %>
    </div>
  </div>
</nav>
