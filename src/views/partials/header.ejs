<!-- src/views/layouts/main.ejs -->
<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= typeof title !== 'undefined' ? title : 'HomeService' %></title>

  <!-- Favicon -->
  <link rel="icon" href="/images/logo.svg" type="image/svg+xml" />
  <link rel="shortcut icon" href="/images/logo.svg" type="image/svg+xml" />

  <!-- Tailwind CSS v4 (CDN) -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <!-- CSS global (optionnel) -->
  <link rel="stylesheet" href="/css/main.css" />
</head>

<body class="min-h-screen flex flex-col bg-slate-950 text-slate-100">

  <!-- Navbar -->
  <header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur">
    <%- include('../partials/navbar') %>
  </header>

  <!-- Contenu principal -->
  <main class="
      flex-1
      w-full
      max-w-7xl
      mx-auto
      px-4
      sm:px-6
      lg:px-8
      py-6
    ">
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="mt-auto border-t border-white/10">
    <%- include('../partials/footer') %>
  </footer>

  <!-- JS global -->
  <script src="/js/app.js"></script>
</body>

</html>
