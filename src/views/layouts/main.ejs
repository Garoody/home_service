<!-- src/views/layouts/main.ejs -->
<!DOCTYPE html>
<html lang="fr">
<%
  const scriptNonce = typeof cspNonce === "string" ? cspNonce : "";
  const addNonceToExtractedHtml = (html, tagName) => {
    if (!scriptNonce || typeof html !== "string" || html.length === 0) {
      return html;
    }

    const pattern = new RegExp(`<${tagName}\\b(?![^>]*\\bnonce=)`, "g");
    return html.replace(pattern, `<${tagName} nonce="${scriptNonce}"`);
  };

  const extractedStyles =
    typeof style !== "undefined" ? addNonceToExtractedHtml(style, "style") : "";
  const extractedScripts =
    typeof script !== "undefined" ? addNonceToExtractedHtml(script, "script") : "";
%>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= typeof title !== 'undefined' ? title : 'HomeService' %></title>

  <script nonce="<%= scriptNonce %>">
    try {
      const storedTheme = localStorage.getItem("homeservice-theme");
      if (storedTheme === "dark" || storedTheme === "light") {
        document.documentElement.dataset.theme = storedTheme;
        document.documentElement.style.colorScheme = storedTheme;
      }
    } catch {}
  </script>

  <!-- Favicon -->
  <link rel="icon" href="/images/logo.svg" type="image/svg+xml" />
  <link rel="shortcut icon" href="/images/logo.svg" type="image/svg+xml" />

  <!-- Tailwind CSS v4 (CDN) -->
  <script nonce="<%= scriptNonce %>" src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <!-- CSS global -->
  <link rel="stylesheet" href="/css/main.css" />
  <%- extractedStyles %>
</head>

<body class="app-shell">
  <%
    const isAdmin = currentUser?.role === "admin";
    const accountHome = isAdmin ? "/admin" : "/users/profile";
    const displayName = currentUser?.name || "Utilisateur";
    const initials = displayName
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((part) => part[0]?.toUpperCase())
      .join("") || "UT";
  %>
  <!-- Navbar -->
  <header class="service-shell-header">
    <%- include('../partials/navbar') %>
  </header>

  <!-- Contenu principal -->
  <main class="app-main">
    <%
      const loginPromptHidden = currentPath === "/auth/login";
      const flashSuccessMessages = flash?.success || [];
      const flashErrorMessages = (flash?.error || []).filter((msg) => {
        return !(loginPromptHidden && msg === "Veuillez vous connecter.");
      });
      const flashInfoMessages = flash?.info || [];
    %>
    <% if (flashSuccessMessages.length || flashErrorMessages.length || flashInfoMessages.length) { %>
      <div class="flash-stack">
        <% flashSuccessMessages.forEach((msg) => { %>
          <div class="flash flash--success"><%= msg %></div>
        <% }) %>
        <% flashErrorMessages.forEach((msg) => { %>
          <div class="flash flash--error"><%= msg %></div>
        <% }) %>
        <% flashInfoMessages.forEach((msg) => { %>
          <div class="flash flash--info"><%= msg %></div>
        <% }) %>
      </div>
    <% } %>

    <% if (currentUser) { %>
      <div class="account-banner">
        <div class="account-banner__card">
          <% if (currentUser.profilePhotoPath) { %>
            <button
              type="button"
              class="account-banner__avatar-button image-preview-trigger image-preview-trigger--round"
              data-image-preview
              data-image-src="<%= currentUser.profilePhotoPath %>"
              data-image-alt="Photo de profil de <%= displayName %>"
              aria-label="Voir la photo de profil"
            >
              <img
                src="<%= currentUser.profilePhotoPath %>"
                alt="Photo de profil de <%= displayName %>"
                class="account-banner__avatar"
              >
            </button>
          <% } else { %>
            <span class="account-banner__avatar account-banner__avatar--fallback">
              <%= initials %>
            </span>
          <% } %>

          <a href="<%= accountHome %>" class="account-banner__content">
            <span class="account-banner__name"><%= displayName %></span>
          </a>
        </div>
      </div>
    <% } %>

    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="service-shell-footer">
    <%- include('../partials/footer') %>
  </footer>

  <div class="image-preview-modal hidden" data-image-preview-modal>
    <button
      type="button"
      class="image-preview-modal__backdrop"
      data-image-preview-close
      aria-label="Fermer l'aperçu de l'image"
    ></button>
    <div class="image-preview-modal__dialog" role="dialog" aria-modal="true" aria-label="Aperçu de l'image">
      <button
        type="button"
        class="image-preview-modal__close"
        data-image-preview-close
        aria-label="Fermer"
      >
        Fermer
      </button>
      <img
        src=""
        alt=""
        class="image-preview-modal__image"
        data-image-preview-target
      >
    </div>
  </div>

  <script nonce="<%= scriptNonce %>" id="old-input-data" type="application/json"><%- JSON.stringify(oldInput || {}).replace(/</g, "\\u003c") %></script>

  <!-- JS global -->
  <script nonce="<%= scriptNonce %>" src="/js/app.js"></script>
  <%- extractedScripts %>
</body>

</html>
