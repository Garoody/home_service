<%
  const isClientView = viewerMode === "client";
  const paymentMethodLabels = {
    cb: "Carte bancaire",
    visa: "Visa",
    mastercard: "Mastercard",
    card: "Carte bancaire",
    paypal: "PayPal",
    bank_transfer: "Virement bancaire",
    cash: "Especes",
    other: "Carte bancaire",
  };
  const paymentStatusLabels = { paid: "Paye", pending: "En attente", unpaid: "Non paye" };
  const formatDate = (value) => {
    if (!value) return "N/A";
    const date = value instanceof Date ? value : new Date(value);
    return Number.isNaN(date.getTime()) ? String(value).slice(0, 10) : date.toLocaleDateString("fr-FR");
  };
  const formatDateTime = (value) => {
    if (!value) return "N/A";
    const date = value instanceof Date ? value : new Date(value);
    return Number.isNaN(date.getTime()) ? String(value) : date.toLocaleString("fr-FR");
  };
  const paymentStatusLabel = paymentStatusLabels[payment.payment_status] || payment.payment_status;
  const paymentMethodLabel = paymentMethodLabels[payment.payment_method] || payment.payment_method || "Paiement";
  const bookingDateValue = formatDate(payment.booking_date);
  const bookingTimeValue = String(payment.booking_time || "").slice(0, 5) || "N/A";
  const details = payment.payment_details || {};
%>

<section class="py-10">
  <div class="mx-auto max-w-5xl px-4">
    <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-blue-300">
          <%= isClientView ? "Paiement client" : "Paiement recu" %>
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-white">Detail simple du paiement</h1>
        <p class="mt-2 max-w-2xl text-slate-400">
          <%= isClientView
            ? "Ici, vous voyez clairement ce que vous avez regle."
            : "Ici, vous voyez clairement ce que le client vous a regle." %>
        </p>
      </div>

      <a
        href="<%= isClientView ? '/payments' : '/users/profile/service-payments' %>"
        class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-100 transition hover:border-white/20 hover:bg-white/10"
      >
        Retour
      </a>
    </div>

    <div class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
      <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.2em] text-blue-300">Service</p>
          <h2 class="mt-2 text-2xl font-semibold text-white"><%= payment.service_title || "Service" %></h2>
          <% if (payment.service_description) { %>
            <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-300"><%= payment.service_description %></p>
          <% } %>
        </div>

        <div class="text-left md:text-right">
          <span class="inline-flex items-center rounded-full border border-emerald-400/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-200">
            <%= paymentStatusLabel %>
          </span>
          <p class="mt-3 text-2xl font-semibold text-emerald-300"><%= (payment.amount ?? 0).toString().replace(".", ",") %> EUR</p>
        </div>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
          <p class="text-xs uppercase tracking-[0.18em] text-slate-400">Quand paye ?</p>
          <p class="mt-2 text-sm font-semibold text-slate-100"><%= formatDateTime(payment.payment_date || payment.created_at) %></p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
          <p class="text-xs uppercase tracking-[0.18em] text-slate-400">Mode</p>
          <p class="mt-2 text-sm font-semibold text-slate-100"><%= paymentMethodLabel %></p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
          <p class="text-xs uppercase tracking-[0.18em] text-slate-400">Creneau</p>
          <p class="mt-2 text-sm font-semibold text-slate-100"><%= bookingDateValue %></p>
          <p class="mt-1 text-sm text-slate-300">A <%= bookingTimeValue %></p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
          <p class="text-xs uppercase tracking-[0.18em] text-slate-400"><%= isClientView ? "Prestataire" : "Client" %></p>
          <p class="mt-2 text-sm font-semibold text-slate-100">
            <%= isClientView ? (payment.provider_name || "Prestataire") : (payment.client_name || "Client") %>
          </p>
          <p class="mt-1 text-sm text-slate-300">
            <%= isClientView ? (payment.provider_email || "Email non renseigne") : (payment.client_email || "Email non renseigne") %>
          </p>
        </div>
      </div>

      <div class="mt-4 grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="rounded-2xl border border-white/10 bg-slate-900/30 p-5">
          <p class="text-xs uppercase tracking-[0.18em] text-blue-300">Informations du paiement</p>

          <div class="mt-4 grid gap-3 md:grid-cols-2">
            <% if (details.cardholder_name) { %>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <p class="text-xs uppercase tracking-[0.16em] text-slate-400">Titulaire</p>
                <p class="mt-2 text-sm font-semibold text-slate-100"><%= details.cardholder_name %></p>
              </div>
            <% } %>

            <% if (details.last4) { %>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <p class="text-xs uppercase tracking-[0.16em] text-slate-400">Carte</p>
                <p class="mt-2 text-sm font-semibold text-slate-100">**** <%= details.last4 %></p>
              </div>
            <% } %>

            <% if (details.paypal_full_name) { %>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <p class="text-xs uppercase tracking-[0.16em] text-slate-400">Titulaire PayPal</p>
                <p class="mt-2 text-sm font-semibold text-slate-100"><%= details.paypal_full_name %></p>
              </div>
            <% } %>

            <% if (details.paypal_email) { %>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <p class="text-xs uppercase tracking-[0.16em] text-slate-400">Compte PayPal</p>
                <p class="mt-2 text-sm font-semibold text-slate-100"><%= details.paypal_email %></p>
              </div>
            <% } %>

            <% if (details.bank_account_name) { %>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <p class="text-xs uppercase tracking-[0.16em] text-slate-400">Titulaire du compte</p>
                <p class="mt-2 text-sm font-semibold text-slate-100"><%= details.bank_account_name %></p>
              </div>
            <% } %>

            <% if (details.bank_name) { %>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <p class="text-xs uppercase tracking-[0.16em] text-slate-400">Banque</p>
                <p class="mt-2 text-sm font-semibold text-slate-100"><%= details.bank_name %></p>
              </div>
            <% } %>

            <% if (details.bic) { %>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <p class="text-xs uppercase tracking-[0.16em] text-slate-400">BIC</p>
                <p class="mt-2 text-sm font-semibold text-slate-100"><%= details.bic %></p>
              </div>
            <% } %>

            <% if (details.iban_last4) { %>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <p class="text-xs uppercase tracking-[0.16em] text-slate-400">IBAN</p>
                <p class="mt-2 text-sm font-semibold text-slate-100">**** <%= details.iban_last4 %></p>
              </div>
            <% } %>

            <% if (details.paypal_reference || details.transfer_reference) { %>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4 md:col-span-2">
                <p class="text-xs uppercase tracking-[0.16em] text-slate-400">Reference</p>
                <p class="mt-2 text-sm font-semibold text-slate-100"><%= details.paypal_reference || details.transfer_reference %></p>
              </div>
            <% } %>

            <% if (!details || Object.keys(details).length === 0) { %>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4 md:col-span-2">
                <p class="text-sm text-slate-300">Aucune information supplementaire pour ce paiement.</p>
              </div>
            <% } %>
          </div>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/30 p-5">
          <p class="text-xs uppercase tracking-[0.18em] text-blue-300">Resume simple</p>
          <p class="mt-3 text-sm leading-7 text-slate-200">
            <% if (isClientView) { %>
              Vous avez paye ce service. La discussion reste ouverte si vous avez encore besoin de parler.
            <% } else { %>
              Le client a bien paye ce service. Le creneau est maintenant reserve pour lui.
            <% } %>
          </p>

          <div class="mt-5 flex flex-wrap gap-2">
            <a
              href="/services/<%= payment.service_slug %>"
              class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-100 transition hover:border-white/20 hover:bg-white/10"
            >
              Voir le service
            </a>

            <% if (payment.conversation_id) { %>
              <a
                href="/conversations/<%= payment.conversation_id %>"
                class="inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-blue-500"
              >
                Ouvrir la discussion
              </a>
            <% } %>

            <a
              href="<%= isClientView ? `/bookings/${payment.booking_id}` : `/users/profile/service-bookings/detail/${payment.booking_id}` %>"
              class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-100 transition hover:border-white/20 hover:bg-white/10"
            >
              Voir la reservation
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
