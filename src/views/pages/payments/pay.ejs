<section class="py-10">
  <div class="max-w-2xl mx-auto px-4">
    <div class="p-8 rounded-2xl bg-white/5 border border-white/10 shadow-xl">
      <h1 class="text-2xl font-semibold">Paiement</h1>
      <p class="mt-2 text-slate-300"><%= booking.service_title || "Service" %></p>
      <p class="mt-1 text-emerald-300 font-medium"><%= (booking.amount ?? 0).toString().replace(".", ",") %> EUR</p>

      <form action="/payments/<%= booking.booking_id %>" method="POST" class="mt-8 space-y-5">
        <% if (csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>
        <input type="hidden" name="amount" value="<%= booking.amount %>">

        <div>
          <label class="block text-sm text-slate-300 mb-2" for="payment_method">Mode de paiement</label>
          <select
            id="payment_method"
            name="payment_method"
            required
            class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
          >
            <option value="card">Carte bancaire</option>
            <option value="cash">Especes</option>
            <option value="bank_transfer">Virement bancaire</option>
          </select>
        </div>

        <button
          type="submit"
          class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 transition font-medium"
        >
          Valider le paiement
        </button>
      </form>
    </div>
  </div>
</section>
