<!--
  Vue client des cartes enregistrees.
  Cette page centralise les moyens de paiement memorises
  pour rassurer l'utilisateur et accelerer ses prochains paiements.
-->
<section class="py-10">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-blue-300">Paiements</p>
        <h1 class="mt-2 text-2xl md:text-3xl font-semibold">Mes cartes enregistrees</h1>
        <p class="mt-2 max-w-2xl text-slate-400">
          Retrouvez ici vos cartes memorisees pour payer plus rapidement, sans exposer de données sensibles.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href="/payments"
          class="inline-flex items-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium hover:border-white/20 hover:bg-white/10 transition"
        >
          Voir mes paiements
        </a>
        <a
          href="/services"
          class="inline-flex items-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-500 transition"
        >
          Reserver un service
        </a>
      </div>
    </div>

    <% if (!savedMethods || savedMethods.length === 0) { %>
      <div class="mt-8 rounded-3xl border border-white/10 bg-white/5 p-8 text-center shadow-xl shadow-black/10">
        <h2 class="text-xl font-semibold">Aucune carte enregistree</h2>
        <p class="mt-3 text-slate-400">
          Une carte apparaitra ici quand vous cocherez l'option d'enregistrement pendant un paiement.
        </p>
      </div>
    <% } else { %>
      <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <% savedMethods.forEach((method) => { %>
          <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Carte</p>
                <h2 class="mt-2 text-xl font-semibold text-white">
                  <%= (method.brand || "Carte").toUpperCase() %>
                </h2>
              </div>

              <% if (method.is_default) { %>
                <span class="rounded-full border border-emerald-400/20 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-300">
                  Par defaut
                </span>
              <% } %>
            </div>

            <!--
              Le numero complet n'est jamais affiche.
              On presente uniquement un masque visuel avec les 4 derniers chiffres.
            -->
            <div class="mt-5 rounded-2xl border border-white/10 bg-slate-900/40 p-5">
              <p class="text-sm text-slate-400">Numero masque</p>
              <p class="mt-2 text-2xl font-semibold tracking-[0.22em] text-white">
                **** **** **** <%= method.last4 %>
              </p>

              <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm">
                <div>
                  <p class="text-slate-500">Titulaire</p>
                  <p class="mt-1 text-slate-200"><%= method.cardholder_name %></p>
                </div>
                <div class="text-right">
                  <p class="text-slate-500">Expiration</p>
                  <p class="mt-1 text-slate-200">
                    <%= String(method.exp_month).padStart(2, "0") %>/<%= method.exp_year %>
                  </p>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
