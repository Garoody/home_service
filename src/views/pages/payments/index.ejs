<section class="py-10">
  <div class="max-w-6xl mx-auto px-4">
    <h1 class="text-2xl md:text-3xl font-semibold">Mes paiements</h1>

    <% if (!payments || payments.length === 0) { %>
      <div class="mt-8 p-6 rounded-2xl bg-white/5 border border-white/10 text-slate-300">
        Aucun paiement pour le moment.
      </div>
    <% } else { %>
      <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <% payments.forEach((p) => { %>
          <article class="rounded-2xl border border-white/10 bg-white/5 p-6">
            <p class="text-xs text-blue-300 uppercase tracking-wide"><%= p.payment_status %></p>
            <h2 class="mt-2 text-lg font-semibold"><%= p.service_title || "Service" %></h2>
            <p class="mt-2 text-sm text-slate-300">Mode: <span class="text-slate-100"><%= p.payment_method %></span></p>
            <p class="mt-1 text-sm text-emerald-300"><%= (p.amount ?? 0).toString().replace(".", ",") %> EUR</p>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
