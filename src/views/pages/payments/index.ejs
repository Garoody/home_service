<section class="py-10">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-blue-300">Paiements</p>
        <h1 class="mt-2 text-2xl md:text-3xl font-semibold">Mes paiements</h1>
        <p class="mt-2 max-w-2xl text-slate-400">
          Consultez l'historique de vos reglements et accedez a vos cartes enregistrees.
        </p>
      </div>

      <a
        href="/payments/cards"
        class="inline-flex items-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium hover:border-white/20 hover:bg-white/10 transition"
      >
        Voir mes cartes
      </a>
    </div>
    <% const paymentMethodLabels = { cb: "CB", visa: "Visa", mastercard: "Mastercard", other: "Autre", card: "Carte bancaire", paypal: "PayPal", cash: "Especes", bank_transfer: "Virement bancaire" }; %>
    <% const paymentStatusLabels = { paid: "Paye", pending: "En attente" }; %>

    <% if (!payments || payments.length === 0) { %>
      <div class="mt-8 p-6 rounded-2xl bg-white/5 border border-white/10 text-slate-300">
        Aucun paiement pour le moment.
      </div>
    <% } else { %>
      <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <% payments.forEach((p) => { %>
          <% const paymentCardLink = `/payments/history/${p.id}`; %>
          <article
            class="service-card--interactive rounded-2xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10"
            tabindex="0"
            data-card-link="<%= paymentCardLink %>"
          >
            <div class="flex items-start justify-between gap-4">
              <p class="text-xs text-blue-300 uppercase tracking-wide"><%= paymentStatusLabels[p.payment_status] || p.payment_status %></p>
              <a href="/payments/cards" class="text-xs font-medium text-slate-400 hover:text-white transition">
                Cartes enregistrees
              </a>
            </div>
            <h2 class="mt-2 text-lg font-semibold"><%= p.service_title || "Service" %></h2>
            <p class="mt-2 text-sm text-slate-300">Mode: <span class="text-slate-100"><%= paymentMethodLabels[p.payment_method] || p.payment_method %></span></p>
            <% if (p.payment_details?.paypal_email) { %>
              <p class="mt-1 text-sm text-slate-300">Compte PayPal: <span class="text-slate-100"><%= p.payment_details.paypal_email %></span></p>
            <% } %>
            <% if (p.payment_details?.paypal_full_name) { %>
              <p class="mt-1 text-sm text-slate-300">Titulaire PayPal: <span class="text-slate-100"><%= p.payment_details.paypal_full_name %></span></p>
            <% } %>
            <% if (p.payment_details?.bank_account_name) { %>
              <p class="mt-1 text-sm text-slate-300">Titulaire: <span class="text-slate-100"><%= p.payment_details.bank_account_name %></span></p>
            <% } %>
            <% if (p.payment_details?.bank_name) { %>
              <p class="mt-1 text-sm text-slate-300">Banque: <span class="text-slate-100"><%= p.payment_details.bank_name %></span></p>
            <% } %>
            <% if (p.payment_details?.iban_last4) { %>
              <p class="mt-1 text-sm text-slate-300">IBAN: <span class="text-slate-100">•••• <%= p.payment_details.iban_last4 %></span></p>
            <% } %>
            <% if (p.payment_details?.bic) { %>
              <p class="mt-1 text-sm text-slate-300">BIC / SWIFT: <span class="text-slate-100"><%= p.payment_details.bic %></span></p>
            <% } %>
            <% if (p.payment_details?.paypal_reference || p.payment_details?.transfer_reference) { %>
              <p class="mt-1 text-sm text-slate-300">Reference: <span class="text-slate-100"><%= p.payment_details.paypal_reference || p.payment_details.transfer_reference %></span></p>
            <% } %>
            <% if (p.payment_details?.last4) { %>
              <p class="mt-1 text-sm text-slate-300">Carte: <span class="text-slate-100">•••• <%= p.payment_details.last4 %></span></p>
            <% } %>
            <% if (p.payment_method === "cash") { %>
              <p class="mt-1 text-sm text-slate-300">Reglement: <span class="text-slate-100">En especes lors de la prestation</span></p>
            <% } %>
            <p class="mt-1 text-sm text-emerald-300"><%= (p.amount ?? 0).toString().replace(".", ",") %> EUR</p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a
                href="/payments/history/<%= p.id %>"
                class="inline-flex items-center rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-white transition hover:border-white/20 hover:bg-white/10"
              >
                Voir le détail
              </a>
              <% if (p.payment_status === "paid" && p.conversation_id) { %>
                <a
                  href="/conversations/<%= p.conversation_id %>"
                  class="inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-500"
                >
                  Ouvrir la discussion
                </a>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
