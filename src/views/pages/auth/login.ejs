<!-- Pages statiques interface utilisateurs -->
<!-- src/views/pages/auth/login.ejs -->
<section class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 py-10">
  <div class="w-full max-w-md">
    <div class="mb-6 text-center">
      <h1 class="text-3xl font-semibold tracking-tight">Connexion</h1>
      <p class="mt-2 text-sm text-slate-400">
        Connecte-toi pour gérer tes services et tes réservations avec un seul compte.
      </p>
    </div>

    <div class="p-8 rounded-2xl bg-white/5 backdrop-blur border border-white/10 shadow-xl shadow-black/20">
      <% if (typeof error !== "undefined" && error) { %>
      <div class="auth-feedback auth-feedback--error" role="alert" aria-live="polite">
        <span class="auth-feedback__icon" aria-hidden="true">!</span>
        <p class="auth-feedback__text"><%= error %></p>
      </div>
      <% } %>

      <form action="/auth/login" method="POST" class="space-y-5">
        <% if (typeof csrfToken !== "undefined" && csrfToken) { %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>

        <div>
          <label for="email" class="block text-sm mb-1 text-slate-300">Email</label>
          <input id="email" type="text" name="email" value="<%= (formData && formData.email) ? formData.email : '' %>"
            autocomplete="email" required placeholder="exemple@mail.com"
            inputmode="email" autocapitalize="none" spellcheck="false"
            class="w-full px-4 py-2.5 rounded-lg bg-slate-900/70 border border-slate-700 text-slate-100 placeholder:text-slate-500 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition">
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="password" class="block text-sm text-slate-300">Mot de passe</label>
          </div>
          <input id="password" type="password" name="password" autocomplete="current-password" required
            placeholder="Ton mot de passe"
            class="w-full px-4 py-2.5 rounded-lg bg-slate-900/70 border border-slate-700 
            text-slate-100 placeholder:text-slate-500 focus:border-blue-500 focus:ring-1 
            focus:ring-blue-500 outline-none transition">

          <label class="mt-3 inline-flex items-center gap-2 text-sm text-slate-400" data-password-toggle>
            <input
              type="checkbox"
              class="accent-blue-500"
              data-password-visibility
              data-password-target="password"
            >
            <span>Afficher le mot de passe</span>
          </label>
        </div>

        <button type="submit"
          class="w-full py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 active:bg-blue-700 
          transition font-medium shadow-lg shadow-blue-600/20">
          Se connecter
        </button>
      </form>

      <div class="my-6 flex items-center gap-3" aria-hidden="true">
        <span class="h-px flex-1 bg-white/10"></span>
        <span class="text-xs uppercase tracking-[0.2em] text-slate-500">ou</span>
        <span class="h-px flex-1 bg-white/10"></span>
      </div>

      <% if (googleAuthAvailable) { %>
        <a
          href="/auth/google"
          class="flex w-full items-center justify-center gap-3 rounded-lg border border-slate-600 bg-white px-4 py-2.5 font-medium text-slate-800 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-950"
          aria-label="Continuer avec Google"
        >
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M21.8 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.5a4.7 4.7 0 0 1-2 3.1v2.5h3.2c1.9-1.8 3.1-4.4 3.1-7.4Z"/>
            <path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.2-2.5c-.9.6-2 .9-3.5.9-2.7 0-5-1.8-5.9-4.3H2.8v2.6A10 10 0 0 0 12 22Z"/>
            <path fill="#FBBC05" d="M6.1 13.7A6 6 0 0 1 5.8 12c0-.6.1-1.2.3-1.7V7.7H2.8A10 10 0 0 0 2 12c0 1.6.4 3.1.8 4.3l3.3-2.6Z"/>
            <path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.9 1.5l2.9-2.9A10 10 0 0 0 2.8 7.7l3.3 2.6C7 7.8 9.3 6 12 6Z"/>
          </svg>
          Continuer avec Google
        </a>
      <% } else { %>
        <button
          type="button"
          disabled
          class="flex w-full cursor-not-allowed items-center justify-center gap-3 rounded-lg border border-white/10 bg-white/5 px-4 py-2.5 font-medium text-slate-500"
          aria-describedby="google-auth-unavailable"
        >
          <svg aria-hidden="true" class="h-5 w-5 opacity-60" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M21.8 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.5a4.7 4.7 0 0 1-2 3.1v2.5h3.2c1.9-1.8 3.1-4.4 3.1-7.4Z"/>
            <path fill="#34A853" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.2-2.5c-.9.6-2 .9-3.5.9-2.7 0-5-1.8-5.9-4.3H2.8v2.6A10 10 0 0 0 12 22Z"/>
            <path fill="#FBBC05" d="M6.1 13.7A6 6 0 0 1 5.8 12c0-.6.1-1.2.3-1.7V7.7H2.8A10 10 0 0 0 2 12c0 1.6.4 3.1.8 4.3l3.3-2.6Z"/>
            <path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.9 1.5l2.9-2.9A10 10 0 0 0 2.8 7.7l3.3 2.6C7 7.8 9.3 6 12 6Z"/>
          </svg>
          Continuer avec Google
        </button>
        <p id="google-auth-unavailable" class="mt-2 text-center text-xs text-slate-500">
          La connexion Google n’est pas encore configurée.
        </p>
      <% } %>

      <div class="mt-6 flex items-center justify-between text-sm">
        <a href="/services" class="text-slate-400 hover:text-white transition">
          <- Retour aux services
        </a>
        <% if (!currentUser) { %>
          <a href="/auth/register" class="text-blue-400 hover:underline">
            Créer un compte
          </a>
        <% } %>
      </div>
    </div>
  </div>
</section>
