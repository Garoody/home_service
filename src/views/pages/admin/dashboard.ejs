<section class="py-10 max-w-6xl mx-auto px-4">

  <div class="flex items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Admin Dashboard</h1>
      <p class="mt-2 text-slate-400">Vue d’ensemble de la plateforme HomeService.</p>
    </div>

    <a href="/" class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-white/20 transition">
      ← Retour site
    </a>
  </div>

  <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
      <div class="text-sm text-slate-400">Utilisateurs</div>
      <div class="mt-2 text-3xl font-semibold"><%= stats.users %></div>
    </div>

    <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
      <div class="text-sm text-slate-400">Catégories</div>
      <div class="mt-2 text-3xl font-semibold"><%= stats.categories %></div>
    </div>

    <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
      <div class="text-sm text-slate-400">Services</div>
      <div class="mt-2 text-3xl font-semibold"><%= stats.services %></div>
    </div>

    <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
      <div class="text-sm text-slate-400">Réservations</div>
      <div class="mt-2 text-3xl font-semibold"><%= stats.bookings %></div>
    </div>
  </div>

  <div class="mt-10 p-6 rounded-2xl bg-white/5 border border-white/10">
    <h2 class="text-lg font-semibold">Actions rapides</h2>
    <div class="mt-4 flex flex-wrap gap-3">
      <a href="/users/search" class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 transition">Rechercher un utilisateur</a>
      <a href="/categories" class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-white/20 transition">Gérer catégories</a>
      <a href="/services" class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-white/20 transition">Gérer services</a>
      <a href="/bookings" class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-white/20 transition">Voir réservations</a>
    </div>
  </div>

</section>