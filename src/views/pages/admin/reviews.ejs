<section class="py-10 max-w-7xl mx-auto px-4">
  <%
    const getInitials = (name) =>
      String(name || "")
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map((part) => part.charAt(0).toUpperCase())
        .join("") || "?";
  %>
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-blue-300">Administration</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Moderation des avis</h1>
      <p class="mt-2 text-slate-400">Masquage public, suppression logique et conservation des traces cote admin.</p>
    </div>
    <a href="/admin" class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">
      Retour au dashboard
    </a>
  </div>

  <form method="GET" action="/admin/reviews" class="mt-8 grid gap-4 rounded-2xl border border-white/10 bg-white/5 p-5 md:grid-cols-[1fr_220px_auto]">
    <input
      type="text"
      name="q"
      value="<%= q || '' %>"
      placeholder="Rechercher par commentaire, client, prestataire ou service"
      class="rounded-xl border border-white/10 bg-slate-900/40 px-4 py-3 text-slate-100 placeholder:text-slate-500"
    >
    <select name="visibility" class="rounded-xl border border-white/10 bg-slate-900/40 px-4 py-3 text-slate-100">
      <option value="">Tous les avis</option>
      <option value="visible" <%= visibility === 'visible' ? 'selected' : '' %>>Visibles</option>
      <option value="hidden" <%= visibility === 'hidden' ? 'selected' : '' %>>Masques</option>
      <option value="deleted" <%= visibility === 'deleted' ? 'selected' : '' %>>Supprimes</option>
    </select>
    <button type="submit" class="rounded-xl bg-blue-600 px-4 py-3 font-medium text-white hover:bg-blue-500 transition">
      Filtrer
    </button>
  </form>

  <div class="mt-8 space-y-5">
    <% if (!reviews.length) { %>
      <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-6 text-slate-400">
        Aucun avis ne correspond a cette recherche.
      </div>
    <% } else { %>
      <% reviews.forEach((review) => { %>
        <article
          class="service-card--interactive rounded-2xl border border-white/10 bg-white/5 p-5"
          tabindex="0"
          data-card-focus="admin-review-panel-<%= review.id %>"
        >
          <div class="flex flex-col gap-5 xl:flex-row xl:items-start xl:justify-between">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-xl font-semibold text-white"><%= review.service_title %></h2>
                <a href="/admin/reviews/<%= review.id %>" class="text-sm text-blue-300 hover:text-blue-200 transition">Detail admin</a>
                <% if (review.deleted_by_admin_at) { %>
                  <span class="rounded-full border border-rose-400/20 bg-rose-500/15 px-3 py-1 text-xs font-medium text-rose-200">Supprime admin</span>
                <% } else if (review.hidden_by_admin) { %>
                  <span class="rounded-full border border-amber-400/20 bg-amber-500/15 px-3 py-1 text-xs font-medium text-amber-200">Masque admin</span>
                <% } else { %>
                  <span class="rounded-full border border-emerald-400/30 bg-emerald-500/20 px-3 py-1 text-xs font-semibold text-emerald-100">Avis visible</span>
                <% } %>
              </div>

              <div class="mt-4 grid gap-3 md:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
                  <div class="flex items-center gap-3">
                    <div class="admin-avatar">
                      <% if (review.client_profile_photo) { %>
                        <img
                          src="<%= review.client_profile_photo %>"
                          alt="Photo de profil de <%= review.client_name %>"
                          class="admin-avatar__image"
                        >
                      <% } else { %>
                        <span class="admin-avatar__fallback"><%= getInitials(review.client_name) %></span>
                      <% } %>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-200">Client</p>
                      <p class="mt-1 text-sm font-medium text-white"><%= review.client_name %></p>
                    </div>
                  </div>
                </div>

                <div class="rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
                  <div class="flex items-center gap-3">
                    <div class="admin-avatar">
                      <% if (review.provider_profile_photo) { %>
                        <img
                          src="<%= review.provider_profile_photo %>"
                          alt="Photo de profil de <%= review.provider_name %>"
                          class="admin-avatar__image"
                        >
                      <% } else { %>
                        <span class="admin-avatar__fallback"><%= getInitials(review.provider_name) %></span>
                      <% } %>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-200">Prestataire</p>
                      <p class="mt-1 text-sm font-medium text-white"><%= review.provider_name %></p>
                    </div>
                  </div>
                </div>
              </div>

              <p class="mt-4 text-sm text-amber-300">
                <%- "&#9733;".repeat(review.rating) %><span class="text-slate-600"><%- "&#9733;".repeat(5 - review.rating) %></span>
              </p>

              <% if (review.comment) { %>
                <p class="mt-3 whitespace-pre-line text-sm text-slate-300"><%= review.comment %></p>
              <% } %>

              <% if (review.provider_reply) { %>
                <div class="mt-4 rounded-xl border border-blue-400/20 bg-blue-500/10 px-4 py-3">
                  <p class="text-xs uppercase tracking-[0.2em] text-blue-200">Reponse du prestataire</p>
                  <p class="mt-2 whitespace-pre-line text-sm text-slate-100"><%= review.provider_reply %></p>
                </div>
              <% } %>

              <% if (review.admin_hidden_reason) { %>
                <p class="mt-3 text-sm text-slate-400">Motif admin : <%= review.admin_hidden_reason %></p>
              <% } %>
            </div>

            <form
              id="admin-review-panel-<%= review.id %>"
              action="/admin/reviews/<%= review.id %>/moderation"
              method="POST"
              class="admin-card-panel w-full max-w-xl space-y-3 rounded-2xl border border-white/10 bg-slate-900/30 p-4"
              data-admin-moderation-form="review"
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <select
                name="action"
                class="w-full rounded-xl border border-white/10 bg-slate-950/50 px-4 py-3 text-sm text-slate-100"
                data-admin-action-select
              >
                <option value="visible">Rendre visible</option>
                <option value="hidden">Masquer publiquement</option>
                <option value="deleted">Supprimer cote admin</option>
              </select>

              <textarea
                name="reason"
                rows="3"
                placeholder="Motif de moderation de l'avis"
                class="w-full rounded-xl border border-white/10 bg-slate-950/50 px-4 py-3 text-sm text-slate-100 placeholder:text-slate-500"
                data-admin-reason-input
              ></textarea>

              <p class="text-xs text-slate-400" data-admin-action-summary>
                Vous allez rendre cet avis visible.
              </p>

              <button
                type="submit"
                class="rounded-xl bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500 transition"
                data-admin-submit-button
              >
                Rendre l'avis visible
              </button>
            </form>
          </div>
        </article>
      <% }) %>
    <% } %>
  </div>
</section>
