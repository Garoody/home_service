<section class="py-10 max-w-7xl mx-auto px-4">
  <%
    const getInitials = (name) =>
      String(name || "")
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map((part) => part.charAt(0).toUpperCase())
        .join("") || "?";
    const formatMoney = (value) => Number(value || 0).toString().replace(".", ",");
    const buildReportLink = (targetType, targetId, title) =>
      `/admin/reports?target_type=${encodeURIComponent(targetType)}&target_id=${encodeURIComponent(targetId)}&title=${encodeURIComponent(title)}`;
  %>

  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-blue-300">Administration</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Détail de réservation</h1>
      <p class="mt-2 text-slate-400">Réservation, paiement, conversation et avis dans une seule vue simple.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/admin/bookings" class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">
        Retour aux réservations
      </a>
      <a href="<%= buildReportLink('booking', booking.id, `Réservation ${booking.service_title}`) %>" class="rounded-lg bg-blue-600 px-4 py-2 text-white hover:bg-blue-500 transition">
        Créer un signalement
      </a>
    </div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_24rem]">
    <section class="space-y-6">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="text-2xl font-semibold text-white"><%= booking.service_title %></h2>
          <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-slate-200"><%= booking.status %></span>
          <span class="rounded-full border border-blue-400/20 bg-blue-500/15 px-3 py-1 text-xs font-medium text-blue-200"><%= booking.payment_status %></span>
        </div>

        <div class="mt-5 grid gap-4 md:grid-cols-2">
          <div class="rounded-2xl border border-white/10 bg-slate-900/30 p-4">
            <div class="flex items-center gap-3">
              <div class="admin-avatar admin-avatar--lg">
                <% if (booking.client_profile_photo) { %>
                  <img src="<%= booking.client_profile_photo %>" alt="Photo de profil de <%= booking.client_name %>" class="admin-avatar__image">
                <% } else { %>
                  <span class="admin-avatar__fallback"><%= getInitials(booking.client_name) %></span>
                <% } %>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-200">Client</p>
                <p class="mt-1 text-base font-medium text-white"><%= booking.client_name %></p>
                <p class="mt-1 text-sm text-slate-400"><%= booking.client_email %></p>
                <p class="mt-1 text-sm text-slate-400"><%= booking.client_phone || 'Téléphone non renseigne' %></p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 bg-slate-900/30 p-4">
            <div class="flex items-center gap-3">
              <div class="admin-avatar admin-avatar--lg">
                <% if (booking.provider_profile_photo) { %>
                  <img src="<%= booking.provider_profile_photo %>" alt="Photo de profil de <%= booking.provider_name %>" class="admin-avatar__image">
                <% } else { %>
                  <span class="admin-avatar__fallback"><%= getInitials(booking.provider_name) %></span>
                <% } %>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-200">Prestataire</p>
                <p class="mt-1 text-base font-medium text-white"><%= booking.provider_name %></p>
                <p class="mt-1 text-sm text-slate-400"><%= booking.provider_email %></p>
                <p class="mt-1 text-sm text-slate-400"><%= booking.provider_phone || 'Téléphone non renseigne' %></p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-5 grid gap-3 text-sm text-slate-300 md:grid-cols-2 xl:grid-cols-3">
          <p><span class="text-slate-500">Date :</span> <%= new Date(booking.booking_date).toLocaleDateString('fr-FR') %></p>
          <p><span class="text-slate-500">Heure :</span> <%= String(booking.booking_time).slice(0, 5) %></p>
          <p><span class="text-slate-500">Montant :</span> <%= formatMoney(booking.total_price) %> EUR</p>
          <p><span class="text-slate-500">Ville :</span> <%= booking.city || 'Non renseignee' %></p>
          <p><span class="text-slate-500">Adresse :</span> <%= booking.address || 'Non renseignee' %></p>
          <p><span class="text-slate-500">Catégorie :</span> <%= booking.category_name %></p>
        </div>

        <div class="mt-5 flex flex-wrap gap-3 text-sm">
          <a href="/services/<%= booking.service_id %>" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">Voir le service public</a>
          <% if (booking.conversation_id) { %>
            <a href="/admin/conversations/<%= booking.conversation_id %>" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">Voir la conversation</a>
          <% } %>
          <% if (booking.payment_id) { %>
            <a href="/admin/payments/<%= booking.payment_id %>" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">Voir le paiement</a>
          <% } %>
          <% if (booking.review_id) { %>
            <a href="/admin/reviews/<%= booking.review_id %>" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">Voir l'avis</a>
          <% } %>
        </div>
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="text-xl font-semibold text-white">Messages récents</h2>
            <p class="mt-1 text-sm text-slate-400">Derniers échanges liés a cette réservation.</p>
          </div>
          <% if (booking.conversation_id) { %>
            <a href="/admin/conversations/<%= booking.conversation_id %>" class="text-sm text-blue-300 hover:text-blue-200 transition">Ouvrir tout le fil</a>
          <% } %>
        </div>

        <% if (!booking.recentMessages?.length) { %>
          <div class="mt-5 rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-5 text-sm text-slate-400">
            Aucun message récent pour cette réservation.
          </div>
        <% } else { %>
          <div class="mt-5 space-y-3">
            <% booking.recentMessages.forEach((message) => { %>
              <article class="rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
                <div class="flex items-center justify-between gap-3">
                  <p class="text-sm font-semibold text-white"><%= message.sender_name %></p>
                  <p class="text-xs text-slate-500"><%= new Date(message.created_at).toLocaleString('fr-FR') %></p>
                </div>
                <p class="mt-3 whitespace-pre-wrap text-sm text-slate-300"><%= message.content %></p>
              </article>
            <% }) %>
          </div>
        <% } %>
      </article>
    </section>

    <aside class="space-y-6">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <h2 class="text-xl font-semibold text-white">Paiement</h2>
        <div class="mt-4 space-y-2 text-sm text-slate-300">
          <p><span class="text-slate-500">Statut :</span> <%= booking.payment_status %></p>
          <p><span class="text-slate-500">Mode :</span> <%= booking.payment_method %></p>
          <p><span class="text-slate-500">Date :</span> <%= booking.payment_date ? new Date(booking.payment_date).toLocaleString('fr-FR') : 'Non paye' %></p>
        </div>

        <% if (booking.payment_details && Object.keys(booking.payment_details).length) { %>
          <div class="mt-4 rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
            <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Détails utiles</p>
            <div class="mt-3 space-y-2 text-sm text-slate-300">
              <% Object.entries(booking.payment_details).forEach(([key, value]) => { %>
                <% if (value) { %>
                  <p><span class="text-slate-500"><%= key %> :</span> <%= value %></p>
                <% } %>
              <% }) %>
            </div>
          </div>
        <% } %>
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <h2 class="text-xl font-semibold text-white">Avis client</h2>
        <% if (!booking.review_id) { %>
          <p class="mt-4 text-sm text-slate-400">Aucun avis laisse pour cette réservation.</p>
        <% } else { %>
          <p class="mt-4 text-amber-300">
            <%- "&#9733;".repeat(booking.review_rating || 0) %><span class="text-slate-600"><%- "&#9733;".repeat(5 - (booking.review_rating || 0)) %></span>
          </p>
          <p class="mt-3 whitespace-pre-wrap text-sm text-slate-300"><%= booking.review_comment || 'Commentaire non renseigne' %></p>
          <a href="/admin/reviews/<%= booking.review_id %>" class="mt-4 inline-flex rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm hover:border-white/20 transition">
            Ouvrir le détail de l'avis
          </a>
        <% } %>
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="text-xl font-semibold text-white">Trace admin</h2>
            <p class="mt-1 text-sm text-slate-400">Dernieres actions liées a cette réservation.</p>
          </div>
          <a href="/admin/logs?q=<%= encodeURIComponent(booking.id) %>" class="text-sm text-blue-300 hover:text-blue-200 transition">Tout voir</a>
        </div>

        <% if (!booking.adminLogs?.length) { %>
          <div class="mt-5 rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-5 text-sm text-slate-400">
            Aucune trace admin pour cette réservation.
          </div>
        <% } else { %>
          <div class="mt-5 space-y-3">
            <% booking.adminLogs.forEach((log) => { %>
              <article class="rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
                <p class="text-sm font-semibold text-white"><%= log.display_title %></p>
                <p class="mt-1 text-sm text-slate-300"><%= log.display_subject %></p>
                <p class="mt-2 text-sm text-slate-400"><%= log.display_detail %></p>
                <p class="mt-2 text-xs text-slate-500"><%= new Date(log.created_at).toLocaleString('fr-FR') %></p>
              </article>
            <% }) %>
          </div>
        <% } %>
      </article>
    </aside>
  </div>
</section>
