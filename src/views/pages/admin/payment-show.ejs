<section class="py-10 max-w-7xl mx-auto px-4">
  <%
    const getInitials = (name) =>
      String(name || "")
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map((part) => part.charAt(0).toUpperCase())
        .join("") || "?";
    const formatMoney = (value) => Number(value || 0).toString().replace(".", ",");
    const buildReportLink = (targetType, targetId, title) =>
      `/admin/reports?target_type=${encodeURIComponent(targetType)}&target_id=${encodeURIComponent(targetId)}&title=${encodeURIComponent(title)}`;
  %>

  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-blue-300">Administration</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Détail du paiement</h1>
      <p class="mt-2 text-slate-400">Montant, mode, réservation liée et informations utiles du paiement.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/admin/payments" class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">
        Retour aux paiements
      </a>
      <a href="<%= buildReportLink('payment', payment.id, `Paiement ${payment.service_title}`) %>" class="rounded-lg bg-blue-600 px-4 py-2 text-white hover:bg-blue-500 transition">
        Créer un signalement
      </a>
    </div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_24rem]">
    <section class="space-y-6">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="text-2xl font-semibold text-white"><%= payment.service_title %></h2>
          <span class="rounded-full border border-blue-400/20 bg-blue-500/15 px-3 py-1 text-xs font-medium text-blue-200"><%= payment.payment_status %></span>
          <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-slate-200"><%= payment.payment_method %></span>
        </div>

        <div class="mt-5 grid gap-4 md:grid-cols-2">
          <div class="rounded-2xl border border-white/10 bg-slate-900/30 p-4">
            <div class="flex items-center gap-3">
              <div class="admin-avatar admin-avatar--lg">
                <% if (payment.client_profile_photo) { %>
                  <img src="<%= payment.client_profile_photo %>" alt="Photo de profil de <%= payment.client_name %>" class="admin-avatar__image">
                <% } else { %>
                  <span class="admin-avatar__fallback"><%= getInitials(payment.client_name) %></span>
                <% } %>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-200">Client</p>
                <p class="mt-1 text-base font-medium text-white"><%= payment.client_name %></p>
                <p class="mt-1 text-sm text-slate-400"><%= payment.client_email %></p>
                <p class="mt-1 text-sm text-slate-400"><%= payment.client_phone || 'Téléphone non renseigne' %></p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 bg-slate-900/30 p-4">
            <div class="flex items-center gap-3">
              <div class="admin-avatar admin-avatar--lg">
                <% if (payment.provider_profile_photo) { %>
                  <img src="<%= payment.provider_profile_photo %>" alt="Photo de profil de <%= payment.provider_name %>" class="admin-avatar__image">
                <% } else { %>
                  <span class="admin-avatar__fallback"><%= getInitials(payment.provider_name) %></span>
                <% } %>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-200">Prestataire</p>
                <p class="mt-1 text-base font-medium text-white"><%= payment.provider_name %></p>
                <p class="mt-1 text-sm text-slate-400"><%= payment.provider_email %></p>
                <p class="mt-1 text-sm text-slate-400"><%= payment.provider_phone || 'Téléphone non renseigne' %></p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-5 grid gap-3 text-sm text-slate-300 md:grid-cols-2 xl:grid-cols-3">
          <p><span class="text-slate-500">Montant :</span> <%= formatMoney(payment.amount) %> EUR</p>
          <p><span class="text-slate-500">Réservation :</span> <%= payment.booking_status %></p>
          <p><span class="text-slate-500">Date de réservation :</span> <%= new Date(payment.booking_date).toLocaleDateString('fr-FR') %></p>
          <p><span class="text-slate-500">Heure :</span> <%= String(payment.booking_time).slice(0, 5) %></p>
          <p><span class="text-slate-500">Paiement effectué :</span> <%= payment.payment_date ? new Date(payment.payment_date).toLocaleString('fr-FR') : 'Non confirme' %></p>
          <p><span class="text-slate-500">Catégorie :</span> <%= payment.category_name %></p>
        </div>

        <div class="mt-5 flex flex-wrap gap-3 text-sm">
          <a href="/admin/bookings/<%= payment.booking_id %>" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">Voir la réservation</a>
          <% if (payment.conversation_id) { %>
            <a href="/admin/conversations/<%= payment.conversation_id %>" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">Voir la conversation</a>
          <% } %>
          <% if (payment.review_id) { %>
            <a href="/admin/reviews/<%= payment.review_id %>" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">Voir l'avis</a>
          <% } %>
        </div>
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <h2 class="text-xl font-semibold text-white">Détails du mode de paiement</h2>
        <% if (!payment.payment_details || !Object.keys(payment.payment_details).length) { %>
          <div class="mt-5 rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-5 text-sm text-slate-400">
            Aucun détail complementaire enregistre pour ce paiement.
          </div>
        <% } else { %>
          <div class="mt-5 grid gap-3 md:grid-cols-2">
            <% Object.entries(payment.payment_details).forEach(([key, value]) => { %>
              <% if (value) { %>
                <div class="rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
                  <p class="text-xs uppercase tracking-[0.18em] text-slate-500"><%= key %></p>
                  <p class="mt-2 text-sm text-slate-200"><%= value %></p>
                </div>
              <% } %>
            <% }) %>
          </div>
        <% } %>
      </article>
    </section>

    <aside class="space-y-6">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <h2 class="text-xl font-semibold text-white">Suivi</h2>
        <div class="mt-4 space-y-2 text-sm text-slate-300">
          <p><span class="text-slate-500">Paiement :</span> <%= payment.payment_status %></p>
          <p><span class="text-slate-500">Mode :</span> <%= payment.payment_method %></p>
          <p><span class="text-slate-500">Réservation :</span> <%= payment.booking_status %></p>
          <p><span class="text-slate-500">Avis client :</span> <%= payment.review_id ? `${payment.review_rating || 0}/5` : 'Aucun avis' %></p>
        </div>
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="text-xl font-semibold text-white">Trace admin</h2>
            <p class="mt-1 text-sm text-slate-400">Dernieres actions liées a ce paiement.</p>
          </div>
          <a href="/admin/logs?q=<%= encodeURIComponent(payment.id) %>" class="text-sm text-blue-300 hover:text-blue-200 transition">Tout voir</a>
        </div>

        <% if (!payment.adminLogs?.length) { %>
          <div class="mt-5 rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-5 text-sm text-slate-400">
            Aucune trace admin pour ce paiement.
          </div>
        <% } else { %>
          <div class="mt-5 space-y-3">
            <% payment.adminLogs.forEach((log) => { %>
              <article class="rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
                <p class="text-sm font-semibold text-white"><%= log.display_title %></p>
                <p class="mt-1 text-sm text-slate-300"><%= log.display_subject %></p>
                <p class="mt-2 text-sm text-slate-400"><%= log.display_detail %></p>
                <p class="mt-2 text-xs text-slate-500"><%= new Date(log.created_at).toLocaleString('fr-FR') %></p>
              </article>
            <% }) %>
          </div>
        <% } %>
      </article>
    </aside>
  </div>
</section>
