<!--
  Historique des avertissements admin.
  Cette page permet de suivre les sanctions deja envoyees.
-->
<section class="py-10 max-w-5xl mx-auto px-4 space-y-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-orange-300">Administration</p>
      <h1 class="mt-2 text-3xl font-semibold">Avertissements</h1>
    </div>
    <a href="/admin" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-medium hover:border-white/20 transition">Retour dashboard</a>
  </div>

  <div class="space-y-4">
    <% if (!page.warnings.length) { %>
      <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-6 text-sm text-slate-400">Aucun avertissement enregistre.</div>
    <% } else { %>
      <% page.warnings.forEach((warning) => { %>
        <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="text-lg font-medium text-white"><%= warning.user_name %></h2>
              <p class="mt-2 text-sm text-slate-400"><%= warning.message %></p>
              <p class="mt-2 text-xs uppercase tracking-[0.18em] text-slate-500">
                Envoye par <%= warning.admin_name || "Admin" %> - <%= new Date(warning.created_at).toLocaleDateString("fr-FR") %>
              </p>
            </div>
            <span class="rounded-full border border-orange-500/20 bg-orange-500/10 px-3 py-1 text-xs text-orange-200"><%= warning.sanction_applied %></span>
          </div>
        </article>
      <% }) %>
    <% } %>
  </div>
</section>
