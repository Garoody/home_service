<!--
  Liste admin des signalements.
  L'admin intervient ici uniquement apres publication et signalement.
-->
<section class="py-10 max-w-6xl mx-auto px-4 space-y-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-red-300">Administration</p>
      <h1 class="mt-2 text-3xl font-semibold">Signalements</h1>
    </div>
    <a href="/admin" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-medium hover:border-white/20 transition">Retour dashboard</a>
  </div>

  <form action="/admin/reports" method="GET" class="grid grid-cols-1 gap-3 md:grid-cols-3">
    <select name="report_status" class="rounded-xl border border-white/10 bg-slate-900/70 px-4 py-3 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
      <option value="">Tous les signalements</option>
      <option value="pending" <%= page.filters.reportStatus === "pending" ? "selected" : "" %>>En attente</option>
      <option value="reviewed" <%= page.filters.reportStatus === "reviewed" ? "selected" : "" %>>Revu</option>
      <option value="resolved" <%= page.filters.reportStatus === "resolved" ? "selected" : "" %>>Resolus</option>
      <option value="dismissed" <%= page.filters.reportStatus === "dismissed" ? "selected" : "" %>>Rejetes</option>
    </select>
    <select name="target_type" class="rounded-xl border border-white/10 bg-slate-900/70 px-4 py-3 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
      <option value="">Toutes les cibles</option>
      <option value="service" <%= page.filters.targetType === "service" ? "selected" : "" %>>Service</option>
      <option value="review" <%= page.filters.targetType === "review" ? "selected" : "" %>>Commentaire</option>
      <option value="user" <%= page.filters.targetType === "user" ? "selected" : "" %>>Utilisateur</option>
    </select>
    <button type="submit" class="rounded-xl bg-blue-600 px-4 py-3 font-medium text-white hover:bg-blue-500 transition">Filtrer</button>
  </form>

  <div class="space-y-4">
    <% if (!page.moderationEnabled) { %>
      <div class="rounded-2xl border border-amber-500/20 bg-amber-500/10 px-5 py-4 text-sm text-amber-100">
        Actions de moderation indisponibles tant que la migration <code>db:tables:moderation</code> n'a pas ete lancee.
      </div>
    <% } %>

    <% if (!page.reports.length) { %>
      <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-6 text-sm text-slate-400">Aucun signalement a afficher.</div>
    <% } else { %>
      <% page.reports.forEach((report) => { %>
        <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <div class="flex flex-wrap gap-2">
                <span class="rounded-full border border-red-500/20 bg-red-500/10 px-3 py-1 text-xs text-red-200 capitalize"><%= report.target_type %></span>
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-300 capitalize"><%= report.status %></span>
              </div>
              <h2 class="mt-3 text-lg font-medium text-white"><%= report.target_label || "Contenu indisponible" %></h2>
              <p class="mt-2 text-sm text-slate-400">Signale par <span class="text-slate-200"><%= report.reporter_name || "Utilisateur" %></span></p>
              <p class="mt-2 text-sm text-slate-300">Motif : <span class="text-white"><%= report.reason %></span></p>
              <% if (report.details) { %>
                <p class="mt-2 whitespace-pre-line text-sm text-slate-400"><%= report.details %></p>
              <% } %>
            </div>
          </div>

          <% if (page.moderationEnabled) { %>
            <form action="/admin/reports/<%= report.id %>/review" method="POST" class="mt-4 grid gap-3 md:grid-cols-[180px_1fr_auto]">
              <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
              <select name="status" class="rounded-xl border border-white/10 bg-slate-950/70 px-4 py-3 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                <option value="reviewed">Marquer comme revu</option>
                <option value="resolved">Resoudre</option>
                <option value="dismissed">Rejeter</option>
              </select>
              <input type="text" name="resolution_note" placeholder="Note de moderation" class="rounded-xl border border-white/10 bg-slate-950/70 px-4 py-3 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
              <button type="submit" class="rounded-xl bg-blue-600 px-4 py-3 font-medium text-white hover:bg-blue-500 transition">Traiter</button>
            </form>
          <% } %>
        </article>
      <% }) %>
    <% } %>
  </div>
</section>
