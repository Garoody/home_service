<section class="py-10 max-w-7xl mx-auto px-4">
  <%
    const getInitials = (name) =>
      String(name || "")
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map((part) => part.charAt(0).toUpperCase())
        .join("") || "?";
  %>
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-blue-300">Administration</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Conversations client / prestataire</h1>
      <p class="mt-2 text-slate-400">
        Consultation en lecture seule des echanges lies aux reservations, avec conservation admin meme si les utilisateurs effacent leur fil de leur cote.
      </p>
    </div>
    <a href="/admin" class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">
      Retour au dashboard
    </a>
  </div>

  <form method="GET" action="/admin/conversations" class="mt-8 grid gap-4 rounded-2xl border border-white/10 bg-white/5 p-5 md:grid-cols-[1fr_auto]">
    <input
      type="text"
      name="q"
      value="<%= q || '' %>"
      placeholder="Rechercher par client, prestataire, service ou mot-cle"
      class="rounded-xl border border-white/10 bg-slate-900/40 px-4 py-3 text-slate-100 placeholder:text-slate-500"
    >
    <button type="submit" class="rounded-xl bg-blue-600 px-4 py-3 font-medium text-white hover:bg-blue-500 transition">
      Rechercher
    </button>
  </form>

  <div class="mt-8 space-y-5">
    <% if (!conversations.length) { %>
      <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-6 text-slate-400">
        Aucune conversation ne correspond a cette recherche.
      </div>
    <% } else { %>
      <% conversations.forEach((conversation) => { %>
        <article
          class="service-card--interactive rounded-2xl border border-white/10 bg-white/5 p-5"
          tabindex="0"
          data-card-link="/admin/conversations/<%= conversation.id %>"
        >
          <div class="flex flex-col gap-5 xl:flex-row xl:items-start xl:justify-between">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-xl font-semibold text-white"><%= conversation.service_title %></h2>
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-slate-200">
                  <%= conversation.booking_status %>
                </span>
                <span class="rounded-full border border-blue-400/20 bg-blue-500/15 px-3 py-1 text-xs font-medium text-blue-200">
                  <%= conversation.message_count %> message<%= conversation.message_count > 1 ? "s" : "" %>
                </span>
              </div>

              <div class="mt-4 grid gap-3 md:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
                  <div class="flex items-center gap-3">
                    <div class="admin-avatar">
                      <% if (conversation.client_profile_photo) { %>
                        <img
                          src="<%= conversation.client_profile_photo %>"
                          alt="Photo de profil de <%= conversation.client_name %>"
                          class="admin-avatar__image"
                        >
                      <% } else { %>
                        <span class="admin-avatar__fallback"><%= getInitials(conversation.client_name) %></span>
                      <% } %>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-200">Client</p>
                      <p class="mt-1 text-base font-medium text-white"><%= conversation.client_name %></p>
                      <p class="mt-1 text-sm text-slate-400"><%= conversation.client_email %></p>
                    </div>
                  </div>
                </div>

                <div class="rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
                  <div class="flex items-center gap-3">
                    <div class="admin-avatar">
                      <% if (conversation.provider_profile_photo) { %>
                        <img
                          src="<%= conversation.provider_profile_photo %>"
                          alt="Photo de profil de <%= conversation.provider_name %>"
                          class="admin-avatar__image"
                        >
                      <% } else { %>
                        <span class="admin-avatar__fallback"><%= getInitials(conversation.provider_name) %></span>
                      <% } %>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-200">Prestataire</p>
                      <p class="mt-1 text-base font-medium text-white"><%= conversation.provider_name %></p>
                      <p class="mt-1 text-sm text-slate-400"><%= conversation.provider_email %></p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="mt-4 grid gap-2 text-sm text-slate-300 md:grid-cols-2">
                <p><span class="text-slate-500">Date :</span> <%= conversation.booking_date ? new Date(conversation.booking_date).toLocaleDateString("fr-FR") : "A definir" %></p>
                <p><span class="text-slate-500">Heure :</span> <%= conversation.booking_time ? String(conversation.booking_time).slice(0, 5) : "A definir" %></p>
              </div>

              <div class="mt-4 rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Dernier message</p>
                <p class="mt-2 whitespace-pre-line text-sm text-slate-200">
                  <%= conversation.last_message || "Aucun message enregistre pour le moment." %>
                </p>
                <p class="mt-2 text-xs text-slate-500">
                  <%= conversation.last_message_at ? new Date(conversation.last_message_at).toLocaleString("fr-FR") : "Aucune activite recente" %>
                </p>
              </div>
            </div>

            <div class="w-full max-w-xs space-y-3 rounded-2xl border border-white/10 bg-slate-900/30 p-4">
              <p class="text-sm text-slate-300">
                La lecture admin reste disponible meme si la conversation est archivee ou supprimee cote utilisateur.
              </p>
              <a
                href="/admin/conversations/<%= conversation.id %>"
                class="inline-flex w-full items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-blue-500"
              >
                Ouvrir la conversation
              </a>
            </div>
          </div>
        </article>
      <% }) %>
    <% } %>
  </div>
</section>
