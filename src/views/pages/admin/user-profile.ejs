<!--
  Fiche profil admin d'un client ou d'un prestataire.
  Cette page permet a l'administration de consulter le profil, l'activite
  et l'historique de moderation d'un utilisateur.
-->
<section class="py-10 max-w-7xl mx-auto px-4 space-y-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-blue-300">Administration</p>
      <h1 class="mt-2 text-3xl font-semibold"><%= page.user.fullName %></h1>
      <p class="mt-2 text-sm text-slate-400">
        Profil <span class="capitalize text-slate-200"><%= page.user.role %></span>
      </p>
    </div>

    <a href="/admin/users" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-medium hover:border-white/20 transition">
      Retour utilisateurs
    </a>
  </div>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-[0.95fr_1.05fr]">
    <div class="space-y-6">
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-xl font-semibold">Informations du compte</h2>
        <div class="mt-5 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-3">
            <span class="text-slate-400">Email</span>
            <span class="text-slate-100"><%= page.user.email %></span>
          </div>
          <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-3">
            <span class="text-slate-400">Role</span>
            <span class="capitalize text-slate-100"><%= page.user.role %></span>
          </div>
          <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-3">
            <span class="text-slate-400">Statut</span>
            <span class="capitalize text-slate-100"><%= page.user.accountStatus %></span>
          </div>
          <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-3">
            <span class="text-slate-400">Telephone</span>
            <span class="text-slate-100"><%= page.user.phone || "Non renseigne" %></span>
          </div>
          <div class="flex items-center justify-between gap-3">
            <span class="text-slate-400">Adresse</span>
            <span class="text-slate-100"><%= page.user.address || "Non renseignee" %></span>
          </div>
        </div>
      </div>

      <% if (page.user.role === "provider") { %>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <h2 class="text-xl font-semibold">Informations prestataire</h2>
          <div class="mt-5 space-y-3 text-sm">
            <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-3">
              <span class="text-slate-400">Experience</span>
              <span class="text-slate-100"><%= page.user.experienceYears ?? "Non renseignee" %> an(s)</span>
            </div>
            <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-3">
              <span class="text-slate-400">Permis</span>
              <span class="text-slate-100"><%= page.user.hasDrivingLicense ? "Oui" : "Non" %></span>
            </div>
            <div class="border-b border-white/10 pb-3">
              <p class="text-slate-400">Zone d'intervention</p>
              <p class="mt-2 text-slate-100"><%= page.user.serviceArea || "Non renseignee" %></p>
            </div>
            <div>
              <p class="text-slate-400">Formations suivies</p>
              <p class="mt-2 whitespace-pre-line text-slate-100"><%= page.user.trainings || "Non renseignees" %></p>
            </div>
          </div>
        </div>
      <% } %>

      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-xl font-semibold">Moderation</h2>
        <% if (!page.moderationEnabled) { %>
          <div class="mt-5 rounded-2xl border border-amber-500/20 bg-amber-500/10 px-4 py-4 text-sm text-amber-100">
            Actions de moderation indisponibles tant que la migration <code>db:tables:moderation</code> n'a pas ete lancee.
          </div>
        <% } else { %>
          <div class="mt-5 grid gap-3 xl:grid-cols-[1fr_1fr_auto]">
            <form action="/admin/users/<%= page.user.id %>/warnings" method="POST" class="space-y-3">
              <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
              <input type="text" name="message" placeholder="Message d'avertissement" class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-4 py-3 text-slate-100 outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400">
              <button type="submit" class="rounded-xl bg-amber-500 px-4 py-3 font-medium text-slate-950 hover:bg-amber-400 transition">Envoyer un avertissement</button>
            </form>

            <form action="/admin/users/<%= page.user.id %>/status" method="POST" class="space-y-3">
              <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
              <select name="status" class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-4 py-3 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                <option value="active">Activer</option>
                <option value="suspended">Suspendre</option>
                <option value="banned">Bannir</option>
              </select>
              <input type="text" name="reason" placeholder="Motif de la sanction" class="w-full rounded-xl border border-white/10 bg-slate-950/70 px-4 py-3 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
              <button type="submit" class="rounded-xl bg-blue-600 px-4 py-3 font-medium text-white hover:bg-blue-500 transition">Appliquer le statut</button>
            </form>

            <form action="/admin/users/<%= page.user.id %>/delete" method="POST" data-confirm="Confirmez-vous la suppression definitive de ce compte utilisateur ?" class="self-end">
              <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
              <button type="submit" class="rounded-xl bg-red-600 px-4 py-3 font-medium text-white hover:bg-red-500 transition">Supprimer le compte</button>
            </form>
          </div>
        <% } %>
      </div>
    </div>

    <div class="space-y-6">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <% if (page.dashboard.role === "provider") { %>
          <div class="rounded-2xl border border-cyan-400/15 bg-cyan-500/10 p-4">
            <p class="text-sm text-cyan-100/70">Services</p>
            <p class="mt-2 text-3xl font-semibold text-white"><%= page.dashboard.stats.services %></p>
          </div>
          <div class="rounded-2xl border border-blue-400/15 bg-blue-500/10 p-4">
            <p class="text-sm text-blue-100/70">Reservations</p>
            <p class="mt-2 text-3xl font-semibold text-white"><%= page.dashboard.stats.bookings %></p>
          </div>
          <div class="rounded-2xl border border-amber-400/15 bg-amber-500/10 p-4">
            <p class="text-sm text-amber-100/70">Avis recus</p>
            <p class="mt-2 text-3xl font-semibold text-white"><%= page.dashboard.stats.totalReviews %></p>
          </div>
          <div class="rounded-2xl border border-fuchsia-400/15 bg-fuchsia-500/10 p-4">
            <p class="text-sm text-fuchsia-100/70">Note moyenne</p>
            <p class="mt-2 text-3xl font-semibold text-white"><%= page.dashboard.stats.averageRating %>/5</p>
          </div>
        <% } else { %>
          <div class="rounded-2xl border border-blue-400/15 bg-blue-500/10 p-4">
            <p class="text-sm text-blue-100/70">Reservations</p>
            <p class="mt-2 text-3xl font-semibold text-white"><%= page.dashboard.stats.bookings %></p>
          </div>
          <div class="rounded-2xl border border-emerald-400/15 bg-emerald-500/10 p-4">
            <p class="text-sm text-emerald-100/70">Paiements</p>
            <p class="mt-2 text-3xl font-semibold text-white"><%= page.dashboard.stats.payments %></p>
          </div>
          <div class="rounded-2xl border border-amber-400/15 bg-amber-500/10 p-4">
            <p class="text-sm text-amber-100/70">Reservations terminees</p>
            <p class="mt-2 text-3xl font-semibold text-white"><%= page.dashboard.stats.completed %></p>
          </div>
          <div class="rounded-2xl border border-fuchsia-400/15 bg-fuchsia-500/10 p-4">
            <p class="text-sm text-fuchsia-100/70">Avis laisses</p>
            <p class="mt-2 text-3xl font-semibold text-white"><%= page.dashboard.stats.reviews %></p>
          </div>
        <% } %>
      </div>

      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-xl font-semibold"><%= page.dashboard.role === "provider" ? "Activite prestataire" : "Activite client" %></h2>
        <div class="mt-5 space-y-4">
          <% if (page.dashboard.role === "provider") { %>
            <% if (!page.dashboard.latestServices.length) { %>
              <p class="text-sm text-slate-400">Aucun service publie.</p>
            <% } else { %>
              <% page.dashboard.latestServices.forEach((service) => { %>
                <article class="rounded-2xl border border-white/10 bg-slate-900/30 p-4">
                  <p class="font-medium text-white"><%= service.title %></p>
                  <p class="mt-1 text-sm text-slate-400">Categorie : <span class="text-slate-200"><%= service.category_name %></span></p>
                </article>
              <% }) %>
            <% } %>
          <% } else { %>
            <% if (!page.dashboard.recentBookings.length) { %>
              <p class="text-sm text-slate-400">Aucune reservation recente.</p>
            <% } else { %>
              <% page.dashboard.recentBookings.forEach((booking) => { %>
                <article class="rounded-2xl border border-white/10 bg-slate-900/30 p-4">
                  <p class="font-medium text-white"><%= booking.service_title %></p>
                  <p class="mt-1 text-sm text-slate-400">Statut : <span class="text-slate-200 capitalize"><%= booking.status %></span></p>
                </article>
              <% }) %>
            <% } %>
          <% } %>
        </div>
      </div>

      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-xl font-semibold">Historique moderation</h2>
        <div class="mt-5 grid gap-6 md:grid-cols-2">
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Avertissements</h3>
            <div class="mt-3 space-y-3">
              <% if (!page.warnings.length) { %>
                <p class="text-sm text-slate-400">Aucun avertissement.</p>
              <% } else { %>
                <% page.warnings.forEach((warning) => { %>
                  <article class="rounded-2xl border border-white/10 bg-slate-900/30 p-4">
                    <p class="text-sm text-slate-300"><%= warning.message %></p>
                    <p class="mt-2 text-xs uppercase tracking-[0.15em] text-slate-500"><%= warning.sanction_applied %> - <%= new Date(warning.created_at).toLocaleDateString("fr-FR") %></p>
                  </article>
                <% }) %>
              <% } %>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-400">Signalements recus</h3>
            <div class="mt-3 space-y-3">
              <% if (!page.reports.length) { %>
                <p class="text-sm text-slate-400">Aucun signalement cible sur ce profil.</p>
              <% } else { %>
                <% page.reports.forEach((report) => { %>
                  <article class="rounded-2xl border border-white/10 bg-slate-900/30 p-4">
                    <p class="text-sm text-slate-300"><%= report.reason %></p>
                    <p class="mt-2 text-xs uppercase tracking-[0.15em] text-slate-500"><%= report.status %> - <%= new Date(report.created_at).toLocaleDateString("fr-FR") %></p>
                  </article>
                <% }) %>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
