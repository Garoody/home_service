<section class="py-10 max-w-7xl mx-auto px-4">
  <%
    const getInitials = (name) =>
      String(name || "")
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map((part) => part.charAt(0).toUpperCase())
        .join("") || "?";
    const buildReportLink = (targetType, targetId, title) =>
      `/admin/reports?target_type=${encodeURIComponent(targetType)}&target_id=${encodeURIComponent(targetId)}&title=${encodeURIComponent(title)}`;
  %>

  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-blue-300">Administration</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Detail de l'avis</h1>
      <p class="mt-2 text-slate-400">Commentaire du client, reponse du prestataire, reservation et paiement lies.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/admin/reviews" class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">
        Retour aux avis
      </a>
      <a href="<%= buildReportLink('review', review.id, `Avis ${review.service_title}`) %>" class="rounded-lg bg-blue-600 px-4 py-2 text-white hover:bg-blue-500 transition">
        Creer un signalement
      </a>
    </div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_24rem]">
    <section class="space-y-6">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="text-2xl font-semibold text-white"><%= review.service_title %></h2>
          <% if (review.deleted_by_admin_at) { %>
            <span class="rounded-full border border-rose-400/20 bg-rose-500/15 px-3 py-1 text-xs font-medium text-rose-200">Supprime admin</span>
          <% } else if (review.hidden_by_admin) { %>
            <span class="rounded-full border border-amber-400/20 bg-amber-500/15 px-3 py-1 text-xs font-medium text-amber-200">Masque admin</span>
          <% } else { %>
            <span class="rounded-full border border-emerald-400/30 bg-emerald-500/20 px-3 py-1 text-xs font-semibold text-emerald-100">Visible</span>
          <% } %>
        </div>

        <div class="mt-4 text-amber-300">
          <%- "&#9733;".repeat(review.rating || 0) %><span class="text-slate-600"><%- "&#9733;".repeat(5 - (review.rating || 0)) %></span>
        </div>

        <div class="mt-5 grid gap-4 md:grid-cols-2">
          <div class="rounded-2xl border border-white/10 bg-slate-900/30 p-4">
            <div class="flex items-center gap-3">
              <div class="admin-avatar admin-avatar--lg">
                <% if (review.client_profile_photo) { %>
                  <img src="<%= review.client_profile_photo %>" alt="Photo de profil de <%= review.client_name %>" class="admin-avatar__image">
                <% } else { %>
                  <span class="admin-avatar__fallback"><%= getInitials(review.client_name) %></span>
                <% } %>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-200">Client</p>
                <p class="mt-1 text-base font-medium text-white"><%= review.client_name %></p>
                <p class="mt-1 text-sm text-slate-400"><%= review.client_email %></p>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 bg-slate-900/30 p-4">
            <div class="flex items-center gap-3">
              <div class="admin-avatar admin-avatar--lg">
                <% if (review.provider_profile_photo) { %>
                  <img src="<%= review.provider_profile_photo %>" alt="Photo de profil de <%= review.provider_name %>" class="admin-avatar__image">
                <% } else { %>
                  <span class="admin-avatar__fallback"><%= getInitials(review.provider_name) %></span>
                <% } %>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-200">Prestataire</p>
                <p class="mt-1 text-base font-medium text-white"><%= review.provider_name %></p>
                <p class="mt-1 text-sm text-slate-400"><%= review.provider_email %></p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-5 rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
          <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Commentaire du client</p>
          <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-slate-300"><%= review.comment || 'Aucun commentaire redige.' %></p>
        </div>

        <% if (review.provider_reply) { %>
          <div class="mt-5 rounded-2xl border border-blue-400/20 bg-blue-500/10 px-4 py-4">
            <p class="text-xs uppercase tracking-[0.18em] text-blue-100">Reponse publique du prestataire</p>
            <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-slate-100"><%= review.provider_reply %></p>
          </div>
        <% } %>

        <% if (review.admin_hidden_reason) { %>
          <div class="mt-5 rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
            <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Motif admin</p>
            <p class="mt-3 text-sm text-slate-300"><%= review.admin_hidden_reason %></p>
          </div>
        <% } %>
      </article>
    </section>

    <aside class="space-y-6">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <h2 class="text-xl font-semibold text-white">Suivi</h2>
        <div class="mt-4 space-y-2 text-sm text-slate-300">
          <p><span class="text-slate-500">Reservation :</span> <%= review.booking_status %></p>
          <p><span class="text-slate-500">Date :</span> <%= new Date(review.booking_date).toLocaleDateString('fr-FR') %></p>
          <p><span class="text-slate-500">Heure :</span> <%= String(review.booking_time).slice(0, 5) %></p>
          <p><span class="text-slate-500">Paiement :</span> <%= review.payment_status %> (<%= review.payment_method %>)</p>
          <p><span class="text-slate-500">Cree le :</span> <%= new Date(review.created_at).toLocaleString('fr-FR') %></p>
        </div>
        <div class="mt-5 flex flex-wrap gap-3 text-sm">
          <a href="/admin/bookings/<%= review.booking_id %>" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">Voir la reservation</a>
          <% if (review.payment_id) { %>
            <a href="/admin/payments/<%= review.payment_id %>" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">Voir le paiement</a>
          <% } %>
          <a href="/admin/services/<%= review.service_id %>" class="rounded-xl border border-white/10 bg-white/5 px-4 py-2 hover:border-white/20 transition">Voir le service</a>
        </div>
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="text-xl font-semibold text-white">Trace admin</h2>
            <p class="mt-1 text-sm text-slate-400">Actions recentes sur cet avis.</p>
          </div>
          <a href="/admin/logs?q=<%= encodeURIComponent(review.id) %>" class="text-sm text-blue-300 hover:text-blue-200 transition">Tout voir</a>
        </div>

        <% if (!review.adminLogs?.length) { %>
          <div class="mt-5 rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-5 text-sm text-slate-400">
            Aucune trace admin pour cet avis.
          </div>
        <% } else { %>
          <div class="mt-5 space-y-3">
            <% review.adminLogs.forEach((log) => { %>
              <article class="rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4">
                <p class="text-sm font-semibold text-white"><%= log.display_title %></p>
                <p class="mt-1 text-sm text-slate-300"><%= log.display_subject %></p>
                <p class="mt-2 text-sm text-slate-400"><%= log.display_detail %></p>
                <p class="mt-2 text-xs text-slate-500"><%= new Date(log.created_at).toLocaleString('fr-FR') %></p>
              </article>
            <% }) %>
          </div>
        <% } %>
      </article>
    </aside>
  </div>
</section>
