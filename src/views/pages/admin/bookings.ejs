<!--
  Liste admin des reservations.
  L'admin peut consulter ici les demandes en cas de litige ou probleme.
-->
<section class="py-10 max-w-6xl mx-auto px-4 space-y-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-fuchsia-300">Administration</p>
      <h1 class="mt-2 text-3xl font-semibold">Reservations</h1>
    </div>
    <a href="/admin" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-medium hover:border-white/20 transition">Retour dashboard</a>
  </div>

  <div class="space-y-4">
    <% if (!page.bookings.length) { %>
      <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-6 text-sm text-slate-400">Aucune reservation a afficher.</div>
    <% } else { %>
      <% page.bookings.forEach((booking) => { %>
        <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="text-lg font-medium text-white"><%= booking.service_title %></h2>
              <p class="mt-1 text-sm text-slate-400">Client : <span class="text-slate-200"><%= booking.client_name %></span></p>
              <p class="mt-2 text-sm text-slate-400">Date : <span class="text-slate-200"><%= new Date(booking.booking_date).toLocaleDateString("fr-FR") %></span> a <span class="text-slate-200"><%= String(booking.booking_time).slice(0, 5) %></span></p>
            </div>
            <div class="text-right">
              <p class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-300 capitalize"><%= booking.status %></p>
              <p class="mt-3 font-medium text-emerald-300"><%= (booking.total_price ?? 0).toString().replace(".", ",") %> EUR</p>
            </div>
          </div>
        </article>
      <% }) %>
    <% } %>
  </div>
</section>
