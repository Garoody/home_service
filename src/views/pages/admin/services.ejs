<!--
  Liste admin des services.
  Cette vue sert a supprimer rapidement un service frauduleux ou abusif.
-->
<section class="py-10 max-w-6xl mx-auto px-4 space-y-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-emerald-300">Administration</p>
      <h1 class="mt-2 text-3xl font-semibold">Services</h1>
    </div>
    <a href="/admin" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-medium hover:border-white/20 transition">Retour dashboard</a>
  </div>

  <div class="space-y-4">
    <% if (!page.moderationEnabled) { %>
      <div class="rounded-2xl border border-amber-500/20 bg-amber-500/10 px-5 py-4 text-sm text-amber-100">
        Actions de moderation indisponibles tant que la migration <code>db:tables:moderation</code> n'a pas ete lancee.
      </div>
    <% } %>

    <% if (!page.services.length) { %>
      <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-6 text-sm text-slate-400">Aucun service a afficher.</div>
    <% } else { %>
      <% page.services.forEach((service) => { %>
        <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="text-lg font-medium text-white"><%= service.title %></h2>
              <p class="mt-1 text-sm text-slate-400">Par <span class="text-slate-200"><%= service.provider_name %></span></p>
              <p class="mt-2 text-sm text-slate-400"><%= service.description %></p>
              <p class="mt-3 text-xs uppercase tracking-[0.18em] text-slate-500"><%= service.pending_reports %> signalement(s) en attente</p>
            </div>

            <% if (page.moderationEnabled) { %>
              <form action="/admin/services/<%= service.id %>/delete" method="POST" data-confirm="Confirmez-vous la suppression de ce service ? Les reservations liees seront egalement retirees.">
                <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
                <button type="submit" class="rounded-xl bg-red-600 px-4 py-3 font-medium text-white hover:bg-red-500 transition">Supprimer</button>
              </form>
            <% } %>
          </div>
        </article>
      <% }) %>
    <% } %>
  </div>
</section>
