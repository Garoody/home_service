<!--
  Formulaire unique de signalement.
  L'utilisateur choisit un motif et transmet le cas a l'administration,
  qui interviendra ensuite depuis son dashboard de moderation.
-->
<section class="py-10">
  <div class="max-w-3xl mx-auto px-4">
    <div class="mb-6">
      <a href="/services" class="text-sm text-slate-400 hover:text-white transition">
        <- Retour
      </a>
    </div>

    <div class="rounded-3xl border border-white/10 bg-white/5 p-8 shadow-xl">
      <div class="mb-6">
        <p class="text-xs uppercase tracking-[0.25em] text-amber-300">Signalement</p>
        <h1 class="mt-2 text-3xl font-semibold">Signaler un contenu</h1>
        <p class="mt-3 text-sm text-slate-400">
          Ce formulaire sert a alerter l'administration apres publication en cas
          d'abus, d'arnaque, de spam ou de comportement inapproprie.
        </p>
      </div>

      <div class="mb-6 rounded-2xl border border-white/10 bg-slate-900/40 p-5">
        <p class="text-sm text-slate-400">Element concerne</p>
        <h2 class="mt-2 text-xl font-medium text-white"><%= target.title %></h2>
        <p class="mt-2 text-sm text-slate-300"><%= target.subtitle %></p>
        <% if (target.owner_name) { %>
          <p class="mt-2 text-xs uppercase tracking-[0.18em] text-slate-500">
            Auteur : <span class="text-slate-300"><%= target.owner_name %></span>
          </p>
        <% } %>
      </div>

      <form action="/reports" method="POST" class="space-y-5">
        <% if (csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>

        <input type="hidden" name="target_type" value="<%= formData.target_type %>">
        <input type="hidden" name="target_id" value="<%= formData.target_id %>">
        <input type="hidden" name="return_to" value="<%= formData.return_to || '' %>">

        <div>
          <label for="reason" class="block text-sm text-slate-300 mb-2">Motif du signalement</label>
          <select
            id="reason"
            name="reason"
            class="w-full rounded-xl border border-white/10 bg-slate-900/70 px-4 py-3 text-slate-100 outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400"
          >
            <option value="">Choisir un motif</option>
            <option value="Arnaque">Arnaque</option>
            <option value="Spam">Spam</option>
            <option value="Insultes ou contenu offensant">Insultes ou contenu offensant</option>
            <option value="Faux contenu">Faux contenu</option>
            <option value="Service trompeur">Service trompeur</option>
            <option value="Autre probleme">Autre probleme</option>
          </select>
        </div>

        <div>
          <label for="details" class="block text-sm text-slate-300 mb-2">Details</label>
          <textarea
            id="details"
            name="details"
            rows="6"
            placeholder="Explique la situation de facon claire pour aider l'administration."
            class="w-full rounded-xl border border-white/10 bg-slate-900/70 px-4 py-3 text-slate-100 outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400"
          ></textarea>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
          <p class="text-sm text-slate-500">
            L'administration n'approuve pas les contenus avant publication. Elle intervient apres signalement.
          </p>

          <button
            type="submit"
            class="rounded-2xl bg-amber-500 px-5 py-3 font-medium text-slate-950 hover:bg-amber-400 transition"
          >
            Envoyer le signalement
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
