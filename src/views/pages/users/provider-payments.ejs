<section class="py-10">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-blue-300">Espace prestataire</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight">Paiements recus</h1>
        <p class="mt-2 text-slate-400">
          Retrouvez les reservations deja reglees par vos clients.
        </p>
      </div>
      <a href="/users/profile" class="text-sm text-blue-300 hover:text-blue-200 transition">
        Retour au profil
      </a>
    </div>

    <div class="mt-8 rounded-2xl border border-emerald-400/15 bg-emerald-500/10 p-6">
      <p class="text-sm text-emerald-100/70">Total encaisse</p>
      <p class="mt-3 text-3xl font-semibold text-white"><%= totalRevenue.toString().replace(".", ",") %> EUR</p>
    </div>

    <div class="mt-8 space-y-4">
      <% if (!payments.length) { %>
        <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-6 text-slate-400">
          Aucun paiement recu pour le moment.
        </div>
      <% } else { %>
        <% payments.forEach((payment) => { %>
          <a href="/services/<%= payment.service_slug %>" class="block rounded-2xl border border-white/10 bg-white/5 px-5 py-5 transition hover:border-white/20">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <h2 class="text-lg font-medium text-white"><%= payment.service_title %></h2>
                <p class="mt-1 text-sm text-slate-400">
                  Client : <span class="text-slate-200"><%= payment.client_name %></span>
                </p>
                <p class="mt-1 text-sm text-slate-500">
                  Mode : <span class="text-slate-300 capitalize"><%= payment.payment_method || "Paiement" %></span>
                </p>
              </div>
              <div class="text-right">
                <p class="text-emerald-300 font-medium"><%= (payment.amount ?? 0).toString().replace(".", ",") %> EUR</p>
                <p class="mt-2 text-xs text-slate-500">
                  <%= payment.payment_date ? new Date(payment.payment_date).toLocaleDateString("fr-FR") : "" %>
                </p>
              </div>
            </div>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>
</section>
