<%
  const providerName = publicUser?.fullName || "Utilisateur";
  const providerInitials = providerName
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join("") || "UT";
%>

<section class="py-10">
  <div class="max-w-6xl mx-auto px-4">
    <div class="mb-6">
      <a href="/services" class="text-sm text-slate-400 hover:text-white transition">
        <- Retour aux services
      </a>
    </div>

    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <aside class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <div class="flex flex-col items-center text-center">
          <% if (publicUser?.profilePhotoPath) { %>
            <button
              type="button"
              class="image-preview-trigger image-preview-trigger--round"
              data-image-preview
              data-image-src="<%= publicUser.profilePhotoPath %>"
              data-image-alt="Photo de profil de <%= providerName %>"
              aria-label="Voir la photo de profil de <%= providerName %>"
            >
              <img
                src="<%= publicUser.profilePhotoPath %>"
                alt="Photo de profil de <%= providerName %>"
                class="h-28 w-28 rounded-full object-cover border border-white/10 shadow-lg shadow-black/20"
              >
            </button>
          <% } else { %>
            <div class="flex h-28 w-28 items-center justify-center rounded-full border border-cyan-400/20 bg-gradient-to-br from-cyan-500/20 via-blue-500/10 to-slate-900 text-3xl font-semibold text-cyan-100 shadow-lg shadow-cyan-950/40">
              <%= providerInitials %>
            </div>
          <% } %>

          <p class="mt-5 text-xs uppercase tracking-[0.3em] text-cyan-300">Profil public</p>
          <h1 class="mt-2 text-3xl font-semibold text-white"><%= providerName %></h1>
          <p class="mt-2 text-sm text-slate-400">
            Consultez le profil public et les services proposes.
          </p>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-3">
          <div
            class="service-card--interactive rounded-2xl border border-white/10 bg-slate-900/30 p-4 text-center"
            tabindex="0"
            data-card-focus="public-services"
          >
            <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Services</p>
            <p class="mt-2 text-2xl font-semibold text-white"><%= dashboard.stats.services %></p>
          </div>
          <div
            class="service-card--interactive rounded-2xl border border-white/10 bg-slate-900/30 p-4 text-center"
            tabindex="0"
            data-card-focus="public-reviews"
          >
            <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Avis</p>
            <p class="mt-2 text-2xl font-semibold text-white"><%= dashboard.stats.totalReviews %></p>
          </div>
          <div
            class="service-card--interactive rounded-2xl border border-white/10 bg-slate-900/30 p-4 text-center"
            tabindex="0"
            data-card-focus="public-reviews"
          >
            <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Note</p>
            <p class="mt-2 text-2xl font-semibold text-amber-300"><%= dashboard.stats.averageRating %>/5</p>
          </div>
          <div
            class="service-card--interactive rounded-2xl border border-white/10 bg-slate-900/30 p-4 text-center"
            tabindex="0"
            data-card-focus="public-professional"
          >
            <p class="text-xs uppercase tracking-[0.2em] text-slate-500">Experience</p>
            <p class="mt-2 text-2xl font-semibold text-white"><%= publicUser?.experienceYears ?? "0" %></p>
          </div>
        </div>

        <div class="mt-6 space-y-4">
          <div
            class="service-card--interactive rounded-2xl border border-white/10 bg-slate-900/30 p-4"
            tabindex="0"
            data-card-focus="public-professional"
          >
            <p class="text-sm text-slate-400">Statut du prestataire</p>
            <p class="mt-2 text-slate-100"><%= publicUser?.providerStatus || "Non renseigne" %></p>
          </div>
          <div
            class="service-card--interactive rounded-2xl border border-white/10 bg-slate-900/30 p-4"
            tabindex="0"
            data-card-focus="public-professional"
          >
            <p class="text-sm text-slate-400">Zone d'intervention</p>
            <p class="mt-2 text-slate-100"><%= publicUser?.serviceArea || "Non renseignee" %></p>
          </div>
          <div
            class="service-card--interactive rounded-2xl border border-white/10 bg-slate-900/30 p-4"
            tabindex="0"
            data-card-focus="public-professional"
          >
            <p class="text-sm text-slate-400">Telephone</p>
            <p class="mt-2 text-slate-100"><%= publicUser?.phone || "Non renseigne" %></p>
          </div>
          <div
            class="service-card--interactive rounded-2xl border border-white/10 bg-slate-900/30 p-4"
            tabindex="0"
            data-card-focus="public-professional"
          >
            <p class="text-sm text-slate-400">Permis de conduire</p>
            <p class="mt-2 text-slate-100"><%= publicUser?.hasDrivingLicense ? "Oui" : "Non" %></p>
          </div>
        </div>
      </aside>

      <div class="space-y-6">
        <section id="public-professional" class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <div class="flex items-center justify-between gap-3">
            <div>
              <h2 class="text-xl font-semibold text-white">Profil professionnel</h2>
              <p class="mt-1 text-sm text-slate-400">
                Les informations utiles pour choisir cette personne.
              </p>
            </div>
          </div>

          <div class="mt-5 grid gap-4 md:grid-cols-2">
            <div
              class="service-card--interactive rounded-2xl border border-white/10 bg-slate-900/30 p-4"
              tabindex="0"
              data-card-focus="public-professional"
            >
              <p class="text-sm text-slate-400">Formations</p>
              <p class="mt-2 whitespace-pre-line text-slate-100"><%= publicUser?.trainings || "Non renseignees" %></p>
            </div>
            <div
              class="service-card--interactive rounded-2xl border border-white/10 bg-slate-900/30 p-4"
              tabindex="0"
              data-card-focus="public-professional"
            >
              <p class="text-sm text-slate-400">Membre depuis</p>
              <p class="mt-2 text-slate-100">
                <%= publicUser?.createdAt ? new Date(publicUser.createdAt).toLocaleDateString("fr-FR") : "Non renseigne" %>
              </p>
            </div>
          </div>
        </section>

        <section id="public-services" class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <div class="flex items-center justify-between gap-3">
            <div>
              <h2 class="text-xl font-semibold text-white">Services publies</h2>
              <p class="mt-1 text-sm text-slate-400">
                Les services actuellement visibles sur la plateforme.
              </p>
            </div>
          </div>

          <div class="mt-6 space-y-4">
            <% if (!dashboard.latestServices?.length) { %>
              <div class="rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-5 text-sm text-slate-400">
                Aucun service public pour le moment.
              </div>
            <% } else { %>
              <% dashboard.latestServices.forEach((service) => { %>
                <a href="/services/<%= service.slug %>" class="block rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-4 transition hover:border-white/20">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <h3 class="font-medium text-white"><%= service.title %></h3>
                      <p class="mt-1 text-sm text-slate-400">
                        Categorie : <span class="text-slate-200"><%= service.category_name %></span>
                      </p>
                    </div>
                    <div class="text-right">
                      <p class="font-medium text-emerald-300"><%= (service.price ?? 0).toString().replace(".", ",") %> EUR</p>
                    </div>
                  </div>
                </a>
              <% }) %>
            <% } %>
          </div>
        </section>

        <section id="public-reviews" class="rounded-3xl border border-white/10 bg-white/5 p-6">
          <div class="flex items-center justify-between gap-3">
            <div>
              <h2 class="text-xl font-semibold text-white">Derniers avis</h2>
              <p class="mt-1 text-sm text-slate-400">
                Quelques retours laisses par les clients.
              </p>
            </div>
          </div>

          <% if (!reviews?.length) { %>
            <div class="mt-5 rounded-2xl border border-white/10 bg-slate-900/30 px-4 py-5 text-sm text-slate-400">
              Aucun avis public pour le moment.
            </div>
          <% } else { %>
            <div class="mt-5 space-y-4">
              <% reviews.forEach((review) => { %>
                <article
                  class="service-card--interactive rounded-2xl border border-white/10 bg-slate-900/30 p-4"
                  tabindex="0"
                  data-card-link="/services/<%= review.service_slug %>"
                >
                  <div class="flex items-center justify-between gap-3">
                    <div>
                      <p class="font-medium text-slate-100"><%= review.client_name || "Client" %></p>
                      <p class="mt-1 text-xs text-slate-500">
                        <%= new Date(review.created_at).toLocaleDateString("fr-FR") %>
                      </p>
                    </div>
                    <div class="text-sm font-medium text-amber-300">
                      <%- "&#9733;".repeat(review.rating) %><span class="text-slate-600"><%- "&#9733;".repeat(5 - review.rating) %></span>
                    </div>
                  </div>

                  <% if (review.comment) { %>
                    <p class="mt-3 whitespace-pre-line text-sm text-slate-300"><%= review.comment %></p>
                  <% } %>

                  <% if (review.provider_reply) { %>
                    <div class="mt-4 rounded-xl border border-blue-400/20 bg-blue-500/10 px-4 py-3">
                      <p class="text-xs uppercase tracking-[0.2em] text-blue-200">Reponse du prestataire</p>
                      <p class="mt-2 whitespace-pre-line text-sm text-slate-100"><%= review.provider_reply %></p>
                    </div>
                  <% } %>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>
      </div>
    </div>
  </div>
</section>
