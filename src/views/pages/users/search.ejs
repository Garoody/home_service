<section class="py-16 max-w-3xl mx-auto px-4">

  <div class="p-8 rounded-2xl bg-white/5 border border-white/10 shadow-xl">

    <h1 class="text-2xl font-semibold mb-6">
      Rechercher un utilisateur
    </h1>

    <form action="/users/search" method="GET" class="space-y-4">

      <div>
        <label class="block text-sm mb-1 text-slate-300">Email</label>
        <input
          type="email"
          name="email"
          required
          class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700
                 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition">
      </div>

      <button
        type="submit"
        class="px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 transition font-medium">
        Rechercher
      </button>

    </form>

    <% if (user) { %>
      <div class="mt-8 p-5 rounded-xl bg-slate-900/40 border border-white/10">
        <h2 class="text-lg font-semibold mb-3">Résultat :</h2>
        <p><strong>Nom :</strong> <%= user.name %></p>
        <p><strong>Email :</strong> <%= user.email %></p>
        <p><strong>Rôle :</strong> <%= user.role %></p>
      </div>
    <% } %>

    <% if (message) { %>
      <div class="mt-6 text-red-400 text-sm">
        <%= message %>
      </div>
    <% } %>

  </div>

</section>