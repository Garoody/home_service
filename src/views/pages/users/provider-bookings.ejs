<section class="py-10">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-blue-300">Espace prestataire</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight">Demandes recues</h1>
        <p class="mt-2 text-slate-400">
          Suivez les demandes recues sur vos services et leur statut.
        </p>
      </div>
      <a href="/users/profile" class="text-sm text-blue-300 hover:text-blue-200 transition">
        Retour au profil
      </a>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/users/profile/provider-bookings" class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm hover:border-white/20 transition">
        Toutes les demandes
      </a>
      <a href="/users/profile/provider-bookings?status=pending" class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm hover:border-white/20 transition">
        En cours
      </a>
      <a href="/users/profile/provider-bookings?status=completed" class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm hover:border-white/20 transition">
        Terminees
      </a>
    </div>

    <div class="mt-8 space-y-4">
      <% if (!bookings.length) { %>
        <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-6 text-slate-400">
          Aucune demande trouvee pour ce filtre.
        </div>
      <% } else { %>
        <% bookings.forEach((booking) => { %>
          <a href="/services/<%= booking.service_slug %>" class="block rounded-2xl border border-white/10 bg-white/5 px-5 py-5 transition hover:border-white/20">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <h2 class="text-lg font-medium text-white"><%= booking.service_title %></h2>
                <p class="mt-1 text-sm text-slate-400">
                  Client : <span class="text-slate-200"><%= booking.client_name %></span>
                </p>
                <p class="mt-1 text-sm text-slate-500">
                  <%= booking.booking_date %> a <%= booking.booking_time %>
                </p>
              </div>
              <div class="text-right">
                <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-300 capitalize">
                  <%= booking.status %>
                </span>
                <p class="mt-3 text-emerald-300 font-medium"><%= (booking.total_price ?? 0).toString().replace(".", ",") %> EUR</p>
              </div>
            </div>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>
</section>
