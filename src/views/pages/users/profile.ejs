<%
  const initials = (user?.fullName || "Utilisateur")
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join("") || "UT";
  const bookingStatusLabels = {
    pending: "En attente",
    confirmed: "Confirmee",
    completed: "Terminee",
    cancelled: "Annulee",
  };
  const providerNotifications = (dashboard?.latestRequests || [])
    .filter((booking) => booking.status === "pending" || booking.status === "confirmed")
    .slice(0, 4);
%>

<section class="profile-dashboard">
  <div class="profile-dashboard__inner">
    <div class="profile-dashboard__header">
      <div class="profile-dashboard__intro">
        <h1>Bonjour <%= user?.fullName || "Utilisateur" %></h1>
        <p class="profile-dashboard__lead">
          Depuis ce compte, vous pouvez réserver des services, publier vos propres annonces
          et suivre toute votre activité au même endroit.
        </p>
      </div>

      <div
        class="profile-account-card service-card--interactive"
        tabindex="0"
        data-card-focus="user-profile"
      >
        <p class="profile-card__eyebrow">Compte</p>
        <p class="profile-account-card__email"><%= user?.email || "" %></p>
      </div>
    </div>

    <div class="profile-stat-grid">
      <a href="/bookings" class="profile-stat-card profile-stat-card--blue">
        <p class="profile-stat-card__label">Réservations</p>
        <p class="profile-stat-card__value"><%= dashboard.stats.bookings %></p>
      </a>
      <a href="/payments" class="profile-stat-card profile-stat-card--cyan">
        <p class="profile-stat-card__label">Paiements effectues</p>
        <p class="profile-stat-card__value"><%= dashboard.stats.payments %></p>
      </a>
      <a href="/services" class="profile-stat-card profile-stat-card--green">
        <p class="profile-stat-card__label">Services publies</p>
        <p class="profile-stat-card__value"><%= dashboard.stats.services %></p>
      </a>
      <a href="/users/profile/service-bookings" class="profile-stat-card profile-stat-card--pink">
        <p class="profile-stat-card__label">Réservations reçues</p>
        <p class="profile-stat-card__value"><%= dashboard.stats.requests %></p>
      </a>
      <a href="/bookings" class="profile-stat-card profile-stat-card--orange">
        <p class="profile-stat-card__label">Réservations en attente</p>
        <p class="profile-stat-card__value"><%= dashboard.stats.pending %></p>
      </a>
      <a href="/users/profile/reviews-given" class="profile-stat-card profile-stat-card--sky">
        <p class="profile-stat-card__label">Avis laisses</p>
        <p class="profile-stat-card__value"><%= dashboard.stats.reviewsLeft %></p>
      </a>
      <a href="/users/profile/reviews-received" class="profile-stat-card profile-stat-card--violet">
        <p class="profile-stat-card__label">Avis reçus</p>
        <p class="profile-stat-card__value"><%= dashboard.stats.reviewsReceived %></p>
      </a>
      <a href="/users/profile/service-payments" class="profile-stat-card profile-stat-card--emerald">
        <p class="profile-stat-card__label">Total encaisse</p>
        <p class="profile-stat-card__value profile-stat-card__value--money"><%= dashboard.stats.revenue.toString().replace(".", ",") %> EUR</p>
        <p class="profile-stat-card__helper">Paiements reçus sur vos services</p>
      </a>
    </div>

    <div class="profile-dashboard__columns">
      <section class="profile-panel">
        <div class="profile-panel__head">
          <div>
            <h2>Réservations récentes</h2>
            <p class="profile-panel__copy">Suivez vos prestations et leur statut.</p>
          </div>
          <a href="/bookings" class="text-link">Tout voir</a>
        </div>

        <div class="profile-list">
          <% if (!dashboard.recentBookings.length) { %>
            <div class="profile-empty-card">
              Aucune réservation pour le moment.
            </div>
          <% } else { %>
            <% dashboard.recentBookings.forEach((booking) => { %>
              <a href="/bookings" class="profile-list-card">
                <div>
                  <h3><%= booking.service_title || "Service" %></h3>
                  <p class="profile-list-card__meta">
                    Statut : <span><%= bookingStatusLabels[booking.status] || booking.status %></span>
                  </p>
                </div>
                <span class="tag tag--price"><%= (booking.total_price ?? 0).toString().replace(".", ",") %> EUR</span>
              </a>
            <% }) %>
          <% } %>
        </div>
      </section>

      <section class="profile-panel">
        <div class="profile-panel__head">
          <div>
            <h2>Services publies</h2>
            <p class="profile-panel__copy">Les annonces que vous avez déjà mises en ligne.</p>
          </div>
          <a href="/services/new" class="text-link">Publier</a>
        </div>

        <div class="profile-list">
          <% if (!dashboard.latestServices.length) { %>
            <div class="profile-empty-card">
              Aucun service publie pour le moment.
            </div>
          <% } else { %>
            <% dashboard.latestServices.forEach((service) => { %>
              <a href="/services/<%= service.slug %>" class="profile-list-card">
                <div>
                  <h3><%= service.title %></h3>
                  <p class="profile-list-card__meta">
                    Catégorie : <span><%= service.category_name %></span>
                  </p>
                </div>
                <span class="tag tag--price"><%= (service.price ?? 0).toString().replace(".", ",") %> EUR</span>
              </a>
            <% }) %>
          <% } %>
        </div>
      </section>
    </div>

    <div class="profile-dashboard__columns profile-dashboard__columns--profile">
      <section class="profile-panel profile-panel--accent">
        <div class="profile-panel__head">
          <div>
            <h2>Actions rapides</h2>
            <p class="profile-panel__copy">Accede rapidement aux actions les plus utiles de ton compte.</p>
          </div>
        </div>

        <div class="profile-quick-links">
          <a href="/services" class="profile-quick-link profile-quick-link--primary">
            Explorer les services
          </a>
          <a href="/services/new" class="profile-quick-link">
            Proposer un service
          </a>
          <a href="/users/profile/service-bookings" class="profile-quick-link">
            Voir mes réservations reçues
          </a>
          <a href="/users/profile/conversations" class="profile-quick-link">
            Mes conversations
          </a>
          <a href="/payments/cards" class="profile-quick-link">
            Mes cartes enregistrees
          </a>
          <a href="/users/profile/service-payments" class="profile-quick-link">
            Voir mes paiements reçus
          </a>
        </div>

        <div
          class="profile-activity-card service-card--interactive"
          tabindex="0"
          data-card-link="/users/profile/service-bookings"
        >
          <p class="profile-card__eyebrow">Notifications et messages reçus</p>
          <div class="profile-activity-list">
            <% if (!providerNotifications.length) { %>
              <p class="profile-activity-empty">Aucune nouvelle demande ou message pour le moment.</p>
            <% } else { %>
              <% providerNotifications.forEach((booking) => { %>
                <% const bookingDateValue = booking.booking_date instanceof Date ? booking.booking_date.toISOString().slice(0, 10) : String(booking.booking_date || "").slice(0, 10); %>
                <% const bookingTimeValue = String(booking.booking_time || "").slice(0, 5); %>
                <a href="<%= booking.conversation_id ? `/conversations/${booking.conversation_id}` : '/users/profile/service-bookings' %>" class="profile-activity-item">
                  <span class="profile-activity-item__content">
                    <span class="profile-activity-item__title"><%= booking.client_name %> souhaite réserver <%= booking.service_title %></span>
                    <span class="profile-activity-item__meta"><%= bookingDateValue || "N/A" %> a <%= bookingTimeValue || "N/A" %></span>
                  </span>
                  <span class="profile-status-pill"><%= booking.status === "confirmed" ? "Paiement du client attendu" : "A confirmer" %></span>
                </a>
              <% }) %>
            <% } %>
          </div>
        </div>

        <div
          class="profile-rating-card service-card--interactive"
          tabindex="0"
          data-card-link="/users/profile/reviews-received"
        >
          <p class="profile-card__eyebrow">Note moyenne sur vos services</p>
          <p class="profile-rating-card__value"><%= dashboard.stats.averageRating %>/5</p>
        </div>
      </section>

      <section id="user-profile" class="profile-panel profile-form-panel">
        <form
          action="/users/profile"
          method="POST"
          enctype="multipart/form-data"
          class="profile-form"
          data-confirm="Voulez-vous vraiment enregistrer les modifications de votre profil ?"
        >
          <% if (csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>

          <div class="profile-form-layout">
            <aside class="profile-photo-sidebar">
              <div class="profile-photo-card">
                <label class="profile-form-label" for="profile_photo">Photo de profil</label>
                <% if (user?.profilePhotoPath) { %>
                  <button
                    type="button"
                    class="profile-avatar-button image-preview-trigger image-preview-trigger--round"
                    data-image-preview
                    data-image-src="<%= user.profilePhotoPath %>"
                    data-image-alt="Photo de profil de <%= user?.fullName || 'Utilisateur' %>"
                    aria-label="Voir la photo de profil"
                  >
                    <img
                      src="<%= user.profilePhotoPath %>"
                      alt="Photo de profil"
                      class="profile-avatar"
                    >
                  </button>
                <% } else { %>
                  <div class="profile-avatar profile-avatar--fallback">
                    <%= initials %>
                  </div>
                <% } %>

                <div class="profile-photo-actions">
                  <button
                    type="button"
                    class="profile-photo-button"
                    data-file-trigger="profile_photo"
                  >
                    Modifier la photo
                  </button>

                  <span class="profile-photo-status" data-file-status="profile_photo" aria-live="polite"></span>
                </div>

                <input
                  id="profile_photo"
                  name="profile_photo"
                  type="file"
                  accept="image/png,image/jpeg,image/webp,image/gif"
                  class="profile-file-input profile-file-input--hidden"
                  data-file-input
                >
              </div>
            </aside>

            <div class="profile-form-main">
              <div class="profile-panel__head">
                <div>
                  <h2>Modifier mon profil</h2>
                  <p class="profile-panel__copy">
                    Mettez a jour vos informations personnelles et celles utiles pour publier des services.
                  </p>
                </div>
                <span class="profile-status-pill profile-status-pill--light">Profil</span>
              </div>
              <div class="profile-form-grid">
                <div>
                  <label class="profile-form-label" for="full_name">Nom complet</label>
                  <input
                    id="full_name"
                    name="full_name"
                    type="text"
                    value="<%= user?.fullName || '' %>"
                    required
                  >
                </div>

                <div>
                  <label class="profile-form-label" for="phone">Téléphone</label>
                  <input
                    id="phone"
                    name="phone"
                    type="text"
                    value="<%= user?.phone || '' %>"
                  >
                </div>
              </div>

              <div>
                <label class="profile-form-label" for="address">Adresse</label>
                <textarea
                  id="address"
                  name="address"
                  rows="3"
                ><%= user?.address || '' %></textarea>
              </div>

              <div class="profile-helper-box">
                <p class="profile-helper-box__title">Informations utiles si vous proposez des services</p>
                <p class="profile-helper-box__copy">
                  Ces champs restent facultatifs tant que vous ne publiez pas de service.
                </p>
              </div>

              <div class="profile-form-grid">
                <div>
                  <label class="profile-form-label" for="provider_status">Statut du prestataire</label>
                  <select
                    id="provider_status"
                    name="provider_status"
                  >
                    <option value="">Choisir un statut</option>
                    <% (providerStatusOptions || []).forEach((option) => { %>
                      <option
                        value="<%= option.value %>"
                        <%= option.value === user?.providerStatus ? "selected" : "" %>
                      >
                        <%= option.label %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div>
                  <label class="profile-form-label" for="experience_years">Annees d'expérience</label>
                  <input
                    id="experience_years"
                    name="experience_years"
                    type="number"
                    min="0"
                    max="60"
                    value="<%= user?.experienceYears ?? '' %>"
                  >
                </div>

              </div>

              <div>
                <label class="profile-form-label" for="service_area">Zone d'intervention</label>
                <input
                  id="service_area"
                  name="service_area"
                  type="text"
                  value="<%= user?.serviceArea || '' %>"
                >
              </div>

              <div>
                <label class="profile-form-label" for="trainings">Formations suivies</label>
                <textarea
                  id="trainings"
                  name="trainings"
                  rows="3"
                  placeholder="Indiquez vos formations si vous en avez"
                ><%= user?.trainings || '' %></textarea>
              </div>

              <label class="profile-checkbox">
                <input
                  type="checkbox"
                  name="has_driving_license"
                  <%= user?.hasDrivingLicense ? "checked" : "" %>
                >
                <span>Permis de conduire</span>
              </label>

              <div class="profile-form-actions">
                <button
                  type="submit"
                  class="btn-primary"
                >
                  Enregistrer mon profil
                </button>
              </div>
            </div>
          </div>
        </form>

        <form
          action="/users/profile/delete"
          method="POST"
          class="profile-delete-form"
          data-confirm="Voulez-vous vraiment supprimer votre compte utilisateur ? Toutes vos données associees seront effacees et cette action est irreversible."
        >
          <% if (csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>

          <button
            type="submit"
            class="profile-danger-button"
          >
            Supprimer mon compte
          </button>
        </form>
      </section>
    </div>
  </div>
</section>
