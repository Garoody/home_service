<section class="py-10">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-blue-300">
          <%= sectionLabel || "Activite utilisateur" %>
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight"><%= heading %></h1>
      </div>
      <a href="/users/profile" class="text-sm text-blue-300 hover:text-blue-200 transition">
        Retour au profil
      </a>
    </div>

    <div class="mt-8 space-y-4">
      <% if (!reviews.length) { %>
        <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-6 text-slate-400">
          <%= emptyMessage %>
        </div>
      <% } else { %>
        <% reviews.forEach((review) => { %>
          <article
            class="service-card--interactive rounded-2xl border border-white/10 bg-white/5 px-5 py-5"
            tabindex="0"
            data-card-link="/services/<%= review.service_slug %>"
          >
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <h2 class="text-lg font-medium text-white"><%= review.service_title %></h2>
                  <a
                    href="/services/<%= review.service_slug %>"
                    class="text-sm text-blue-300 hover:text-blue-200 transition"
                  >
                    Voir le service
                  </a>
                </div>
                <p class="mt-1 text-sm text-slate-400">
                  <%= counterpartLabel || "Par" %> :
                  <span class="text-slate-200">
                    <%= review[counterpartField] || "-" %>
                  </span>
                </p>
                <% if (review.comment) { %>
                  <p class="mt-3 text-sm text-slate-300 whitespace-pre-line"><%= review.comment %></p>
                <% } %>

                <% if (review.provider_reply) { %>
                  <div class="mt-4 rounded-xl border border-blue-400/20 bg-blue-500/10 px-4 py-3">
                    <p class="text-xs uppercase tracking-[0.2em] text-blue-200">Reponse du prestataire</p>
                    <p class="mt-2 whitespace-pre-line text-sm text-slate-100"><%= review.provider_reply %></p>
                  </div>
                <% } %>
              </div>

              <div class="text-right">
                <div class="text-amber-300 text-sm font-medium">
                  <%- "&#9733;".repeat(review.rating) %><span class="text-slate-600"><%- "&#9733;".repeat(5 - review.rating) %></span>
                </div>
                <p class="mt-2 text-xs text-slate-500">
                  <%= new Date(review.created_at).toLocaleDateString("fr-FR") %>
                </p>
              </div>
            </div>

            <% if (pageMode === "client") { %>
              <div class="mt-5 flex flex-wrap items-center gap-2">
                <a
                  href="/reviews/<%= review.id %>/edit"
                  class="inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-500"
                >
                  Modifier mon avis
                </a>
                <form action="/reviews/<%= review.id %>/delete" method="POST" class="inline-flex">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button
                    type="submit"
                    data-confirm="Voulez-vous vraiment supprimer cet avis ?"
                    class="inline-flex items-center rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-red-500"
                  >
                    Supprimer mon avis
                  </button>
                </form>
              </div>
            <% } %>

            <% if (pageMode === "provider") { %>
              <div class="mt-5 border-t border-white/10 pt-5">
                <p class="text-sm font-medium text-slate-200">
                  <%= review.provider_reply ? "Mettre a jour votre reponse publique" : "Repondre publiquement a cet avis" %>
                </p>
                <form action="/reviews/<%= review.id %>/reply" method="POST" class="mt-3 space-y-3">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <textarea
                    name="provider_reply"
                    rows="4"
                    placeholder="Ecrivez une reponse visible publiquement sous l'avis du client."
                    class="w-full rounded-xl border border-white/10 bg-slate-900/60 px-4 py-3 text-sm text-slate-100 placeholder:text-slate-500 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
                  ><%= review.provider_reply || "" %></textarea>
                  <button
                    type="submit"
                    class="inline-flex items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-500"
                  >
                    <%= review.provider_reply ? "Mettre a jour ma reponse" : "Publier ma reponse" %>
                  </button>
                </form>
              </div>
            <% } %>
          </article>
        <% }) %>
      <% } %>
    </div>
  </div>
</section>
