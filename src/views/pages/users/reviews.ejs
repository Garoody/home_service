<section class="py-10">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-blue-300">
          <%= role === "provider" ? "Espace prestataire" : "Espace client" %>
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight"><%= heading %></h1>
      </div>
      <a href="/users/profile" class="text-sm text-blue-300 hover:text-blue-200 transition">
        Retour au profil
      </a>
    </div>

    <div class="mt-8 space-y-4">
      <% if (!reviews.length) { %>
        <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-6 text-slate-400">
          <%= emptyMessage %>
        </div>
      <% } else { %>
        <% reviews.forEach((review) => { %>
          <a href="/services/<%= review.service_slug %>" class="block rounded-2xl border border-white/10 bg-white/5 px-5 py-5 transition hover:border-white/20">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <h2 class="text-lg font-medium text-white"><%= review.service_title %></h2>
                <p class="mt-1 text-sm text-slate-400">
                  <%= role === "provider" ? "Client" : "Prestataire" %> :
                  <span class="text-slate-200">
                    <%= role === "provider" ? review.client_name : review.provider_name %>
                  </span>
                </p>
                <% if (review.comment) { %>
                  <p class="mt-3 text-sm text-slate-300 whitespace-pre-line"><%= review.comment %></p>
                <% } %>
              </div>
              <div class="text-right">
                <div class="text-amber-300 text-sm font-medium">
                  <%= "★".repeat(review.rating) %><span class="text-slate-600"><%= "★".repeat(5 - review.rating) %></span>
                </div>
                <p class="mt-2 text-xs text-slate-500">
                  <%= new Date(review.created_at).toLocaleDateString("fr-FR") %>
                </p>
              </div>
            </div>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>
</section>
