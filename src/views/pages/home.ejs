<!-- <h1>HOME</h1> -->

<section class="py-16">

  <!-- HERO STYLE ALLOVOISINS -->
  <div class="relative left-1/2 right-1/2 -mx-[50vw] w-screen overflow-hidden">
    <div class="bg-slate-100 text-slate-900">
      <div class="mx-auto max-w-7xl px-6 py-14 md:py-20">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
          <div class="relative min-h-[220px] md:min-h-[280px]">
            <div class="tool-line"></div>
            <div class="tool-head"></div>
          </div>

          <div>
            <p class="uppercase tracking-[0.24em] text-xs text-slate-500 font-semibold">HomeService</p>
            <h1 class="mt-3 text-4xl md:text-6xl font-bold leading-tight text-slate-800">
              Prestations de services
              <br />
              &agrave; domicile
            </h1>
            <p class="mt-5 text-lg text-slate-600">
              Trouvez rapidement un prestataire fiable en m&eacute;nage, plomberie, jardinage et r&eacute;paration.
            </p>

            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/auth/register"
                class="px-7 py-3 rounded-full bg-slate-900 text-white hover:bg-slate-800 transition font-semibold">
                Cr&eacute;er un compte
              </a>
              <a href="/services"
                class="px-7 py-3 rounded-full border border-slate-300 text-slate-800 hover:bg-slate-200 transition font-semibold">
                Voir les services
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-slate-700 text-slate-100">
      <div class="mx-auto max-w-7xl px-6 py-6 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
        <div class="rounded-xl bg-white/10 px-4 py-3 text-center">4.6/5 satisfaction clients</div>
        <div class="rounded-xl bg-white/10 px-4 py-3 text-center">R&eacute;servation en quelques clics</div>
        <div class="rounded-xl bg-white/10 px-4 py-3 text-center">Prestataires v&eacute;rifi&eacute;s</div>
      </div>
    </div>
  </div>

  <!-- FEATURES -->
  <div class="max-w-6xl mx-auto px-4 mt-20 grid grid-cols-1 md:grid-cols-3 gap-8">

    <div class="p-8 rounded-2xl bg-white/5 border border-white/10 text-center">
      <div class="text-3xl mb-4">&#128269;</div>
      <h3 class="text-xl font-semibold">Recherche rapide</h3>
      <p class="mt-3 text-slate-400 text-sm">
        Trouvez facilement un service pr&egrave;s de chez vous.
      </p>
    </div>

    <div class="p-8 rounded-2xl bg-white/5 border border-white/10 text-center">
      <div class="text-3xl mb-4">&#128197;</div>
      <h3 class="text-xl font-semibold">R&eacute;servation simple</h3>
      <p class="mt-3 text-slate-400 text-sm">
        R&eacute;servez un professionnel en quelques &eacute;tapes.
      </p>
    </div>

    <div class="p-8 rounded-2xl bg-white/5 border border-white/10 text-center">
      <div class="text-3xl mb-4">&#11088;</div>
      <h3 class="text-xl font-semibold">Qualit&eacute; garantie</h3>
      <p class="mt-3 text-slate-400 text-sm">
        Des prestataires v&eacute;rifi&eacute;s et &eacute;valu&eacute;s par les clients.
      </p>
    </div>

  </div>

  <!-- SERVICES FROM DATABASE -->
  <div class="max-w-6xl mx-auto px-4 mt-20">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold">Services r&eacute;cents</h2>
        <p class="mt-2 text-sm text-slate-400">
          Donn&eacute;es charg&eacute;es depuis la base PostgreSQL.
        </p>
      </div>
      <a href="/services" class="text-blue-400 hover:underline text-sm">Voir tout</a>
    </div>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% if (!featuredServices || featuredServices.length === 0) { %>
        <div class="md:col-span-2 lg:col-span-3 p-6 rounded-2xl bg-white/5 border border-white/10 text-slate-300">
          Aucun service &agrave; afficher pour le moment.
        </div>
      <% } else { %>
        <% featuredServices.forEach((s) => { %>
          <a href="/services/<%= s.slug %>" class="block p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-white/20 transition">
            <div class="flex items-center justify-between gap-3 text-xs">
              <span class="px-2 py-1 rounded-full bg-blue-500/10 text-blue-300 border border-blue-500/20">
                <%= s.category_name || "Service" %>
              </span>
              <span class="px-2 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">
                <%= (s.price ?? 0).toString().replace(".", ",") %> EUR
              </span>
            </div>

            <h3 class="mt-4 text-lg font-semibold"><%= s.title %></h3>
            <p class="mt-2 text-sm text-slate-400 line-clamp-3"><%= s.description %></p>
            <p class="mt-4 text-xs text-slate-500">
              <% if (s.provider_name) { %>
                Par <span class="text-slate-300"><%= s.provider_name %></span>
              <% } %>
            </p>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- CTA FINAL -->
  <div class="max-w-4xl mx-auto px-4 mt-20 text-center">
    <h2 class="text-2xl font-semibold">
      Pr&ecirc;t &agrave; r&eacute;server votre premier service ?
    </h2>

    <a href="/services"
       class="inline-block mt-6 px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500
              transition font-medium shadow-lg shadow-emerald-600/20">
      Explorer maintenant
    </a>
  </div>

</section>

<style>
  .tool-line {
    position: absolute;
    top: 50%;
    left: -20%;
    transform: translateY(-50%);
    width: 90%;
    height: 46px;
    border-radius: 9999px;
    background: linear-gradient(90deg, #22c55e 0%, #16a34a 40%, #94a3b8 40%, #cbd5e1 100%);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
  }

  .tool-head {
    position: absolute;
    top: 50%;
    left: 62%;
    transform: translateY(-50%) rotate(-10deg);
    width: 110px;
    height: 140px;
    border-radius: 44% 56% 58% 42% / 35% 34% 66% 65%;
    background: linear-gradient(145deg, #cbd5e1, #64748b);
    box-shadow: -8px 12px 24px rgba(15, 23, 42, 0.35);
  }

  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
