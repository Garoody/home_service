<!-- <h1>HOME</h1> -->

<section class="py-16">
  <!-- HERO -->
  <div class="max-w-6xl mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
      Trouvez un professionnel
      <span class="text-blue-400">en quelques clics</span>
    </h1>

    <p class="mt-6 text-lg text-slate-400 max-w-2xl mx-auto">
      HomeService est une plateforme qui met en relation
      des clients et des prestataires de services a domicile :
      menage, plomberie, jardinage, reparation et plus encore.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/services"
        class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 transition font-medium shadow-lg shadow-blue-600/20"
      >
        Voir les services
      </a>

      <% if (!currentUser) { %>
        <a
          href="/auth/register"
          class="px-6 py-3 rounded-xl bg-white/5 border border-white/10 hover:border-white/20 transition"
        >
          Creer un compte
        </a>
      <% } %>
    </div>
  </div>

  <!-- FEATURES -->
  <div class="max-w-6xl mx-auto px-4 mt-20 grid grid-cols-1 md:grid-cols-3 gap-8">
    <a
      href="/services"
      class="group block p-8 rounded-2xl bg-white/5 border border-white/10 text-center transition hover:-translate-y-1 hover:border-blue-400/40 hover:bg-white/[0.07]"
    >
      <div class="text-3xl mb-4 text-slate-200 transition group-hover:text-blue-300">Recherche</div>
      <h3 class="text-xl font-semibold">Recherche rapide</h3>
      <p class="mt-3 text-slate-400 text-sm">
        Trouvez facilement un service pres de chez vous.
      </p>
      <span class="mt-5 inline-flex items-center text-sm font-medium text-blue-300">
        Explorer les services
      </span>
    </a>

    <a
      href="<%= currentUser ? '/bookings' : '/auth/login' %>"
      class="group block p-8 rounded-2xl bg-white/5 border border-white/10 text-center transition hover:-translate-y-1 hover:border-emerald-400/40 hover:bg-white/[0.07]"
    >
      <div class="text-3xl mb-4 text-slate-200 transition group-hover:text-emerald-300">Reservation</div>
      <h3 class="text-xl font-semibold">Reservation simple</h3>
      <p class="mt-3 text-slate-400 text-sm">
        Reservez un professionnel en quelques etapes.
      </p>
      <span class="mt-5 inline-flex items-center text-sm font-medium text-emerald-300">
        <%= currentUser ? "Voir mes reservations" : "Se connecter pour reserver" %>
      </span>
    </a>

    <a
      href="/services"
      class="group block p-8 rounded-2xl bg-white/5 border border-white/10 text-center transition hover:-translate-y-1 hover:border-amber-400/40 hover:bg-white/[0.07]"
    >
      <div class="text-3xl mb-4 text-slate-200 transition group-hover:text-amber-300">Qualite</div>
      <h3 class="text-xl font-semibold">Qualite garantie</h3>
      <p class="mt-3 text-slate-400 text-sm">
        Des prestataires verifies et evalues par les clients.
      </p>
      <span class="mt-5 inline-flex items-center text-sm font-medium text-amber-300">
        Consulter les prestataires
      </span>
    </a>
  </div>

  <!-- SERVICES FROM DATABASE -->
  <div class="max-w-6xl mx-auto px-4 mt-20">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold">Services recents</h2>
        <p class="mt-2 text-sm text-slate-400">
          Trouvez les services recents.
        </p>
      </div>
      <a href="/services" class="text-blue-400 hover:underline text-sm">Voir tout</a>
    </div>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% if (!featuredServices || featuredServices.length === 0) { %>
        <div class="md:col-span-2 lg:col-span-3 p-6 rounded-2xl bg-white/5 border border-white/10 text-slate-300">
          Aucun service a afficher pour le moment.
        </div>
      <% } else { %>
        <% featuredServices.forEach((s) => { %>
          <a
            href="/services/<%= s.slug %>"
            class="group block p-6 rounded-2xl bg-white/5 border border-white/10 transition duration-200 hover:-translate-y-1 hover:border-blue-400/40 hover:bg-white/[0.07] hover:shadow-2xl hover:shadow-blue-950/20"
          >
            <div class="flex items-center justify-between gap-3 text-xs">
              <span class="px-2 py-1 rounded-full bg-blue-500/10 text-blue-300 border border-blue-500/20 transition group-hover:border-blue-300/30 group-hover:bg-blue-500/15">
                <%= s.category_name || "Service" %>
              </span>
              <span class="px-2 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 transition group-hover:border-emerald-300/30 group-hover:bg-emerald-500/15">
                <%= (s.price ?? 0).toString().replace(".", ",") %> EUR
              </span>
            </div>

            <h3 class="mt-4 text-lg font-semibold transition group-hover:text-blue-200"><%= s.title %></h3>
            <p class="mt-2 text-sm text-slate-400 line-clamp-3 transition group-hover:text-slate-300"><%= s.description %></p>
            <p class="mt-4 text-xs text-slate-500 transition group-hover:text-slate-400">
              <% if (s.provider_name) { %>
                Par <span class="text-slate-300"><%= s.provider_name %></span>
              <% } %>
            </p>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- CTA FINAL -->
  <div class="max-w-4xl mx-auto px-4 mt-20 text-center">
    <h2 class="text-2xl font-semibold">
      Pret a reserver votre premier service ?
    </h2>

    <a
      href="/services"
      class="inline-block mt-6 px-8 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 transition font-medium shadow-lg shadow-emerald-600/20"
    >
      Explorer maintenant
    </a>
  </div>
</section>

<style>
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
