<section class="py-8">
  <div class="max-w-4xl mx-auto">

    <!-- Header -->
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1 rounded-full
                       bg-blue-500/10 text-blue-300 border border-blue-500/20">
            <span class="h-1.5 w-1.5 rounded-full bg-blue-400"></span>
            <%= service.category_name || 'Service' %>
          </span>

          <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">
            <%= (service.price ?? 0).toString().replace('.', ',') %> €
          </span>
        </div>

        <h1 class="mt-4 text-3xl font-semibold tracking-tight">
          <%= service.title %>
        </h1>

        <p class="mt-2 text-slate-400">
          <% if (service.provider_name) { %>
            Proposé par <span class="text-slate-200"><%= service.provider_name %></span>
          <% } else { %>
            Proposé par un prestataire
          <% } %>
        </p>
      </div>

      <!-- CTA -->
      <div class="flex gap-3">
        <a href="/services"
           class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-white/20 transition">
          ← Retour
        </a>

        <!-- Réserver (si tu as booking) -->
        <a href="/bookings/new?service=<%= service.slug %>"
           class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 transition font-medium shadow-lg shadow-blue-600/20">
          Réserver
        </a>
      </div>
    </div>

    <!-- Content -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 p-6 rounded-2xl bg-white/5 border border-white/10">
        <h2 class="text-lg font-semibold">Description</h2>
        <p class="mt-3 text-slate-300 leading-relaxed whitespace-pre-line">
          <%= service.description %>
        </p>
      </div>

      <aside class="p-6 rounded-2xl bg-white/5 border border-white/10">
        <h2 class="text-lg font-semibold">Informations</h2>

        <div class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between text-slate-400">
            <span>Prix</span>
            <span class="text-slate-100 font-medium"><%= (service.price ?? 0).toString().replace('.', ',') %> €</span>
          </div>

          <div class="flex items-center justify-between text-slate-400">
            <span>Catégorie</span>
            <span class="text-slate-100 font-medium"><%= service.category_name || '—' %></span>
          </div>

          <% if (service.created_at) { %>
            <div class="flex items-center justify-between text-slate-400">
              <span>Créé le</span>
              <span class="text-slate-100 font-medium"><%= service.created_at %></span>
            </div>
          <% } %>
        </div>

        <div class="mt-6 grid gap-3">
          <a href="/bookings/new?service=<%= service.slug %>"
             class="w-full text-center py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 transition font-medium shadow-lg shadow-emerald-600/20">
            Réserver maintenant
          </a>

          <a href="/services/<%= service.slug %>/edit"
             class="w-full text-center py-2.5 rounded-lg bg-slate-700 hover:bg-slate-600 transition font-medium">
            Modifier le service
          </a>
        </div>
      </aside>
    </div>

  </div>
</section>