<section class="py-10">
  <div class="max-w-2xl mx-auto px-4">

    <div class="p-8 rounded-2xl bg-white/5 backdrop-blur shadow-xl border border-white/10">
      <div class="mb-6 text-center">
        <h1 class="text-2xl font-semibold tracking-tight">Proposer un service</h1>
        <p class="text-sm text-slate-400 mt-1">Décris ton service pour que les clients puissent réserver.</p>
      </div>

      <form action="/services" method="POST" class="space-y-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Titre -->
        <div>
          <label class="block text-sm mb-1 text-slate-300">Titre</label>
          <input
            type="text"
            name="title"
            required
            placeholder="Ex: Ménage 2h (appartement)"
            class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700
                   focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
          >
        </div>

        <!-- Prix + Catégorie -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm mb-1 text-slate-300">Prix (€)</label>
            <input
              type="number"
              name="price"
              step="0.01"
              required
              placeholder="Ex: 35"
              class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700
                     focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
            >
          </div>

          <div>
            <label class="block text-sm mb-1 text-slate-300">Catégorie</label>
            <select
              name="category_id"
              required
              class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700
                     focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
            >
              <option value="" disabled selected>Choisir une catégorie</option>
              <% categories.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <!-- Description -->
        <div>
          <label class="block text-sm mb-1 text-slate-300">Description</label>
          <textarea
            name="description"
            rows="6"
            required
            placeholder="Décris ce que tu proposes, durée, matériel, zone, etc."
            class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700
                   focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
          ></textarea>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-between pt-2">
          <a href="/services" class="text-sm text-slate-400 hover:text-white transition">
            ← Retour
          </a>

          <div class="flex gap-3">
            <button type="reset" class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 transition">
              Réinitialiser
            </button>

            <button
              type="submit"
              class="px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500
                     active:bg-blue-700 transition font-medium shadow-lg shadow-blue-600/20"
            >
              Publier
            </button>
          </div>
        </div>

      </form>
    </div>

  </div>
</section>