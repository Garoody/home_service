<!--
  Formulaire d'avis client.
  Le client peut noter le prestataire avec un systeme d'etoiles
  et laisser un commentaire apres une reservation terminee.
-->
<section class="py-10">
  <div class="max-w-2xl mx-auto px-4">
    <div class="mb-6">
      <a href="/bookings" class="text-sm text-slate-400 hover:text-white transition">
        <- Retour a mes reservations
      </a>
    </div>

    <div class="rounded-2xl border border-white/10 bg-white/5 p-8 shadow-xl">
      <div class="mb-6">
        <p class="text-xs uppercase tracking-wider text-blue-300">Evaluation client</p>
        <h1 class="mt-2 text-2xl font-semibold">Laisser un avis</h1>
        <p class="mt-2 text-sm text-slate-400">
          Note le prestataire <span class="text-slate-200"><%= booking.provider_name %></span>
          pour le service <span class="text-slate-200"><%= booking.service_title %></span>.
        </p>
      </div>

      <form action="/reviews" method="POST" class="space-y-6">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="booking_id" value="<%= booking.booking_id %>">
        <input type="hidden" name="provider_id" value="<%= booking.provider_id %>">

        <div>
          <label class="block text-sm mb-3 text-slate-300">Note</label>

          <!-- Systeme de notation visuel par etoiles -->
          <div class="rating-shell">
            <div class="star-rating" role="radiogroup" aria-label="Note sur 5">
              <% for (let i = 5; i >= 1; i -= 1) { %>
                <input
                  id="rating-<%= i %>"
                  type="radio"
                  name="rating"
                  value="<%= i %>"
                  <%= i === 5 ? "checked" : "" %>
                >
                <label for="rating-<%= i %>" title="<%= i %> etoile<%= i > 1 ? "s" : "" %>">
                  <span class="sr-only"><%= i %> etoile<%= i > 1 ? "s" : "" %></span>
                  <span aria-hidden="true">&#9733;</span>
                </label>
              <% } %>
            </div>

            <p class="mt-3 text-xs text-slate-500">
              Survole puis clique sur une etoile pour choisir la note.
            </p>
          </div>
        </div>

        <div>
          <label for="comment" class="block text-sm mb-2 text-slate-300">Commentaire</label>
          <textarea
            id="comment"
            name="comment"
            rows="6"
            placeholder="Partage ton experience avec ce prestataire."
            class="w-full px-4 py-3 rounded-xl bg-slate-900/70 border border-slate-700 text-slate-100 placeholder:text-slate-500 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
          ></textarea>
        </div>

        <div class="flex items-center justify-between pt-2">
          <a href="/bookings" class="text-sm text-slate-400 hover:text-white transition">
            Annuler
          </a>

          <button
            type="submit"
            class="px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 transition font-medium shadow-lg shadow-blue-600/20"
          >
            Publier mon avis
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .rating-shell {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .star-rating {
    display: inline-flex;
    flex-direction: row-reverse;
    align-items: center;
    justify-content: flex-start;
    gap: 0.2rem;
  }

  .star-rating input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .star-rating label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    margin: 0;
    color: #334155;
    cursor: pointer;
    font-size: 2.2rem;
    line-height: 1;
    transition: color 140ms ease, transform 140ms ease, filter 140ms ease;
  }

  .star-rating label:hover,
  .star-rating label:hover ~ label {
    color: #fbbf24;
    transform: translateY(-1px);
    filter: drop-shadow(0 4px 10px rgba(251, 191, 36, 0.2));
  }

  .star-rating input:checked + label,
  .star-rating input:checked + label ~ label {
    color: #f59e0b;
  }

  .star-rating input:focus-visible + label {
    outline: 2px solid #60a5fa;
    outline-offset: 4px;
    border-radius: 0.4rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .star-rating label {
      width: 2.2rem;
      height: 2.2rem;
      font-size: 1.9rem;
    }
  }
</style>
