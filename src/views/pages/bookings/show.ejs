<%
  const isClientView = viewerMode === "client";
  const statusLabels = { pending: "En attente", confirmed: "Confirmee", completed: "Terminee", cancelled: "Annulee" };
  const statusClass = {
    pending: "border-amber-400/30 bg-amber-500/10 text-amber-200",
    confirmed: "border-blue-400/30 bg-blue-500/10 text-blue-200",
    completed: "border-emerald-400/30 bg-emerald-500/10 text-emerald-200",
    cancelled: "border-rose-400/30 bg-rose-500/10 text-rose-200",
  };
  const paymentLabels = { paid: "Paye", pending: "En attente", unpaid: "Non paye" };
  const paymentMethodLabels = {
    cb: "Carte bancaire",
    visa: "Visa",
    mastercard: "Mastercard",
    card: "Carte bancaire",
    paypal: "PayPal",
    bank_transfer: "Virement bancaire",
    cash: "Especes",
    other: "Carte bancaire",
  };
  const formatDate = (value) => {
    if (!value) return "N/A";
    const date = value instanceof Date ? value : new Date(value);
    return Number.isNaN(date.getTime()) ? String(value).slice(0, 10) : date.toLocaleDateString("fr-FR");
  };
  const bookingDateValue = formatDate(booking.booking_date);
  const bookingTimeValue = String(booking.booking_time || "").slice(0, 5) || "N/A";
  const statusLabel = statusLabels[booking.status] || booking.status;
  const statusStyle = statusClass[booking.status] || "border-white/10 bg-white/5 text-slate-200";
  const paymentStatusLabel = paymentLabels[booking.payment_status] || booking.payment_status || "Non paye";
  const paymentMethodLabel = paymentMethodLabels[booking.payment_method] || booking.payment_method || "Non renseigne";
  const canPayNow = booking.status === "confirmed" && booking.payment_status !== "paid";
  const canCancel = ["pending", "confirmed"].includes(booking.status) && booking.payment_status !== "paid";
%>

<section class="py-10">
  <div class="mx-auto max-w-5xl px-4">
    <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-blue-300">
          <%= isClientView ? "Réservation client" : "Réservation reçue" %>
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-white">Détail simple de la réservation</h1>
        <p class="mt-2 max-w-2xl text-slate-400">
          <%= isClientView
            ? "Ici, vous voyez quoi, quand, ou et quelle est la prochaine etape."
            : "Ici, vous voyez clairement la demande du client et ce que vous pouvez faire ensuite." %>
        </p>
      </div>

      <a
        href="<%= isClientView ? '/bookings' : '/users/profile/service-bookings' %>"
        class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-100 transition hover:border-white/20 hover:bg-white/10"
      >
        Retour
      </a>
    </div>

    <div class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
      <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.2em] text-blue-300">Service</p>
          <h2 class="mt-2 text-2xl font-semibold text-white"><%= booking.service_title || "Service" %></h2>
          <% if (booking.service_description) { %>
            <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-300"><%= booking.service_description %></p>
          <% } %>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold <%= statusStyle %>">
            <%= statusLabel %>
          </span>
          <span class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-slate-200">
            <%= paymentStatusLabel %>
          </span>
        </div>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
          <p class="text-xs uppercase tracking-[0.18em] text-slate-400">Quand ?</p>
          <p class="mt-2 text-base font-semibold text-slate-100"><%= bookingDateValue %></p>
          <p class="mt-1 text-sm text-slate-300">A <%= bookingTimeValue %></p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
          <p class="text-xs uppercase tracking-[0.18em] text-slate-400">Combien ?</p>
          <p class="mt-2 text-base font-semibold text-emerald-300"><%= (booking.total_price ?? 0).toString().replace(".", ",") %> EUR</p>
          <p class="mt-1 text-sm text-slate-300">Prix de la réservation</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
          <p class="text-xs uppercase tracking-[0.18em] text-slate-400"><%= isClientView ? "Qui ?" : "Client" %></p>
          <p class="mt-2 text-base font-semibold text-slate-100">
            <%= isClientView ? (booking.provider_name || "Prestataire") : (booking.client_name || [booking.first_name, booking.last_name].filter(Boolean).join(" ") || "Client") %>
          </p>
          <p class="mt-1 text-sm text-slate-300">
            <%= isClientView ? (booking.provider_email || "Email non renseigne") : (booking.client_email || "Email non renseigne") %>
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
          <p class="text-xs uppercase tracking-[0.18em] text-slate-400">Paiement</p>
          <p class="mt-2 text-base font-semibold text-slate-100"><%= paymentMethodLabel %></p>
          <p class="mt-1 text-sm text-slate-300">
            <%= booking.payment_status === "paid" ? "Paiement déjà valide" : "Paiement pas encore termine" %>
          </p>
        </div>
      </div>

      <div class="mt-4 grid gap-4 lg:grid-cols-[1.25fr_0.95fr]">
        <div class="rounded-2xl border border-white/10 bg-slate-900/30 p-5">
          <p class="text-xs uppercase tracking-[0.18em] text-blue-300">Ou ?</p>
          <p class="mt-3 text-base font-semibold text-slate-100"><%= booking.address || "Adresse non renseignee" %></p>
          <p class="mt-1 text-sm text-slate-300"><%= booking.city || "Ville non renseignee" %></p>

          <% if (!isClientView) { %>
            <div class="mt-4 rounded-2xl border border-white/10 bg-white/5 p-4">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-400">Nom sur la demande</p>
              <p class="mt-2 text-sm font-semibold text-slate-100"><%= [booking.first_name, booking.last_name].filter(Boolean).join(" ") || "Nom non renseigne" %></p>
            </div>
          <% } %>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/30 p-5">
          <p class="text-xs uppercase tracking-[0.18em] text-blue-300">Et maintenant ?</p>
          <p class="mt-3 text-sm leading-7 text-slate-200">
            <% if (booking.status === "pending") { %>
              <%= isClientView
                ? "Votre demande est partie. Vous pouvez déjà parler avec le prestataire. Le paiement attend sa confirmation."
                : "Le client attend votre réponse. Vous pouvez parler avec lui puis confirmer ou refuser." %>
            <% } else if (canPayNow) { %>
              <%= isClientView
                ? "Bonne nouvelle. Le prestataire a dit oui. Vous pouvez maintenant payer."
                : "Vous avez confirme. Le client peut maintenant payer." %>
            <% } else if (booking.payment_status === "paid") { %>
              <%= isClientView
                ? "Le paiement est valide. Le creneau est garde pour vous."
                : "Le paiement est valide. Vous etes maintenant engage sur ce creneau." %>
            <% } else if (booking.status === "cancelled") { %>
              Cette réservation est annulée.
            <% } else { %>
              La réservation suit son cours.
            <% } %>
          </p>

          <div class="mt-5 flex flex-wrap gap-2">
            <a
              href="/services/<%= booking.service_slug %>"
              class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-100 transition hover:border-white/20 hover:bg-white/10"
            >
              Voir le service
            </a>

            <% if (booking.conversation_id) { %>
              <a
                href="/conversations/<%= booking.conversation_id %>"
                class="inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-blue-500"
              >
                Ouvrir la discussion
              </a>
            <% } %>

            <% if (isClientView && canPayNow) { %>
              <a
                href="/payments/<%= booking.id %>"
                class="inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-blue-500"
              >
                Passer au paiement
              </a>
            <% } %>

            <% if (!isClientView && booking.payment_id) { %>
              <a
                href="/users/profile/service-payments/<%= booking.payment_id %>"
                class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-100 transition hover:border-white/20 hover:bg-white/10"
              >
                Voir le paiement
              </a>
            <% } %>
          </div>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        <% if (isClientView && booking.status === "pending") { %>
          <a
            href="/bookings/<%= booking.id %>/edit"
            class="inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-blue-500"
          >
            Modifier ma demande
          </a>
        <% } %>

        <% if (isClientView && canCancel) { %>
          <a
            href="/bookings/<%= booking.id %>/delete"
            data-confirm="Voulez-vous vraiment annuler cette réservation ?"
            class="inline-flex min-h-11 items-center justify-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-500"
          >
            Annuler la réservation
          </a>
        <% } %>

        <% if (isClientView && booking.payment_status === "paid" && !booking.has_review) { %>
          <a
            href="/reviews/bookings/<%= booking.id %>/new"
            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-100 transition hover:border-white/20 hover:bg-white/10"
          >
            Laisser un avis
          </a>
        <% } else if (isClientView && booking.has_review) { %>
          <a
            href="/reviews/<%= booking.review_id %>/edit"
            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-slate-100 transition hover:border-white/20 hover:bg-white/10"
          >
            Modifier mon avis
          </a>
        <% } %>

        <% if (!isClientView && booking.status === "pending") { %>
          <form action="/bookings/<%= booking.id %>/confirm" method="POST" class="inline-flex">
            <% if (csrfToken) { %>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            <input type="hidden" name="returnTo" value="/users/profile/service-bookings/detail/<%= booking.id %>">
            <button
              type="submit"
              class="inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-blue-500"
            >
              Confirmer
            </button>
          </form>

          <form action="/bookings/<%= booking.id %>/refuse" method="POST" class="inline-flex" data-confirm="Voulez-vous vraiment refuser cette réservation ?">
            <% if (csrfToken) { %>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            <input type="hidden" name="returnTo" value="/users/profile/service-bookings/detail/<%= booking.id %>">
            <button
              type="submit"
              class="inline-flex min-h-11 items-center justify-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-red-500"
            >
              Refuser
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</section>
