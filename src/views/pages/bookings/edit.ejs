<!--
  Ecran d'edition d'une reservation client.
  Cette vue existe pour offrir une vraie page de modification
  quand le client clique sur "Mettre a jour" depuis la liste.
-->
<section class="py-10">
  <div class="max-w-3xl mx-auto px-4">
    <div class="mb-6">
      <p class="text-xs uppercase tracking-[0.25em] text-blue-300">Reservation</p>
      <h1 class="mt-2 text-2xl md:text-3xl font-semibold">Modifier ma reservation</h1>
      <p class="mt-2 text-slate-400">
        Retrouvez ici votre formulaire complet pour modifier votre reservation de
        <span class="text-slate-200 font-medium"><%= booking.service_title || "Service" %></span>.
      </p>
    </div>

    <form
      action="/bookings/<%= booking.id %>/update"
      method="POST"
      class="rounded-2xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10 space-y-5"
    >
      <% if (csrfToken) { %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% } %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-slate-300 mb-2" for="last_name">Nom</label>
          <input
            id="last_name"
            name="last_name"
            type="text"
            value="<%= booking.last_name || '' %>"
            required
            class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
          >
        </div>

        <div>
          <label class="block text-sm text-slate-300 mb-2" for="first_name">Prenom</label>
          <input
            id="first_name"
            name="first_name"
            type="text"
            value="<%= booking.first_name || '' %>"
            required
            class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
          >
        </div>
      </div>

      <div>
        <label class="block text-sm text-slate-300 mb-2" for="city">Ville</label>
        <input
          id="city"
          name="city"
          type="text"
          value="<%= booking.city || '' %>"
          required
          class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
        >
      </div>

      <div>
        <label class="block text-sm text-slate-300 mb-2" for="address">Adresse</label>
        <input
          id="address"
          name="address"
          type="text"
          value="<%= booking.address || '' %>"
          required
          class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
        >
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-slate-300 mb-2" for="booking_date">Date</label>
          <input
            id="booking_date"
            name="booking_date"
            type="date"
            data-booking-date
            min="<%= bookingDateMin || '' %>"
            value="<%= booking.booking_date instanceof Date ? booking.booking_date.toISOString().slice(0, 10) : String(booking.booking_date || '').slice(0, 10) %>"
            required
            class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
          >
        </div>

        <div>
          <label class="block text-sm text-slate-300 mb-2" for="booking_time">Heure</label>
          <input
            id="booking_time"
            name="booking_time"
            type="time"
            data-booking-time
            value="<%= String(booking.booking_time || '').slice(0, 5) %>"
            required
            class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
          >
        </div>
      </div>

      <p class="text-xs text-slate-400">
        Les dates passees sont bloquees. Pour aujourd'hui, choisissez uniquement une heure future.
      </p>

      <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
        <a
          href="/bookings"
          class="inline-flex items-center rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 hover:border-white/20 transition"
        >
          Retour aux reservations
        </a>

        <button
          type="submit"
          class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 transition text-sm font-medium"
        >
          Enregistrer les modifications
        </button>
      </div>
    </form>
  </div>
</section>
