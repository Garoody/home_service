<section class="py-10">
  <div class="max-w-2xl mx-auto px-4">
    <div class="p-8 rounded-2xl bg-white/5 border border-white/10 shadow-xl">
      <% const formValues = oldInput || {}; %>
      <% const selectedPaymentMethod = formValues.payment_method || "cb"; %>
      <h1 class="text-2xl font-semibold">Nouvelle demande de réservation</h1>
      <p class="mt-2 text-sm text-slate-400">
        Renseignez votre demande. Le prestataire recevra votre date et votre heure proposees,
        puis vous paierez seulement apres sa confirmation.
      </p>

      <form action="/bookings" method="POST" class="mt-8 space-y-5">
        <% if (csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>

        <input type="hidden" name="service_id" value="<%= serviceId || '' %>">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-slate-300 mb-2" for="last_name">Nom</label>
            <input
              id="last_name"
              name="last_name"
              type="text"
              required
              value="<%= formValues.last_name || '' %>"
              class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            >
          </div>

          <div>
            <label class="block text-sm text-slate-300 mb-2" for="first_name">Prenom</label>
            <input
              id="first_name"
              name="first_name"
              type="text"
              required
              value="<%= formValues.first_name || '' %>"
              class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            >
          </div>
        </div>

        <div>
          <label class="block text-sm text-slate-300 mb-2" for="city">Ville</label>
          <input
            id="city"
            name="city"
            type="text"
            required
            value="<%= formValues.city || '' %>"
            class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
          >
        </div>

        <div>
          <label class="block text-sm text-slate-300 mb-2" for="address">Adresse</label>
          <input
            id="address"
            name="address"
            type="text"
            required
            value="<%= formValues.address || '' %>"
            class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
          >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-slate-300 mb-2" for="booking_date">Date</label>
            <input
              id="booking_date"
              name="booking_date"
              type="date"
              data-booking-date
              min="<%= bookingDateMin || '' %>"
              required
              value="<%= formValues.booking_date || '' %>"
              class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            >
          </div>

          <div>
            <label class="block text-sm text-slate-300 mb-2" for="booking_time">Heure</label>
            <input
              id="booking_time"
              name="booking_time"
              type="time"
              data-booking-time
              required
              value="<%= formValues.booking_time || '' %>"
              class="w-full px-4 py-2.5 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            >
          </div>
        </div>
        <p class="text-xs text-slate-400">
          Les dates passées sont bloquées. Pour aujourd'hui, choisissez uniquement une heure future.
        </p>

        <section class="booking-payment-box" data-booking-payment-form>
          <div class="booking-payment-box__head">
            <div class="booking-payment-box__intro">
              <p class="booking-payment-box__eyebrow">Mode de paiement</p>
              <div class="booking-payment-box__title-row">
                <h2 class="booking-payment-box__title">Choisissez votre mode de paiement prefere</h2>
                <span class="booking-payment-box__pill">Sans debit immediat</span>
              </div>
            </div>
            <p class="booking-payment-box__copy">
              Cette etape prepare simplement votre preference. Le vrai paiement restera disponible
              seulement apres confirmation du prestataire.
            </p>
          </div>

          <div class="booking-payment-choice-list">
            <label class="payment-choice">
              <input
                type="radio"
                name="payment_method"
                value="cb"
                <%= selectedPaymentMethod === "cb" ? "checked" : "" %>
              >
              <span class="payment-choice__radio"></span>
              <span class="payment-choice__content">
                <span class="payment-choice__title">Carte bancaire</span>
                <span class="payment-choice__copy">Un formulaire simple et classique pour preparer votre reglement.</span>
              </span>
            </label>

            <label class="payment-choice">
              <input
                type="radio"
                name="payment_method"
                value="paypal"
                <%= selectedPaymentMethod === "paypal" ? "checked" : "" %>
              >
              <span class="payment-choice__radio"></span>
              <span class="payment-choice__content">
                <span class="payment-choice__title">PayPal</span>
                <span class="payment-choice__copy">Pratique si vous souhaitez retrouver votre compte PayPal ensuite.</span>
              </span>
            </label>

            <label class="payment-choice">
              <input
                type="radio"
                name="payment_method"
                value="bank_transfer"
                <%= selectedPaymentMethod === "bank_transfer" ? "checked" : "" %>
              >
              <span class="payment-choice__radio"></span>
              <span class="payment-choice__content">
                <span class="payment-choice__title">Virement bancaire</span>
                <span class="payment-choice__copy">Indiquez un compte de virement pour garder un parcours clair et professionnel.</span>
              </span>
            </label>

            <label class="payment-choice">
              <input
                type="radio"
                name="payment_method"
                value="cash"
                <%= selectedPaymentMethod === "cash" ? "checked" : "" %>
              >
              <span class="payment-choice__radio"></span>
              <span class="payment-choice__content">
                <span class="payment-choice__title">Paiement en especes</span>
                <span class="payment-choice__copy">Le reglement sera effectué directement avec le prestataire au bon moment.</span>
              </span>
            </label>
          </div>

          <div
            class="booking-payment-panel"
            data-payment-panel="cb"
            style="<%= selectedPaymentMethod === 'cb' ? 'display:block' : 'display:none' %>"
          >
            <div class="booking-payment-panel__note">
              Vous ne payez pas encore. Vous renseignez simplement la preference que vous souhaitez utiliser si la réservation est confirmée.
            </div>

            <div class="booking-payment-summary-strip">
              <span>Preference enregistree pour cette demande</span>
              <strong>Paiement debloque seulement apres confirmation</strong>
            </div>

            <div class="booking-payment-grid">
              <label class="booking-payment-field">
                <span class="booking-payment-field__label">Titulaire de la carte</span>
                <input
                  type="text"
                  name="cardholder_name"
                  id="cardholder_name"
                  value="<%= formValues.cardholder_name || '' %>"
                  placeholder="Nom complet du titulaire"
                  class="booking-payment-input"
                >
              </label>

              <label class="booking-payment-field booking-payment-field--wide">
                <span class="booking-payment-field__label">Numero de carte</span>
                <input
                  type="text"
                  name="card_number"
                  id="card_number"
                  value="<%= formValues.card_number || '' %>"
                  placeholder="Numero de carte"
                  inputmode="numeric"
                  maxlength="23"
                  class="booking-payment-input"
                >
              </label>

              <label class="booking-payment-field">
                <span class="booking-payment-field__label">Date d'expiration</span>
                <input
                  type="text"
                  id="expiry"
                  value="<%= formValues.expiry || '' %>"
                  placeholder="MM / AA"
                  inputmode="numeric"
                  maxlength="5"
                  class="booking-payment-input"
                >
              </label>

              <label class="booking-payment-field">
                <span class="booking-payment-field__label">Cryptogramme</span>
                <input
                  type="text"
                  name="cvc"
                  id="cvc"
                  placeholder="CVC"
                  inputmode="numeric"
                  maxlength="4"
                  class="booking-payment-input"
                >
              </label>
            </div>
          </div>

          <div
            class="booking-payment-panel"
            data-payment-panel="paypal"
            style="<%= selectedPaymentMethod === 'paypal' ? 'display:block' : 'display:none' %>"
          >
            <div class="booking-payment-panel__note">
              Ce compte servira seulement de preference. Vous confirmerez le vrai reglement PayPal apres acceptation du creneau.
            </div>

            <div class="booking-payment-summary-strip">
              <span>Compte PayPal memorise pour votre réservation</span>
              <strong>Validation du paiement plus tard dans votre espace</strong>
            </div>

            <div class="booking-payment-grid">
              <label class="booking-payment-field">
                <span class="booking-payment-field__label">Nom du titulaire PayPal</span>
                <input
                  type="text"
                  name="paypal_full_name"
                  value="<%= formValues.paypal_full_name || '' %>"
                  placeholder="Nom complet"
                  class="booking-payment-input"
                >
              </label>

              <label class="booking-payment-field">
                <span class="booking-payment-field__label">Adresse PayPal</span>
                <input
                  type="text"
                  name="paypal_email"
                  value="<%= formValues.paypal_email || '' %>"
                  placeholder="nom@paypal.com"
                  class="booking-payment-input"
                >
              </label>

              <label class="booking-payment-field booking-payment-field--wide">
                <span class="booking-payment-field__label">Reference</span>
                <input
                  type="text"
                  name="paypal_reference"
                  value="<%= formValues.paypal_reference || '' %>"
                  placeholder="Reference ou note utile"
                  class="booking-payment-input"
                >
              </label>
            </div>
          </div>

          <div
            class="booking-payment-panel"
            data-payment-panel="bank_transfer"
            style="<%= selectedPaymentMethod === 'bank_transfer' ? 'display:block' : 'display:none' %>"
          >
            <div class="booking-payment-panel__note">
              Preparez ici le mode virement. Le paiement reel ne sera active qu'apres validation du prestataire.
            </div>

            <div class="booking-payment-summary-strip">
              <span>Coordonnées bancaires associees a votre demande</span>
              <strong>Le virement sera confirme seulement apres accord du prestataire</strong>
            </div>

            <div class="booking-payment-grid">
              <label class="booking-payment-field">
                <span class="booking-payment-field__label">Titulaire du compte</span>
                <input
                  type="text"
                  name="bank_account_name"
                  value="<%= formValues.bank_account_name || '' %>"
                  placeholder="Nom du titulaire"
                  class="booking-payment-input"
                >
              </label>

              <label class="booking-payment-field">
                <span class="booking-payment-field__label">Banque</span>
                <input
                  type="text"
                  name="bank_name"
                  value="<%= formValues.bank_name || '' %>"
                  placeholder="Nom de la banque"
                  class="booking-payment-input"
                >
              </label>

              <label class="booking-payment-field booking-payment-field--wide">
                <span class="booking-payment-field__label">IBAN</span>
                <input
                  type="text"
                  name="iban"
                  id="iban"
                  value="<%= formValues.iban || '' %>"
                  placeholder="FR76 3000 6000 0112 3456 7890 189"
                  class="booking-payment-input"
                >
              </label>

              <label class="booking-payment-field">
                <span class="booking-payment-field__label">BIC / SWIFT</span>
                <input
                  type="text"
                  name="bic"
                  id="bic"
                  value="<%= formValues.bic || '' %>"
                  placeholder="AGRIFRPP"
                  class="booking-payment-input"
                >
              </label>

              <label class="booking-payment-field">
                <span class="booking-payment-field__label">Reference</span>
                <input
                  type="text"
                  name="transfer_reference"
                  value="<%= formValues.transfer_reference || '' %>"
                  placeholder="Reference ou motif"
                  class="booking-payment-input"
                >
              </label>
            </div>
          </div>

          <div
            class="booking-payment-panel"
            data-payment-panel="cash"
            style="<%= selectedPaymentMethod === 'cash' ? 'display:block' : 'display:none' %>"
          >
            <div class="booking-payment-panel__note">
              Vous indiquez simplement ici que vous preferez regler en especes plus tard, directement avec le prestataire.
            </div>

            <div class="booking-payment-summary-strip">
              <span>Paiement en especes choisi comme preference</span>
              <strong>Le reglement se fera apres validation du creneau</strong>
            </div>
          </div>
        </section>

        <div class="rounded-2xl border border-blue-500/20 bg-blue-500/10 p-5">
          <h2 class="text-sm font-semibold text-blue-100">Ce qui se passe ensuite</h2>
          <ol class="mt-3 space-y-2 text-sm text-slate-200">
            <li>1. Le prestataire recoit votre demande avec le creneau propose.</li>
            <li>2. Le chat est disponible tout de suite pour échanger.</li>
            <li>3. Le prestataire confirme ou refuse la réservation.</li>
            <li>4. S'il confirme, vous pourrez regler le service.</li>
          </ol>
        </div>

        <div class="flex flex-wrap gap-3 pt-2">
          <button
            type="submit"
            id="booking-submit-button"
            class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 transition font-medium"
          >
            Envoyer la demande
          </button>
          <a
            href="/bookings"
            class="px-5 py-2.5 rounded-lg bg-white/5 border border-white/10 hover:border-white/20 transition"
          >
            Retour
          </a>
        </div>
      </form>
    </div>
  </div>
</section>
