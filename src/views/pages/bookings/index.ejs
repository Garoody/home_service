<section class="py-10">
  <div class="max-w-6xl mx-auto px-4">
    <div class="rounded-2xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 class="text-2xl md:text-3xl font-semibold">Mes réservations</h1>
          <p class="mt-2 text-sm text-slate-400">
            Retrouvez ici vos demandes, vos paiements en attente et l'acces rapide a vos échanges avec les prestataires.
          </p>
        </div>

        <div class="shrink-0">
          <a
            href="/services"
            class="inline-flex min-h-11 items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-blue-500"
          >
            Reserver un service
          </a>
        </div>
      </div>
    </div>

    <% if (!bookings || bookings.length === 0) { %>
      <div class="mt-8 p-6 rounded-2xl bg-white/5 border border-white/10 text-slate-300">
        Aucune réservation pour le moment.
      </div>
    <% } else { %>
      <div class="mt-8 grid grid-cols-1 xl:grid-cols-2 gap-6">
        <% bookings.forEach((booking) => { %>
          <% const statusLabels = { pending: "En attente", confirmed: "Confirmee", completed: "Terminee", cancelled: "Annulee" }; %>
          <% const statusClass = { pending: "bg-rose-500/70", confirmed: "bg-blue-500/15 text-blue-300 border-blue-400/20", completed: "bg-emerald-500/15 text-emerald-300 border-emerald-400/20", cancelled: "bg-rose-500/15 text-rose-300 border-rose-400/20" }; %>
          <% const statusLabel = statusLabels[booking.status] || booking.status; %>
          <% const statusStyle = statusClass[booking.status] || "bg-white/10 text-slate-200 border-white/20"; %>
          <% const bookingDateValue = booking.booking_date instanceof Date ? booking.booking_date.toISOString().slice(0, 10) : String(booking.booking_date || "").slice(0, 10); %>
          <% const bookingTimeValue = String(booking.booking_time || "").slice(0, 5); %>
          <% const canPayNow = booking.status === "confirmed" && booking.payment_status !== "paid"; %>
          <% const hasConversation = Boolean(booking.conversation_id); %>

          <% const bookingCardLink = `/bookings/${booking.id}`; %>
          <article
            class="service-card--interactive rounded-2xl border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10"
            tabindex="0"
            data-card-link="<%= bookingCardLink %>"
          >
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="text-lg font-semibold text-white">
                  <%= booking.service_title || "Service" %>
                </h2>
                <p class="mt-1 text-sm text-slate-400">Réservation</p>
              </div>
              <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium <%= statusStyle %>">
                <%= statusLabel %>
              </span>
            </div>

            <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
              <div class="rounded-lg border border-white/10 bg-slate-900/40 px-3 py-2">
                <p class="text-slate-400 text-xs">Prix</p>
                <p class="mt-1 font-medium text-emerald-300">
                  <%= (booking.total_price ?? 0).toString().replace(".", ",") %> EUR
                </p>
              </div>

              <div class="rounded-lg border border-white/10 bg-slate-900/40 px-3 py-2">
                <p class="text-slate-400 text-xs">Creneau demande</p>
                <p class="mt-1 font-medium text-slate-100">
                  <%= bookingDateValue || "N/A" %> a <%= bookingTimeValue || "N/A" %>
                </p>
              </div>
            </div>

            <div class="mt-3 rounded-lg border border-white/10 bg-slate-900/30 px-3 py-2 text-sm">
              <p class="text-slate-400 text-xs">Coordonnées transmises</p>
              <p class="mt-1 text-slate-200">
                <%= [booking.first_name, booking.last_name].filter(Boolean).join(" ") || "N/A" %>
              </p>
              <p class="text-slate-300">
                <%= booking.address || "N/A" %>, <%= booking.city || "N/A" %>
              </p>
            </div>

            <div class="mt-3 rounded-lg border border-white/10 bg-slate-900/30 px-3 py-3 text-sm text-slate-300">
              <% if (booking.status === "pending") { %>
                Votre demande a bien été envoyée. Vous pouvez déjà discuter avec le prestataire, mais le paiement reste bloqué tant qu'il n'a pas confirme.
              <% } else if (canPayNow) { %>
                Votre réservation est confirmée. Vous pouvez maintenant passer au paiement.
              <% } else if (booking.payment_status === "paid") { %>
                Votre paiement est valide. Le creneau est maintenant bloqué et la discussion reste disponible.
              <% } else if (booking.status === "cancelled") { %>
                Cette réservation a été annulée.
              <% } else { %>
                Cette réservation suit son cours. Vous retrouverez ici les prochaines actions disponibles.
              <% } %>
            </div>

            <% if (booking.canManage) { %>
              <div class="mt-6 pt-1 flex flex-wrap items-center gap-2">
                <a
                  href="/services/<%= booking.service_slug %>"
                  class="inline-block px-4 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-white/20 transition text-sm font-medium"
                >
                  Voir le service
                </a>

                <a
                  href="/bookings/<%= booking.id %>"
                  class="inline-block px-4 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-white/20 transition text-sm font-medium"
                >
                  Voir le détail
                </a>

                <% if (booking.status === "pending") { %>
                  <a
                    href="/bookings/<%= booking.id %>/edit"
                    class="inline-block px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 transition text-sm font-medium"
                  >
                    Modifier ma demande
                  </a>
                <% } %>

                <% if (canPayNow) { %>
                  <a
                    href="/payments/<%= booking.id %>"
                    class="inline-block px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 transition text-sm font-medium"
                  >
                    Payer maintenant
                  </a>
                <% } %>

                <% if (hasConversation) { %>
                  <a
                    href="/conversations/<%= booking.conversation_id %>"
                    class="inline-block px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 transition text-sm font-medium"
                  >
                    Contacter le prestataire
                  </a>
                <% } %>
              </div>

              <div class="mt-3 flex flex-wrap items-center gap-2">
                <% if (["pending", "confirmed"].includes(booking.status) && booking.payment_status !== "paid") { %>
                  <a
                    href="/bookings/<%= booking.id %>/delete"
                    data-confirm="Voulez-vous vraiment annuler cette réservation ?"
                    class="inline-block px-4 py-2 rounded-lg bg-red-600/90 hover:bg-red-600 transition text-sm font-medium"
                  >
                    Annuler la réservation
                  </a>
                <% } else { %>
                  <span class="inline-flex items-center px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-sm text-slate-400">
                    Réservation non annulable depuis cet ecran
                  </span>
                <% } %>

                <% if (booking.payment_status === "paid" && !booking.has_review) { %>
                  <a
                    href="/reviews/bookings/<%= booking.id %>/new"
                    class="inline-block px-4 py-2 rounded-lg bg-amber-500/90 hover:bg-amber-400 text-slate-950 transition text-sm font-medium"
                  >
                    Laisser un avis
                  </a>
                <% } else if (booking.has_review) { %>
                  <a
                    href="/reviews/<%= booking.review_id %>/edit"
                    class="inline-block px-4 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-white/20 transition text-sm text-slate-200"
                  >
                    Modifier mon avis
                  </a>
                <% } else { %>
                  <span class="inline-flex items-center px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-sm text-slate-400">
                    Avis disponible apres paiement valide
                  </span>
                <% } %>

                <% if (booking.status === "pending") { %>
                  <span class="inline-flex items-center px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-sm text-slate-400">
                    Chat disponible maintenant. Paiement indisponible tant que le prestataire n'a pas confirme
                  </span>
                <% } else if (canPayNow) { %>
                  <span class="inline-flex items-center px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-sm text-slate-400">
                    Paiement disponible maintenant. Le creneau sera verrouille des la validation du paiement
                  </span>
                <% } %>
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
