<section class="py-10">
  <div class="mx-auto max-w-6xl px-4">
    <% const isArchivedScope = conversationScope === "archived"; %>

    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-blue-300">Mon espace</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight">Mes conversations</h1>
        <p class="mt-2 max-w-2xl text-slate-400">
          Retrouvez les discussions liees a vos reservations et repondez a vos messages directement ici.
        </p>
      </div>
      <a href="/users/profile" class="text-sm text-blue-300 transition hover:text-blue-200">
        Retour au profil
      </a>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/conversations"
        class="<%= !isArchivedScope ? 'border-blue-600 bg-blue-600 text-white' : 'border-white/10 bg-white/5' %> rounded-full border px-4 py-2 text-sm transition hover:border-white/20"
      >
        Conversations actives
      </a>
      <a
        href="/conversations?scope=archived"
        class="<%= isArchivedScope ? 'border-blue-600 bg-blue-600 text-white' : 'border-white/10 bg-white/5' %> rounded-full border px-4 py-2 text-sm transition hover:border-white/20"
      >
        Archivees
      </a>
    </div>

    <div class="mt-8 space-y-4">
      <% if (!conversations.length) { %>
        <div class="rounded-2xl border border-white/10 bg-white/5 px-5 py-6 text-slate-400">
          <%= isArchivedScope ? "Aucune conversation archivee." : "Aucune conversation disponible pour le moment." %>
        </div>
      <% } else { %>
        <% conversations.forEach((conversation) => { %>
          <% const bookingDateLabel = conversation.booking_date ? new Date(conversation.booking_date).toLocaleDateString("fr-FR") : ""; %>
          <% const lastMessageDate = conversation.last_message_at ? new Date(conversation.last_message_at).toLocaleString("fr-FR") : ""; %>
          <a
            href="/conversations/<%= conversation.id %>"
            class="block rounded-2xl border border-white/10 bg-white/5 px-5 py-5 transition hover:border-white/20"
          >
            <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="conversation-list-pill conversation-list-pill--service">
                    <%= conversation.service_title %>
                  </span>
                  <% if (conversation.has_unread) { %>
                    <span class="conversation-list-pill conversation-list-pill--unread">
                      <%= conversation.unread_count %> nouveau<%= conversation.unread_count > 1 ? "x" : "" %> message<%= conversation.unread_count > 1 ? "s" : "" %>
                    </span>
                  <% } %>
                  <% if (conversation.is_blocked) { %>
                    <span class="conversation-list-pill conversation-list-pill--blocked">
                      Conversation bloquee
                    </span>
                  <% } %>
                </div>

                <h2 class="mt-4 text-lg font-semibold text-white">
                  Discussion avec <%= conversation.counterpart_name %>
                </h2>

                <p class="mt-2 text-sm text-slate-400">
                  Reservation du <span class="text-slate-200"><%= bookingDateLabel || "Date a definir" %></span>
                  <% if (conversation.booking_time) { %>
                    a <span class="text-slate-200"><%= String(conversation.booking_time).slice(0, 5) %></span>
                  <% } %>
                </p>

                <p class="mt-3 line-clamp-2 text-sm text-slate-300">
                  <%= conversation.last_message || "La discussion est ouverte. Vous pouvez maintenant organiser le rendez-vous ici." %>
                </p>
              </div>

              <div class="min-w-[12rem] text-left lg:text-right">
                <p class="text-xs uppercase tracking-wide text-slate-500">
                  <%= lastMessageDate ? "Dernier message" : "Discussion ouverte" %>
                </p>
                <p class="mt-1 text-sm text-slate-200">
                  <%= lastMessageDate || "Disponible maintenant" %>
                </p>
                <% if (conversation.unread_count > 0) { %>
                  <p class="mt-3 text-sm font-semibold text-blue-300">
                    <%= conversation.unread_count %> message<%= conversation.unread_count > 1 ? "s" : "" %> non lu<%= conversation.unread_count > 1 ? "s" : "" %>
                  </p>
                <% } %>
              </div>
            </div>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>
</section>
