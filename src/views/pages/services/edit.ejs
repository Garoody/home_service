<div class="min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 py-10">
  <div class="w-full max-w-2xl p-8 rounded-2xl bg-white/5 backdrop-blur shadow-xl border border-white/10">
    <h2 class="text-xl font-semibold mb-6 text-center">Modifier le service</h2>

    <form action="/services/<%= service.slug %>/update" method="POST" enctype="multipart/form-data" class="space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="block text-sm mb-1 text-slate-300">Catégorie</label>
        <select
          name="category_id"
          required
          class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
        >
          <% (categories || []).forEach((c) => { %>
            <option value="<%= c.id %>" <%= String(c.id) === String(service.category_id) ? "selected" : "" %>>
              <%= c.name %>
            </option>
          <% }) %>
          <option value="other">Autres services</option>
        </select>
        <p class="mt-2 text-xs text-slate-400">
          Si la bonne catégorie n'existe pas, choisis <strong>Autres services</strong>
          puis précise-la ci-dessous.
        </p>
        <div class="mt-3 rounded-xl border border-dashed border-slate-700/80 bg-slate-900/40 p-4">
          <label class="block text-sm mb-1 text-slate-300">Autres services</label>
          <input
            type="text"
            name="custom_category_name"
            placeholder="Ex: Montage de meubles, aide au demenagement..."
            class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
          >
        </div>
      </div>

      <div>
        <label class="block text-sm mb-1 text-slate-300">Titre</label>
        <input
          type="text"
          name="title"
          value="<%= service.title %>"
          required
          class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
        >
      </div>

      <div>
        <label class="block text-sm mb-1 text-slate-300">Description</label>
        <textarea
          name="description"
          rows="5"
          required
          class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
        ><%= service.description %></textarea>
      </div>

      <div>
        <label class="block text-sm mb-1 text-slate-300">Prix (EUR)</label>
        <input
          type="number"
          step="0.01"
          min="0"
          name="price"
          value="<%= service.price %>"
          required
          class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
        >
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm mb-1 text-slate-300">Statut du prestataire</label>
          <select
            name="provider_status"
            required
            class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
          >
            <option value="" disabled <%= !service.provider_status ? "selected" : "" %>>Choisir un statut</option>
            <% (providerStatusOptions || []).forEach((option) => { %>
              <option
                value="<%= option.value %>"
                <%= option.value === service.provider_status ? "selected" : "" %>
              >
                <%= option.label %>
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-sm mb-1 text-slate-300">Année d'expérience</label>
          <input
            type="number"
            min="0"
            max="60"
            name="experience_years"
            value="<%= service.experience_years ?? '' %>"
            required
            class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
          >
        </div>

      </div>

      <div>
        <label class="block text-sm mb-1 text-slate-300">Zone d'intervention</label>
        <input
          type="text"
          name="service_area"
          value="<%= service.service_area || '' %>"
          required
          class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
        >
      </div>

      <div>
        <label class="block text-sm mb-1 text-slate-300">Formations suivies</label>
        <textarea
          name="trainings"
          rows="3"
          class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
        ><%= service.trainings || '' %></textarea>
      </div>

      <% if (service.photos?.length) { %>
        <div>
          <div class="flex items-center justify-between gap-3">
            <label class="block text-sm text-slate-300">Photos déjà publiees</label>
            <span class="text-xs text-slate-500"><%= service.photos.length %>/6</span>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-3">
            <% service.photos.forEach((photo, index) => { %>
              <button
                type="button"
                class="image-preview-trigger overflow-hidden rounded-xl border border-white/10 bg-slate-900/40"
                data-image-preview
                data-image-src="<%= photo.image_path %>"
                data-image-alt="Photo de realisation <%= index + 1 %> pour <%= service.title %>"
              >
                <img
                  src="<%= photo.image_path %>"
                  alt="Photo de realisation <%= index + 1 %>"
                  class="h-32 w-full object-cover"
                >
              </button>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="rounded-xl border border-dashed border-slate-700/80 bg-slate-900/40 p-4">
        <label class="block text-sm mb-1 text-slate-300">Ajouter des photos de réalisations</label>
        <p class="text-xs text-slate-400">
          Optionnel. Tu peux garder ton service tel quel ou ajouter d'autres photos, dans la limite de 6 au total.
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-file-trigger="service_photos"
            class="inline-flex min-h-10 items-center justify-center rounded-lg border border-slate-600 bg-slate-800 px-4 py-2 text-sm font-medium text-slate-100 transition hover:border-slate-500 hover:bg-slate-700"
          >
            Ajouter des photos
          </button>
          <span class="text-xs text-slate-400" data-file-status="service_photos" aria-live="polite"></span>
        </div>
        <input
          id="service_photos"
          name="service_photos"
          type="file"
          accept="image/png,image/jpeg,image/webp,image/gif"
          multiple
          class="hidden"
        >
      </div>

      <label class="inline-flex items-center gap-3 text-sm text-slate-300">
        <input
          type="checkbox"
          name="has_driving_license"
          <%= service.has_driving_license ? "checked" : "" %>
        >
        <span>Permis de conduire</span>
      </label>

      <div class="flex items-center justify-between pt-2">
        <a href="/services/<%= service.slug %>" class="text-sm text-slate-400 hover:text-white transition">
          <- Retour
        </a>

        <button
          type="submit"
          class="px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 active:bg-blue-700 transition font-medium shadow-lg shadow-blue-600/20"
        >
          Mettre a jour
        </button>
      </div>
    </form>
  </div>
</div>
