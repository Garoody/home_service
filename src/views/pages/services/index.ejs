<% const isAdmin = currentUser?.role === "admin"; %>

<section class="page-shell page-shell--compact">
  <%
    const buildServiceQuery = (nextCategoryId = "") => {
      const params = new URLSearchParams();
      if (q) params.set("q", q);
      if (city) params.set("city", city);
      if (nextCategoryId) params.set("category_id", nextCategoryId);
      const queryString = params.toString();
      return queryString ? `/services?${queryString}` : "/services";
    };
    const totalServicesInDirectory = (categories || []).reduce(
      (sum, category) => sum + Number(category.total_services || 0),
      0
    );
  %>

  <div class="section-head section-head--stack">
    <div>
      <p class="section-kicker">Catalogue</p>
      <h1>Services</h1>
      <p class="section-copy">
        Decouvre les services disponibles sur HomeService et affine rapidement ta recherche.
      </p>
    </div>

    <% if (currentUser && !isAdmin) { %>
      <a href="/services/new" class="btn-primary">+ Nouveau service</a>
    <% } %>
  </div>

  <div class="surface-card service-categories-panel">
    <div class="service-categories-panel__copy">
      <p class="section-kicker">Catégories</p>
      <h2>Retrouve rapidement un service par catégorie</h2>
      <p>
        Chaque service publie est ajoute automatiquement dans sa catégorie pour faciliter la recherche.
      </p>
    </div>

    <div class="service-category-grid">
      <a
        href="<%= buildServiceQuery() %>"
        class="service-category-card <%= !category_id ? 'service-category-card--active' : '' %>"
      >
        <span class="service-category-card__title">Toutes les catégories</span>
        <span class="service-category-card__meta"><%= totalServicesInDirectory %> service<%= totalServicesInDirectory > 1 ? 's' : '' %> dans le catalogue</span>
      </a>

      <% (categories || []).forEach((category) => { %>
        <a
          href="<%= buildServiceQuery(category.id) %>"
          class="service-category-card <%= String(category_id) === String(category.id) ? 'service-category-card--active' : '' %>"
        >
          <span class="service-category-card__title"><%= category.name %></span>
          <span class="service-category-card__meta"><%= category.total_services || 0 %> service<%= Number(category.total_services || 0) > 1 ? 's' : '' %></span>
        </a>
      <% }) %>
    </div>
  </div>

  <form method="GET" action="/services" class="surface-card service-filters">
    <input
      type="text"
      name="q"
      value="<%= q %>"
      placeholder="Rechercher (ex: menage, plomberie...)"
      class="service-field"
    >

    <input
      type="text"
      name="city"
      value="<%= city || '' %>"
      placeholder="Ville (ex: Paris)"
      class="service-field"
    >

    <select
      name="category_id"
      class="service-field"
    >
      <option value="">Toutes les catégories</option>
      <% if (categories && categories.length) { %>
        <% categories.forEach((c) => { %>
          <option value="<%= c.id %>" <%= String(category_id) === String(c.id) ? "selected" : "" %>>
            <%= c.name %>
          </option>
        <% }) %>
      <% } %>
    </select>

    <button class="btn-primary" type="submit">
      Filtrer
    </button>
  </form>

  <%
    const activeCategory = categories?.find((c) => String(c.id) === String(category_id));
    const hasActiveCity = Boolean(city && String(city).trim());
    const hasActiveFilters = Boolean(activeCategory || hasActiveCity);
  %>
  <% if (hasActiveFilters) { %>
    <div class="filter-banner">
      <span>
        Filtres actifs :
        <% if (activeCategory) { %>
          <strong>Catégorie : <%= activeCategory.name %></strong>
        <% } %>
        <% if (activeCategory && hasActiveCity) { %>
          <span> | </span>
        <% } %>
        <% if (hasActiveCity) { %>
          <strong>Ville : <%= city %></strong>
        <% } %>
      </span>
      <a href="/services" class="text-link">Réinitialiser le filtre</a>
    </div>
  <% } %>

  <div class="service-grid">
    <% if (!services || services.length === 0) { %>
      <div class="empty-state">
        <p>Aucun service trouve.</p>
        <% if (currentUser && !isAdmin) { %>
          <a href="/services/new" class="text-link">Créer le premier service</a>
        <% } %>
      </div>
    <% } else { %>
      <% services.forEach((s) => { %>
        <% const isOwnService = currentUser && String(currentUser.id) === String(s.provider_id); %>
        <article
          class="service-card service-card--interactive"
          data-card-link="/services/<%= s.slug %>"
          tabindex="0"
          role="link"
          aria-label="Voir le service <%= s.title %>"
        >
          <div class="service-card__top">
            <div class="service-card__top-tags">
              <span class="tag tag--category"><%= s.category_name || "Service" %></span>
              <% if (s.viewer_state) { %>
                <span class="tag tag--booking-state tag--booking-state-<%= s.viewer_state.tone %>"><%= s.viewer_state.label %></span>
              <% } %>
            </div>
            <span class="tag tag--price"><%= (s.price ?? 0).toString().replace(".", ",") %> EUR</span>
          </div>

          <h3>
            <a href="/services/<%= s.slug %>" class="text-link">
              <%= s.title %>
            </a>
          </h3>

          <p class="service-card__copy line-clamp-3">
            <%= s.description %>
          </p>

          <% if (s.viewer_state) { %>
            <p class="service-card__state">
              <strong>Votre statut :</strong> <%= s.viewer_state.helper %>
            </p>
          <% } %>

          <div class="service-card__actions">
            <span class="service-card__meta">
              <% if (isOwnService) { %>
                Publie par <span>moi</span>
              <% } else if (s.provider_name) { %>
                Par <span><%= s.provider_name %></span>
              <% } else { %>
                Prestataire
              <% } %>
            </span>

            <div class="service-card__action-list">
              <% if (!isAdmin && !isOwnService) { %>
                <% if (s.viewer_state) { %>
                  <a href="<%= s.viewer_state.actionHref %>" class="btn-quiet">
                    <%= s.viewer_state.actionLabel %>
                  </a>
                <% } else { %>
                  <a href="/bookings/new?service=<%= s.slug %>" class="btn-quiet">
                    Reserver
                  </a>
                <% } %>
              <% } else if (isOwnService) { %>
                <span class="service-card__meta">Votre service</span>
              <% } %>
              <a href="/services/<%= s.slug %>" class="text-link">
                Voir
              </a>
              <% if (currentUser && String(currentUser.id) === String(s.provider_id)) { %>
                <a href="/services/<%= s.slug %>/edit" class="text-link text-link--muted">
                  Modifier
                </a>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    <% } %>
  </div>
</section>
