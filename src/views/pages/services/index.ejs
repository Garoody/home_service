<section class="py-8">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between mb-8">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight">Services</h1>
      <p class="text-slate-400 mt-2">
        Decouvre les services disponibles sur HomeService.
      </p>
    </div>

    <% if (currentUser && (currentUser.role === "provider" || currentUser.role === "admin")) { %>
      <a
        href="/services/new"
        class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 transition font-medium shadow-lg shadow-blue-600/20"
      >
        + Nouveau service
      </a>
    <% } %>
  </div>

  <form method="GET" action="/services" class="grid grid-cols-1 md:grid-cols-3 gap-3">
    <input
      type="text"
      name="q"
      value="<%= q %>"
      placeholder="Rechercher (ex: menage, plomberie...)"
      class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-100 placeholder:text-slate-500 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
    >

    <select
      name="category_id"
      class="px-4 py-2 rounded-lg bg-white/5 border border-white/10 text-slate-100 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
    >
      <option value="">Toutes les categories</option>
      <% if (categories && categories.length) { %>
        <% categories.forEach((c) => { %>
          <option value="<%= c.id %>" <%= String(category_id) === String(c.id) ? "selected" : "" %>>
            <%= c.name %>
          </option>
        <% }) %>
      <% } %>
    </select>

    <button class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 transition font-medium">
      Filtrer
    </button>
  </form>

  <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (!services || services.length === 0) { %>
      <div class="col-span-full p-10 rounded-2xl bg-white/5 border border-white/10 text-center">
        <p class="text-slate-300">Aucun service trouve.</p>
        <% if (currentUser && (currentUser.role === "provider" || currentUser.role === "admin")) { %>
          <a href="/services/new" class="inline-block mt-4 text-blue-400 hover:underline">
            Creer le premier service
          </a>
        <% } %>
      </div>
    <% } else { %>
      <% services.forEach((s) => { %>
        <div class="group p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-white/20 transition shadow-xl shadow-black/20">
          <div class="flex items-center justify-between gap-3">
            <span class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1 rounded-full bg-blue-500/10 text-blue-300 border border-blue-500/20">
              <span class="h-1.5 w-1.5 rounded-full bg-blue-400"></span>
              <%= s.category_name || "Service" %>
            </span>

            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">
              <%= (s.price ?? 0).toString().replace(".", ",") %> EUR
            </span>
          </div>

          <h3 class="mt-4 text-lg font-semibold">
            <a href="/services/<%= s.slug %>" class="hover:text-white hover:underline transition">
              <%= s.title %>
            </a>
          </h3>

          <p class="mt-2 text-sm text-slate-400 line-clamp-3">
            <%= s.description %>
          </p>

          <div class="mt-5 flex items-center justify-between gap-3 text-xs text-slate-500">
            <span>
              <% if (s.provider_name) { %>
                Par <span class="text-slate-300"><%= s.provider_name %></span>
              <% } else { %>
                Prestataire
              <% } %>
            </span>

            <div class="flex items-center gap-3">
              <a
                href="/bookings/new?service=<%= s.slug %>"
                class="px-3 py-1.5 rounded-md bg-emerald-600/90 hover:bg-emerald-500 text-white transition"
              >
                Réserver
              </a>
              <a href="/services/<%= s.slug %>" class="text-blue-400 hover:underline">
                Voir
              </a>
              <% if (currentUser && (currentUser.role === "admin" || String(currentUser.id) === String(s.provider_id))) { %>
                <a href="/services/<%= s.slug %>/edit" class="text-slate-300 hover:text-white hover:underline">
                  Modifier
                </a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</section>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
