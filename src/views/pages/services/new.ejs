<section class="py-10">
  <div class="max-w-2xl mx-auto px-4">
    <div class="p-8 rounded-2xl bg-white/5 backdrop-blur shadow-xl border border-white/10">
      <div class="mb-6 text-center">
        <h1 class="text-2xl font-semibold tracking-tight">Proposer un service</h1>
        <p class="text-sm text-slate-400 mt-1">
          Publie un service depuis le même compte que celui utilisé pour réserver.
        </p>
      </div>

      <form action="/services" method="POST" enctype="multipart/form-data" class="space-y-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div>
          <label class="block text-sm mb-1 text-slate-300">Titre</label>
          <input
            type="text"
            name="title"
            required
            placeholder="Ex: Ménage 2h (appartement)"
            class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
          >
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm mb-1 text-slate-300">Prix (EUR)</label>
            <input
              type="number"
              name="price"
              step="0.01"
              min="0"
              required
              placeholder="Ex: 35"
              class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
            >
          </div>

          <div>
            <label class="block text-sm mb-1 text-slate-300">Catégorie</label>
            <select
              name="category_id"
              required
              class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
            >
              <option value="" disabled selected>Choisir une catégorie</option>
              <% (categories || []).forEach((category) => { %>
                <option value="<%= category.id %>"><%= category.name %></option>
              <% }) %>
              <option value="other">Autres services</option>

            </select>
            <p class="mt-2 text-xs text-slate-400">
              Si ton service n'apparaît pas dans la liste, choisis <strong>Autres services</strong>
              puis précise-le ci-dessous. Il sera ajoute automatiquement dans le catalogue et les filtres de catégories.
            </p>
            <div class="mt-3 rounded-xl border border-dashed border-slate-700/80 bg-slate-900/40 p-4">
              <label class="block text-sm mb-1 text-slate-300">Autres services</label>
              <input
                type="text"
                name="custom_category_name"
                placeholder="Ex: Montage de meubles, aide au demenagement..."
                class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
              >
            </div>
          </div>
        </div>

        <div>
          <label class="block text-sm mb-1 text-slate-300">Description</label>
          <textarea
            name="description"
            rows="6"
            required
            placeholder="Décris ce que tu proposes, la durée, le matériel et la zone d'intervention."
            class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
          ></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm mb-1 text-slate-300">Statut du prestataire</label>
            <select
              name="provider_status"
              required
              class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
            >
              <option value="" disabled <%= !defaultProviderStatus ? "selected" : "" %>>Choisir un statut</option>
              <% (providerStatusOptions || []).forEach((option) => { %>
                <option
                  value="<%= option.value %>"
                  <%= option.value === defaultProviderStatus ? "selected" : "" %>
                >
                  <%= option.label %>
                </option>
              <% }) %>
              
            </select>
            <p class="mt-2 text-xs text-slate-400">
              Ce statut sera visible sur ton service et ton profil public.
            </p>
          </div>

          <div>
            <label class="block text-sm mb-1 text-slate-300">Année d'expérience</label>
            <input
              type="number"
              name="experience_years"
              min="0"
              max="60"
              required
              placeholder="Ex: 5"
              class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
            >
          </div>

        </div>

        <div>
          <label class="block text-sm mb-1 text-slate-300">Zone d'intervention</label>
          <input
            type="text"
            name="service_area"
            required
            placeholder="Ex: Lyon et 20 km autour"
            class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
          >
        </div>

        <div>
          <label class="block text-sm mb-1 text-slate-300">Formations suivies</label>
          <textarea
            name="trainings"
            rows="3"
            placeholder="Ex: CAP, certifications, formations professionnelles..."
            class="w-full px-4 py-2 rounded-lg bg-slate-900/70 border border-slate-700 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition"
          ></textarea>
        </div>

        <div class="rounded-xl border border-dashed border-slate-700/80 bg-slate-900/40 p-4">
          <label class="block text-sm mb-1 text-slate-300">Photos de réalisations</label>
          <p class="text-xs text-slate-400">
            Optionnel. Ajoute jusqu'à 6 photos de services déjà réalisés pour rassurer les futurs clients.
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button
              type="button"
              data-file-trigger="service_photos"
              class="inline-flex min-h-10 items-center justify-center rounded-lg border border-slate-600 bg-slate-800 px-4 py-2 text-sm font-medium text-slate-100 transition hover:border-slate-500 hover:bg-slate-700"
            >
              Ajouter des photos
            </button>
            <span class="text-xs text-slate-400" data-file-status="service_photos" aria-live="polite"></span>
          </div>
          <input
            id="service_photos"
            name="service_photos"
            type="file"
            accept="image/png,image/jpeg,image/webp,image/gif"
            multiple
            class="hidden">
        </div>

        <label class="inline-flex items-center gap-3 text-sm text-slate-300">
          <input type="checkbox" name="has_driving_license">
          <span>Permis de conduire</span>
        </label>

        <div class="flex items-center justify-between pt-2">
          <a href="/services" class="text-sm text-slate-400 hover:text-white transition">
            <- Retour
          </a>

          <div class="flex gap-3">
            <button
              type="reset"
              class="px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 transition">
              Réinitialiser
            </button>

            <button
              type="submit"
              class="px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 active:bg-blue-700 transition font-medium shadow-lg shadow-blue-600/20">
              Publier
            </button>

          </div>
        </div>
      </form>
    </div>
  </div>
</section>
