<section class="py-10">
  <div class="max-w-4xl mx-auto px-4">
    <div class="mb-6">
      <a href="/services" class="text-sm text-slate-400 hover:text-white transition">
        <- Retour aux services
      </a>
    </div>

    <article class="p-8 rounded-2xl bg-white/5 border border-white/10 shadow-xl">
      <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div>
          <p class="text-xs uppercase tracking-wider text-blue-300">
            <%= service.category_name || "Service" %>
          </p>
          <h1 class="mt-2 text-3xl font-semibold"><%= service.title %></h1>
          <p class="mt-2 text-sm text-slate-400">
            <% if (service.provider_name) { %>
              Par <span class="text-slate-200"><%= service.provider_name %></span>
            <% } %>
          </p>
        </div>

        <div class="text-right">
          <p class="text-2xl font-semibold text-emerald-300">
            <%= (service.price ?? 0).toString().replace(".", ",") %> EUR
          </p>
          <a
            href="/services/<%= service.slug %>/edit"
            class="inline-block mt-4 px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 transition font-medium"
          >
            Modifier
          </a>
        </div>
      </div>

      <div class="mt-8">
        <h2 class="text-lg font-semibold">Description</h2>
        <p class="mt-3 text-slate-300 whitespace-pre-line"><%= service.description %></p>
      </div>
    </article>
  </div>
</section>
