# Copy this file to .env, then replace the placeholder values locally.
# Never commit the real .env file or real passwords, tokens, or API keys.

APP_FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace_with_a_long_random_session_secret
CSRF_SECRET=replace_with_a_long_random_csrf_secret
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_NAME=home_service
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_APP_USER=your_app_database_username
DB_APP_PASSWORD=your_app_database_password
DATABASE_URL=postgresql://your_database_username:your_database_password@localhost:5432/home_service

# Optional Google OAuth login. Keep the real values only in your local .env.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
